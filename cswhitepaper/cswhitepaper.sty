	problem/Problem,protocol/Protocol,result/Result,solution/Solution,step/Step,
	commentary/Commentary,discussion/Discussion,exercise/Exercise,motivation/Motivation,
	notationabuse/Notation Abuse,note/Note,openproblem/Open Problem,question/Question,
	remark/Remark,syntax/Syntax,guideline/Guideline,highlight/Highlight,
	important/Important,insight/Insight,keypoint/Key Point,recall/Recall,
	summary/Summary,takeaway/Takeaway,tip/Tip,warning/Warning
}
