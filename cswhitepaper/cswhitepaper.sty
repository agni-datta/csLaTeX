\NewDocumentCommand{\commonheadfont} {}{\color{docucolor}\sffamily}
\NewDocumentCommand{\commonstartsymb}{}{\ensuremath{\color{docucolor}\diamond}~}
\NewDocumentCommand{\commonsymb}     {}{\ensuremath{\color{docucolor}\lrcorner}}

\ProvideDocumentCommand{\SetQEDSymbol}{m}{\setqedsymbol{#1}}
\ProvideDocumentCommand{\SetTheoremEndSymbol}{m}{\settheoremendsymbol{#1}}
\ProvideDocumentCommand{\setqedsymbol}{m}{\global\qedsymbol{#1}}
\ProvideDocumentCommand{\settheoremendsymbol}{m}{ \RenewDocumentCommand{\commonsymb}{}{#1} }

\mdfdefinestyle{csw@ruled}{%
	linewidth         = 1pt,%
	linecolor         = docucolor,%
	topline           = true,%
	bottomline        = true,%
	leftline          = false,%
	rightline         = false,%
	innertopmargin    = 6pt,%
	innerbottommargin = 6pt,%
	innerleftmargin   = 1pt,%
	innerrightmargin  = 1pt,%
	skipabove         = 6pt,%
	skipbelow         = 6pt%
}

\newtheoremstyle{cswplain}
{\item[\hskip\labelsep\theorem@headerfont ##1\ ##2\unskip\theorem@separator]}
{\item[\hskip\labelsep\theorem@headerfont ##1\ ##2\ {\normalfont(##3)}\unskip\theorem@separator]}
\newtheoremstyle{nonumbercswplain}
{\item[\hskip\labelsep\theorem@headerfont ##1\unskip\theorem@separator]}
{\item[\hskip\labelsep\theorem@headerfont ##1\ {\normalfont(##3)}\unskip\theorem@separator]}

\def\csw@configuretheorem{%
	\theoremstyle{cswplain}%
	\theoremheaderfont{\commonheadfont\commonstartsymb}%
	\theorembodyfont{\normalfont}%
	\theoremseparator{.}%
	\theorempreskip{0pt}%
	\theorempostskip{0pt}%
	\theoremsymbol{\commonsymb}%
}
\def\csw@surroundtheorem#1{\surroundwithmdframed[style=csw@ruled]{#1}}
\def\csw@newtheorem#1{\expandafter\csw@newtheorem@parse#1\csw@nil}
\def\csw@newtheorem@parse#1/#2\csw@nil{%
	\newtheorem{#1}[theorem]{#2}%
	\csw@surroundtheorem{#1}%
}
\def\csw@newtheoremfamily#1{\forcsvlist{\csw@newtheorem}{#1}}
\def\csw@renewtheoremstar#1{\expandafter\csw@renewtheoremstar@parse#1\csw@nil}
\def\csw@renewtheoremstar@parse#1/#2\csw@nil{%
	\renewtheorem*{#1}{#2}%
	\csw@surroundtheorem{#1}%
}

\csw@configuretheorem
\newtheorem{theorem}{Theorem}[section]
\csw@surroundtheorem{theorem}
\csw@newtheoremfamily{
