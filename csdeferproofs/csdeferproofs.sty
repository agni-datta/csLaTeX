\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{csdeferproofs}[2026/08/25 v2.0 Deferred-proof infrastructure for csLaTeX packages]

\RequirePackage{l3keys2e}
\makeatletter
\ExplSyntaxOn

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Options
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_new:N \g_csdp_appendix_bool
\tl_new:N   \g_csdp_commandref_tl
\tl_new:N   \g_csdp_category_tl
\tl_new:N   \g_csdp_proofname_tl
\tl_new:N   \g_csdp_sketchname_tl
\seq_new:N  \g_csdp_deferred_proofs_seq
\int_new:N  \g_csdp_deferred_theorem_int
\tl_new:N   \g_csdp_pending_label_tl

\tl_gset:Nn \g_csdp_commandref_tl { cref }
\tl_gset:Nn \g_csdp_category_tl { defaultcategory }
\tl_gset:Nn \g_csdp_proofname_tl { Proof }
\tl_gset:Nn \g_csdp_sketchname_tl { Proof~Sketch }

\keys_define:nn { csdeferproofs }
{
	appendix    .bool_gset:N = \g_csdp_appendix_bool ,
	appendix    .initial:n   = true ,
	commandref  .tl_gset:N   = \g_csdp_commandref_tl ,
	commandref  .initial:n   = cref ,
	category    .tl_gset:N   = \g_csdp_category_tl ,
	category    .initial:n   = defaultcategory ,
	proofname   .tl_gset:N   = \g_csdp_proofname_tl ,
	proofname   .initial:n   = Proof ,
	sketchname  .tl_gset:N   = \g_csdp_sketchname_tl ,
	sketchname  .initial:n   = {Proof~Sketch} ,
	unknown     .code:n      = { \PackageWarning{csdeferproofs}{Unknown~option~`#1'~ignored} } ,
}
\ProcessKeysOptions { csdeferproofs }
\tl_if_blank:VT \g_csdp_commandref_tl
{
	\tl_gset:Nn \g_csdp_commandref_tl { cref }
}
\tl_if_blank:VT \g_csdp_category_tl
{
	\tl_gset:Nn \g_csdp_category_tl { defaultcategory }
}
\tl_if_blank:VT \g_csdp_proofname_tl
{
	\tl_gset:Nn \g_csdp_proofname_tl { Proof }
}
\tl_if_blank:VT \g_csdp_sketchname_tl
{
	\tl_gset:Nn \g_csdp_sketchname_tl { Proof~Sketch }
}

\tl_set_eq:cN { csdp@commandref } \g_csdp_commandref_tl
\tl_set_eq:cN { csdp@category   } \g_csdp_category_tl
\tl_set_eq:cN { csdp@proofname  } \g_csdp_proofname_tl
\tl_set_eq:cN { csdp@sketchname } \g_csdp_sketchname_tl

\cs_new_protected:Npn \csdp_store_deferred_proof:nnn #1#2#3
{
	\seq_gput_right:Nn \g_csdp_deferred_proofs_seq
	{ \csdp_print_deferred_proof:nnnn {#1}{#2}{#3} }
}
\cs_generate_variant:Nn \csdp_store_deferred_proof:nnn { Vnn }
\cs_new_protected:Npn \csdp_mark_deferred_theorem:
{
	\int_gincr:N \g_csdp_deferred_theorem_int
	\tl_gset:Nx \g_csdp_pending_label_tl
	{ csdp:deferred:\int_use:N \g_csdp_deferred_theorem_int }
	\exp_args:NV \label \g_csdp_pending_label_tl
}
\cs_new_protected:Npn \csdp_store_pending_deferred_proof:nn #1#2
{
	\tl_if_blank:VTF \g_csdp_pending_label_tl
	{
		\tl_if_blank:nTF {#1}
		{ \csdp_store_deferred_proof:nnn { } { \csdp@proofname } {#2} }
		{ \csdp_store_deferred_proof:nnn { } {#1} {#2} }
	}
	{ \csdp_store_deferred_proof:Vnn \g_csdp_pending_label_tl {#1} {#2} }
	\tl_gclear:N \g_csdp_pending_label_tl
}
\cs_new_protected:Npn \csdp_store_deferred_sketch:nn #1#2
{
	\tl_if_blank:nTF {#1}
	{ \csdp_store_deferred_proof:nnn { } { \csdp@sketchname } {#2} }
	{
		\csdp_store_deferred_proof:nnn {#1}
		{ \csdp@sketchname\space of~\csname\csdp@commandref\endcsname{#1} }
		{#2}
	}
}
\cs_generate_variant:Nn \csdp_store_deferred_sketch:nn { Vn }
\cs_new_protected:Npn \csdp_store_pending_deferred_sketch:n #1
{
	\csdp_store_deferred_sketch:Vn \g_csdp_pending_label_tl {#1}
	\tl_gclear:N \g_csdp_pending_label_tl
}
\cs_new_protected:Npn \csdp_clear_pending_deferred_theorem:
{
	\tl_gclear:N \g_csdp_pending_label_tl
}
\cs_new_protected:Npn \csdp_print_deferred_proof:nnnn #1#2#3#4
{
	\tl_if_blank:nTF {#2}
	{
		\tl_if_blank:nTF {#1}
		{ \parhead{\normalfont\itshape #4} }
		{ \parhead{\normalfont\itshape #4~\exp_args:Nv \use:c { csdp@commandref } {#1}} }
	}
	{ \parhead{\normalfont\itshape #2} }
	#3\unskip\nobreak\hfill\csdp_end_symbol:\par
}
\cs_new:Npn \csdp_end_symbol:
{
	\cs_if_exist:NTF \proofSymbol { \proofSymbol } { \qedsymbol }
}
\cs_new_protected:Npn \csdp_print_deferred_proofs:n #1
{
	\seq_map_inline:Nn \g_csdp_deferred_proofs_seq { ##1 {#1} }
}
\cs_new_eq:NN \csdpstoredeferredproof \csdp_store_deferred_proof:nnn
\cs_new_eq:NN \csdpprintdeferredproofs \csdp_print_deferred_proofs:n
\cs_new_eq:NN \csdpmarkdeferredtheorem \csdp_mark_deferred_theorem:
\cs_new_eq:NN \csdpstorependingdeferredproof \csdp_store_pending_deferred_proof:nn
\cs_new_eq:NN \csdpstorependingdeferredsketch \csdp_store_pending_deferred_sketch:n
\cs_new_eq:NN \csdpclearpendingdeferredtheorem \csdp_clear_pending_deferred_theorem:

\newif\ifcsdp@appendix
\bool_if:NTF \g_csdp_appendix_bool { \csdp@appendixtrue } { \csdp@appendixfalse }

\ExplSyntaxOff

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Internal Helpers
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NewDocumentCommand{\csdp@ifblank}{m m m}{%
	\if\relax\detokenize{#1}\relax
		#2%
	\else
		#3%
	\fi
}

\NewDocumentCommand{\csdp@beginenv}{m m}{%
	\csdp@ifblank{#2}{%
		\begin{#1}%
	}{%
		\begin{#1}[#2]%
	}%
}

\NewDocumentCommand{\csdp@beginproof}{m}{%
	\csdp@beginenv{proof}{#1}%
}

\NewDocumentCommand{\csdp@beginproofsketch}{m}{%
	\csdp@ifblank{#1}{%
		\begin{proof}[\csdp@sketchname]%
	}{%
		\begin{proof}[#1]%
	}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Appendix Mode
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\ifcsdp@appendix

	\NewDocumentCommand{\NewDeferredThm}{O{} m m}{%
		\NewDocumentEnvironment{#2}{O{} +b}{%
			\csdp@beginenv{#3}{##1}%
			\csdpmarkdeferredtheorem
			##2%
			\end{#3}%
		}{}%
	}

	\NewDocumentEnvironment{proofE}{O{} +b}{%
		\csdpstorependingdeferredproof{#1}{#2}%
	}{}

	\NewDocumentEnvironment{proofEsketch}{O{} +b}{%
		\csdp@ifblank{#1}
		{\csdpstorependingdeferredsketch{#2}}
		{\csdpstorependingdeferredproof{#1}{#2}}%
	}{}

	\NewDocumentEnvironment{deferproof}{m O{} +b}{%
		\csdpstoredeferredproof{#1}{#2}{#3}%
		\csdpclearpendingdeferredtheorem
	}{}

	\NewDocumentEnvironment{deferproofsketch}{m O{} +b}{%
		\csdp@ifblank{#2}
		{\csdpstoredeferredproof{#1}{\csdp@sketchname\space of~\csname\csdp@commandref\endcsname{#1}}{#3}}
		{\csdpstoredeferredproof{#1}{#2}{#3}}%
		\csdpclearpendingdeferredtheorem
	}{}

	\NewDocumentCommand{\printDeferredProofs}{O{\csdp@proofname\space of}}{%
		\csdpprintdeferredproofs{#1}%
	}

\else

	\NewDocumentCommand{\NewDeferredThm}{O{} m m}{}

	\NewDocumentEnvironment{proofE}{O{}}{%
		\csdp@beginproof{#1}%
	}{%
		\end{proof}%
	}

	\NewDocumentEnvironment{proofEsketch}{O{}}{%
		\csdp@beginproofsketch{#1}%
	}{%
		\end{proof}%
	}

	\NewDocumentEnvironment{deferproof}{m O{}}{%
		\csdp@beginproof{#2}%
	}{%
		\end{proof}%
	}

	\NewDocumentEnvironment{deferproofsketch}{m O{}}{%
		\csdp@beginproofsketch{#2}%
	}{%
		\end{proof}%
	}

	\NewDocumentCommand{\printDeferredProofs}{O{}}{}

\fi

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Public Compatibility Interfaces
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NewDocumentCommand{\NewDeferredThmAlias}{m m}{%
	\ifcsdp@appendix
	\else
		\NewDocumentEnvironment{#1}{O{}}{%
			\csdp@beginenv{#2}{##1}%
		}{%
			\end{#2}%
		}%
	\fi
}

\NewDocumentCommand{\IfDeferredProofsActive}{m m}{%
	\ifcsdp@appendix
		#1%
	\else
		#2%
	\fi
}

\makeatother
\endinput
