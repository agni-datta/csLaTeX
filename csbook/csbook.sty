}
\def\csbk@declare@stixbb{%
	\DeclareFontFamily{U}{stixonebb}{\skewchar\font=45 }%
	\DeclareFontShape{U}{stixonebb}{m}{n}{<->stix-mathbb}{}%
	\DeclareFontShape{U}{stixonebb}{m}{it}{<->stix-mathbbit}{}%
	\DeclareFontShape{U}{stixonebb}{b}{n}{<->stix-mathbb-bold}{}%
	\DeclareFontShape{U}{stixonebb}{b}{it}{<->stix-mathbbit-bold}{}%
	\DeclareFontSubstitution{U}{stixonebb}{m}{n}%
	\DeclareMathAlphabet{\mathbb}{U}{stixonebb}{m}{n}%
	\SetMathAlphabet{\mathbb}{bold}{U}{stixonebb}{b}{n}%
	\DeclareMathAlphabet{\mathbfbb}{U}{stixonebb}{b}{n}%
	\DeclareMathAlphabet{\mathbbi}{U}{stixonebb}{m}{it}%
	\SetMathAlphabet{\mathbbi}{bold}{U}{stixonebb}{b}{it}%
