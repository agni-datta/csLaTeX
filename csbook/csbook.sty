%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Options
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tl_new:N   \g_csbk_font_tl
\bool_new:N \g_csbk_draft_bool
\bool_new:N \g_csbk_lastpage_bool
\bool_new:N \g_csbk_noindex_bool

\tl_gset:Nn \g_csbk_font_tl { latinmodern }

\keys_define:nn { csbook }
{
	font         .code:n      = { \keys_set:nn { csbook } { #1 } } ,
	baskervaldx  .code:n      = { \tl_gset:Nn \g_csbk_font_tl { baskervaldx } } ,
	concrete     .code:n      = { \tl_gset:Nn \g_csbk_font_tl { concrete    } } ,
	garamond     .code:n      = { \tl_gset:Nn \g_csbk_font_tl { garamond    } } ,
	gfsdidot     .code:n      = { \tl_gset:Nn \g_csbk_font_tl { gfsdidot    } } ,
	kpfonts      .code:n      = { \tl_gset:Nn \g_csbk_font_tl { kpfonts     } } ,
	latinmodern  .code:n      = { \tl_gset:Nn \g_csbk_font_tl { latinmodern } } ,
	libertine    .code:n      = { \tl_gset:Nn \g_csbk_font_tl { libertine   } } ,
	palatino     .code:n      = { \tl_gset:Nn \g_csbk_font_tl { palatino    } } ,
	draft        .bool_gset:N = \g_csbk_draft_bool ,
	draft        .initial:n   = false ,
	final        .code:n      = { \bool_gset_false:N \g_csbk_draft_bool } ,
	lastpage     .bool_gset:N = \g_csbk_lastpage_bool ,
	lastpage     .initial:n   = false ,
	noindex      .bool_gset:N = \g_csbk_noindex_bool ,
	noindex      .initial:n   = false ,
	unknown      .code:n      = { \PackageWarning{csbook}{Unknown~option~`#1'~ignored} } ,
}
\ProcessKeysOptions { csbook }
\tl_if_blank:VT \g_csbk_font_tl
{
	\tl_gset:Nn \g_csbk_font_tl { latinmodern }
}
\tl_if_exist:NT \g_csam_font_tl
{
	\tl_if_eq:NNF \g_csbk_font_tl \g_csam_font_tl
	{
		\PackageError{csbook}{Font~option~must~match~csamsmath}{Load~csbook~and~csamsmath~with~the~same~font~option.}
	}
}

\newif\ifcsbk@baskervaldx  \tl_if_eq:NnT \g_csbk_font_tl { baskervaldx } { \csbk@baskervaldxtrue }
\newif\ifcsbk@concrete     \tl_if_eq:NnT \g_csbk_font_tl { concrete    } { \csbk@concretetrue    }
\newif\ifcsbk@garamond     \tl_if_eq:NnT \g_csbk_font_tl { garamond    } { \csbk@garamondtrue    }
\newif\ifcsbk@gfsdidot     \tl_if_eq:NnT \g_csbk_font_tl { gfsdidot    } { \csbk@gfsdidottrue    }
\newif\ifcsbk@kpfonts      \tl_if_eq:NnT \g_csbk_font_tl { kpfonts     } { \csbk@kpfontstrue     }
\newif\ifcsbk@latinmodern  \tl_if_eq:NnT \g_csbk_font_tl { latinmodern } { \csbk@latinmoderntrue }
\newif\ifcsbk@libertine    \tl_if_eq:NnT \g_csbk_font_tl { libertine   } { \csbk@libertinetrue   }
\newif\ifcsbk@palatino     \tl_if_eq:NnT \g_csbk_font_tl { palatino    } { \csbk@palatinotrue    }
\newif\ifcsbk@draft        \bool_if:NTF \g_csbk_draft_bool    { \csbk@drafttrue    } { \csbk@draftfalse    }
\newif\ifcsbk@lastpage     \bool_if:NTF \g_csbk_lastpage_bool { \csbk@lastpagetrue } { \csbk@lastpagefalse }
\newif\ifcsbk@noindex      \bool_if:NTF \g_csbk_noindex_bool  { \csbk@noindextrue  } { \csbk@noindexfalse  }

\ExplSyntaxOff

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Diagnostics and compatibility
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tracinglostchars=0
\def\@font@warning#1{}

\RequirePackage{iftex}
\RequirePackage{etoolbox}
\RequirePackage{xpatch}

\ifPDFTeX
	\ifcsbk@concrete
		\PackageWarning{csbook}{Font option `concrete' requires LuaLaTeX. Falling back to Latin Modern}
		\csbk@concretefalse
		\csbk@latinmoderntrue
	\fi
	\ifcsbk@garamond
		\PackageWarning{csbook}{Font option `garamond' requires LuaLaTeX. Falling back to Latin Modern}
		\csbk@garamondfalse
		\csbk@latinmoderntrue
	\fi
	\ifcsbk@gfsdidot
		\PackageWarning{csbook}{Font option `gfsdidot' requires LuaLaTeX. Falling back to Latin Modern}
		\csbk@gfsdidotfalse
		\csbk@latinmoderntrue
	\fi
	\ifcsbk@kpfonts
		\PackageWarning{csbook}{Font option `kpfonts' requires LuaLaTeX. Falling back to Latin Modern}
		\csbk@kpfontsfalse
		\csbk@latinmoderntrue
	\fi
\fi

