\cs_new_protected:Npn \csLlncsDeclareFamily #1#2#3
{
    \cs_if_exist:cF {#1}
    {
        \spnewtheorem {#1}[theorem] {#2} {\bfseries} {\itshape}
    }
    \cs_if_exist:cF {#1*}
    {
        \spnewtheorem * {#1*} {#2} {\bfseries} {\itshape}
    }
}

\cs_new_protected:Npn \csLlncsDeclareUnnumbered #1#2
{
    \cs_if_exist:cF {#1}
    {
        \spnewtheorem * {#1} {#2} {\bfseries} {\itshape}
    }
}

\cs_new_protected:Npn \csLlncsDeclareProof #1#2
{
    \cs_if_exist:cF {#1}
    {
        \spnewtheorem * {#1} {#2} {\itshape} {\rmfamily}
    }
}
\csLlncsIf:nnT {theorems} {extended}
{
    \clist_map_inline:Nn \c_csLlncsFamilies_clist
    {
        \csLlncsDeclareFamily #1
    }
    \clist_map_inline:nn
    {
        {uclaim} {Claim},
        {uconjecture} {Conjecture},
        {ucorollary} {Corollary},
        {uhypothesis} {Hypothesis},
        {uinformaltheorem} {Informal~Theorem},
        {ulemma} {Lemma},
        {uopenproblem} {Open~Problem},
        {usyntax} {Syntax},
        {utheorem} {Theorem}
    }
    {
        \csLlncsDeclareUnnumbered #1
    }
}

