\cs_new_protected:Npn \csLlncsRegisterSectionReset #1#2#3
{
    \cs_if_exist:cT {c@#1}
    {
        \counterwithin * {#1} {section}
    }
}
\@ifclasswith {llncs} {envcountreset}
{
    \clist_map_inline:Nn \c_csLlncsFamilies_clist
    {
        \csLlncsRegisterSectionReset #1
    }
} {}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Proof Helpers
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\clist_map_inline:nn
{
    {proofsketch} {Proof~Sketch},
    {proofidea} {Proof~Idea},
    {proofofclaim} {Proof~of~Claim}
}
{
    \csLlncsDeclareProof #1
}
\cs_if_exist:NF \claimproof
{
    \NewDocumentEnvironment {claimproof}
    {
        O {Proof~of~Claim}
    }
    {
        \renewcommand \proofname {#1}
        \begin {proof}
    }
    {
        \end {proof}
    }
}
\ProvideDocumentCommand \qedsymbol {} {\squareforqed}
\ProvideDocumentCommand \setqedsymbol {m}
{
    \cs_set:Npn \squareforqed {#1}
}
\ProvideDocumentCommand \SetQEDSymbol {m}
{
    \setqedsymbol {#1}
}

\cs_new_eq:NN \csLlncsOriginalQed \qed
\bool_new:N \l_csLlncsQedPlaced_bool
\ProvideDocumentCommand \qedhere {} {\qed}
\csLlncsIf:nnT {proof-headings} {complete}
{
    \NewCommandCopy \csLlncsNativeProof \proof
    \RenewDocumentCommand \proof {o}
    {
        \IfNoValueF {#1}
        {
            \renewcommand \proofname {#1}
        }
        \csLlncsNativeProof \relax
    }
}
\csLlncsIf:nnT {proof-qed} {true}
{
    \clist_map_inline:nn
    {
        proof,
        proofsketch,
        proofidea,
        proofofclaim
    }
    {
        \AddToHook {env/#1/begin} [llncscrypto]
        {
            \bool_set_false:N \l_csLlncsQedPlaced_bool
            \cs_set_protected:Npn \qed
            {
                \bool_set_true:N \l_csLlncsQedPlaced_bool \csLlncsOriginalQed
            }
        }
        \AddToHook {env/#1/end} [llncscrypto]
        {
            \bool_if:NF \l_csLlncsQedPlaced_bool {\qed}
        }
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Paragraph Headings
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \csLlncsPunctuate #1
{
    \tl_set:Nx \l_tmpa_tl
    {
        \text_purify:n {#1}
    }
    \tl_trim_spaces:N \l_tmpa_tl
    #1\exp_args:NnV \regex_match:nnTF
    {
        [.!?:] \Z
    } \l_tmpa_tl {} {.}
}
\ProvideDocumentCommand \parheadnoperiod {m}
{
    \par
    \smallskip \noindent
    {
        \bfseries \boldmath #1
    }
    \hskip .30em\ignorespaces
}
\ProvideDocumentCommand \subparheadnoperiod {m}
{
    \par
    \smallskip \noindent
    {
        \scshape #1
    }
    \hskip .30em\ignorespaces
}
\ProvideDocumentCommand \parhead {m}
{
    \parheadnoperiod
    {
        \csLlncsPunctuate {#1}
    }
}
\ProvideDocumentCommand \subparhead {m}
{
    \subparheadnoperiod
    {
        \csLlncsPunctuate {#1}
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Reference Providers
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\prop_new:N \g_csLlncsReferenceNames_prop
\cs_new_protected:Npn \csLlncsCleverName #1#2#3
{
    \cs_if_exist:cF {cref@#1@name}
    {
        \use:e
        {
            \exp_not:N \crefname {#1}
            {
                \str_lowercase:n {#2}
            }
            {
                \str_lowercase:n {#3}
            }
        }
    }
    \cs_if_exist:cF {Cref@#1@name}
    {
        \Crefname {#1} {#2} {#3}
    }
    \csLlncsIf:nnT {reference-names} {legacy}
    {
        \crefname {#1} {#2} {#3}
        \Crefname {#1} {#2} {#3}
    }
}

