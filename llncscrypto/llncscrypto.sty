\cs_new_protected:Npn \csLlncsParseReferenceName #1
{
    \seq_set_split:Nnn \l_tmpa_seq {/} {#1}
    \int_compare:nNnTF
    {
        \seq_count:N \l_tmpa_seq
    } = {3}
    {
        \exp_args:Neee \llncsrefname
        {
            \seq_item:Nn \l_tmpa_seq {1}
        }
        {
            \seq_item:Nn \l_tmpa_seq {2}
        }
        {
            \seq_item:Nn \l_tmpa_seq {3}
        }
    }
    {
        \PackageError {llncscrypto} {Invalid~reference-name~entry}
        {Use~type/singular/plural.~Group~names~containing~a~slash.}
