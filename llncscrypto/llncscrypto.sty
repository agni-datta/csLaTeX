\box_new:N \l_csLlncsTarget_box
\int_new:N \g_csLlncsTarget_int
\cs_new_protected:Npn \csLlncsStepWithTarget #1
{
    \cs_set_eq:NN \refstepcounter \csLlncsNativeStep
    \LinkTargetOff \refstepcounter {#1}
    \LinkTargetOn
    \int_gincr:N \g_csLlncsTarget_int
    \hbox_set:Nn \l_csLlncsTarget_box
    {
        \MakeLinkTarget *
        {
            #1.llncs.\int_use:N \g_csLlncsTarget_int
        }
    }
    \AddToHookNext {cmd/item/before}
    {
        \AddToHookNext {para/begin}
        {
            \box_use_drop:N \l_csLlncsTarget_box
        }
    }
}

\cs_new_protected:Npn \csLlncsInitializeTargets
{
    \cs_if_exist:cTF {@spthm}
    {
        \cs_if_exist:NTF \MakeLinkTarget
        {
            \AddToHook {cmd/@spthm/before} [llncscrypto]
            {
                \cs_set_eq:NN \csLlncsNativeStep \refstepcounter
                \cs_set_protected:Npn \refstepcounter ##1
                {
                    \csLlncsStepWithTarget {##1}
                }
            }
        }
        {
            \PackageError {llncscrypto} {hyperref~public~target~API~unavailable}
            {Update~hyperref~to~a~version~providing~MakeLinkTarget~and~LinkTargetOff.}
        }
    }
    {
        \PackageError {llncscrypto} {Unsupported~LNCS~theorem~entry~point}
        {The~tested~classes~provide~the~spnewtheorem~entry~point.~Use~a~supported~class.}
    }
}
\@ifpackageloaded {hyperref} {\csLlncsInitializeTargets}
{
    \AddToHook {package/hyperref/after} [llncscrypto] {\csLlncsInitializeTargets}
}

