%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Options
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\prop_new:N \l_csLlncsChoices_prop
\cs_new_protected:Npn \csLlncsSelect #1#2
{
    \prop_get:NnNTF \l_csLlncsChoices_prop {#1} \l_tmpa_tl
    {
        \tl_if_eq:NnF \l_tmpa_tl {#2}
        {
            \PackageError {llncscrypto} {Contradictory~#1~selections}
            {
                Choose~one~value.~Earlier:~\l_tmpa_tl ;~later:~#2.
            }
        }
    }
    {
        \prop_put:Nnn \l_csLlncsChoices_prop {#1} {#2}
    }
}

\cs_new_protected:Npn \csLlncsDefault #1#2
{
    \prop_if_in:NnF \l_csLlncsChoices_prop {#1}
    {
        \prop_put:Nnn \l_csLlncsChoices_prop {#1} {#2}
    }
}
\keys_define:nn {llncscrypto}
{
    format .choices:nn =
        {
            camera-ready,
            preprint
        }
        {
            \csLlncsSelect {format} {#1}
        },
    preprint .code:n =
        {
            \csLlncsSelect {format} {preprint}
        },
    preprint .value_forbidden:n = true,
    draft .code:n =
        {
            \csLlncsSelect {status} {draft}
        },
    draft .value_forbidden:n = true,
    final .code:n =
        {
            \csLlncsSelect {status} {final}
        },
    final .value_forbidden:n = true,
    nonotes .code:n =
        {
            \csLlncsSelect {annotations} {false}
        },
    nonotes .value_forbidden:n = true,
    theorems .choices:nn =
        {
            inherit,
            extended
        }
        {
            \csLlncsSelect {theorems} {#1}
        },
    theorems .default:n = extended,
    references .choices:nn =
        {
            none,
            hyperref,
            cleveref,
            zref,
            both
        }
        {
            \csLlncsSelect {references} {#1}
        },
    references .default:n = cleveref,
    proof-headings .choices:nn =
        {
            native,
            complete
        }
        {
            \csLlncsSelect {proof-headings} {#1}
        },
    reference-names .choices:nn =
        {
            inherit,
            legacy
        }
        {
            \csLlncsSelect {reference-names} {#1}
        },
    preprint-margin .code:n =
        {
            \csLlncsSelect {preprint-margin} {#1}
        },
    preprint-spacing .code:n =
        {
            \csLlncsSelect {preprint-spacing} {#1}
        },
    unknown .code:n =
        {
            \PackageError {llncscrypto}
            {
                Unknown~option~'\l_keys_key_str '
            } {See~the~llncscrypto~option~table.}
        }
}
\clist_map_inline:nn
{
    annotations,
    lists,
    boxes,
    captions,
    subfigures,
    colorlinks,
    libertine,
    microtype,
    proof-qed,
    draft-footer
}
{
    \keys_define:nn {llncscrypto}
    {
        #1 .choices:nn =
            {
                true,
                false
            }
            {
                \csLlncsSelect {#1} {##1}
            },
        #1 .default:n = true
    }
}
\ProcessKeyOptions [llncscrypto]
\csLlncsDefault {format} {camera-ready}
\csLlncsDefault {status} {final}
\csLlncsDefault {theorems} {inherit}
\csLlncsDefault {references} {none}
\csLlncsDefault {proof-headings} {native}
\csLlncsDefault {reference-names} {inherit}
\csLlncsDefault {preprint-margin} {1in}
\csLlncsDefault {preprint-spacing} {1}
\prop_get:NnN \l_csLlncsChoices_prop {format} \l_csLlncsFormat_tl
\prop_get:NnN \l_csLlncsChoices_prop {status} \l_csLlncsStatus_tl
\tl_if_eq:NnT \l_csLlncsStatus_tl {draft}
{
    \csLlncsDefault {annotations} {true}
}
\clist_map_inline:nn
{
    annotations,
    lists,
    boxes,
    captions,
    subfigures,
    colorlinks,
    libertine,
    microtype,
    proof-qed,
    draft-footer
}
{
    \csLlncsDefault {#1} {false}
}
\prg_new_conditional:Npnn \csLlncsIf:nn #1#2
{
    T,
    F,
    TF
}
{
    \prop_get:NnN \l_csLlncsChoices_prop {#1} \l_tmpa_tl
    \tl_if_eq:NnTF \l_tmpa_tl {#2} {\prg_return_true:} {\prg_return_false:}
}

\cs_new_protected:Npn \csLlncsFeatureError #1
{
    \PackageError {llncscrypto} {Feature~'#1'~is~disabled}
    {Select~#1~when~loading~llncscrypto.~No~package~is~loaded~during~typesetting.}
}

\cs_new_protected:Npn \csLlncsPreprintOnly #1
{
    \csLlncsIf:nnT {format} {camera-ready}
    {
        \PackageError {llncscrypto} {#1~requires~format=preprint}
        {This~feature~changes~publisher-owned~formatting.~Remove~it~or~select~preprint.}
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Class Compatibility
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\@ifclassloaded {llncs} {}
{
    \PackageError {llncscrypto} {The~llncs~document~class~is~required}
    {For~article~or~book~use~csmath~directly.}
}
\cs_if_exist:NF \spnewtheorem
{
    \PackageError {llncscrypto} {LNCS~theorem~interface~unavailable}
    {Use~the~official~LNCS~class~with~spnewtheorem.}
}
\IfClassAtLeastTF {llncs} {2026/09/03} {}
{
    \PackageWarning {llncscrypto}
    {
        Class~predates~the~September~2026~template;
        ~publisher~formatting~is~inherited,~not~upgraded
    }
}
\clist_map_inline:nn
{
    csthm,
    ntheorem,
    amsthm,
    thmtools,
    csamsmath,
    csbook
}
{
    \@ifpackageloaded {#1}
    {
        \PackageError {llncscrypto} {Competing~theorem~provider~#1}
        {LNCS~owns~theorems.~Use~csmath~with~theorems=inherit.}
    }
    {
        \AddToHook {package/#1/before} [llncscrypto]
        {
            \PackageError {llncscrypto} {Competing~theorem~provider~#1}
            {LNCS~owns~theorems.~Use~csmath~with~theorems=inherit.}
        }
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Keywords
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \csLlncsPendingKeywords #1
{
    \PackageError {llncscrypto} {Keywords~are~available~after~begin-document}
    {Place~keywords~inside~the~abstract~as~in~the~official~sample.}
}
\@ifpackageloaded {tcscrypto}
{
    \PackageError {llncscrypto} {Load~llncscrypto~before~tcscrypto}
    {LNCS~must~retain~ownership~of~its~delayed~keywords~definition.}
} {}
\cs_if_exist:NF \keywords
{
    \cs_set_eq:NN \keywords \csLlncsPendingKeywords
    \AddToHook {begindocument/before} [llncscrypto/keywords]
    {
        \cs_if_eq:NNT \keywords \csLlncsPendingKeywords
        {
            \cs_undefine:N \keywords
        }
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Foundation Compatibility
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \csLlncsValidateMath
{
    \cs_if_exist:NTF \g_csMathChoices_prop
    {
        \clist_map_inline:nn
        {
            mode/venue,
            theorems/inherit,
            paragraphs/inherit
        }
        {
            \csLlncsCheckMathPair ##1\q_stop
        }
        \csLlncsIf:nnT {format} {camera-ready}
        {
            \csLlncsCheckMathPair font/inherit\q_stop
            \csLlncsCheckMathPair equations/inherit\q_stop
            \clist_map_inline:nn
            {
                layout,
                caption,
                float,
                lists,
                microtype
            }
            {
                \prop_get:NnNT \g_csMathChoices_prop {##1} \l_tmpa_tl
                {
                    \tl_if_eq:NnT \l_tmpa_tl {true}
                    {
                        \PackageError {llncscrypto} {csmath~feature~##1~changes~publisher~formatting}
                        {Disable~it~for~camera-ready~LNCS;~use~local~LNCS~helpers~where~needed.}
                    }
                }
            }
        }
    }
    {
        \PackageError {llncscrypto} {Cannot~validate~this~csmath~configuration}
        {Use~the~tested~csmath~1.1.1~interface~or~load~llncscrypto~standalone.}
    }
}

\cs_new_protected:Npn \csLlncsCheckMathPair #1/#2\q_stop
{
    \prop_get:NnN \g_csMathChoices_prop {#1} \l_tmpa_tl
    \tl_if_eq:NnF \l_tmpa_tl {#2}
    {
        \PackageError {llncscrypto} {csmath~requires~#1=#2~for~this~LNCS~configuration}
        {Configure~csmath~before~loading~llncscrypto.}
    }
}

\cs_new_protected:Npn \csLlncsValidateCrypto
{
    \csLlncsIf:nnT {format} {camera-ready}
    {
        \bool_if:NT \g_tcsc_venue_bool
        {
            \PackageError {llncscrypto} {tcscrypto~venuestyle~changes~LNCS~caption~spacing}
            {Omit~venuestyle.~Use~tcscrypto[notoc]~for~camera-ready~LNCS.}
        }
        \bool_if:NT \g_tcsc_toc_bool
        {
            \PackageError {llncscrypto} {tcscrypto~requires~notoc~for~camera-ready~LNCS}
            {Its~default~TOC~integration~changes~publisher-owned~structure.}
        }
    }
}
\@ifpackageloaded {tcscrypto} {\csLlncsValidateCrypto}
{
    \AddToHook {package/tcscrypto/after} [llncscrypto] {\csLlncsValidateCrypto}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Dependencies
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\clist_map_inline:nn
{
    captions,
    colorlinks,
    libertine,
    microtype,
    draft-footer
}
{
    \csLlncsIf:nnT {#1} {true}
    {
        \csLlncsPreprintOnly {#1}
    }
}
\csLlncsIf:nnT {libertine} {true}
{
    \@ifpackageloaded {csmath}
    {
        \str_if_eq:eeF {\CsmathSelectedFont} {libertine}
        {
            \PackageError {llncscrypto} {Preloaded~csmath~font~is~not~libertine}
            {Select~font=libertine~in~csmath;~fonts~cannot~be~reinitialized.}
        }
    }
    {
        \RequirePackage
        [
            mode = venue,
            font = libertine,
            theorems = inherit,
            paragraphs = inherit,
            cleveref = false
        ] {csmath}
    }
}
\@ifpackageloaded {csmath} {\csLlncsValidateMath}
{
    \AddToHook {package/csmath/before} [llncscrypto]
    {
        \PackageError {llncscrypto} {Load~csmath~before~llncscrypto}
        {
            csmath~owns~shared~public~helpers.~Use~mode=venue,font=inherit,
            ~theorems=inherit,paragraphs=inherit.
        }
    }
}
\bool_new:N \l_csLlncsNotes_bool
\csLlncsIf:nnT {annotations} {true}
{
    \csLlncsIf:nnT {status} {draft}
    {
        \bool_set_true:N \l_csLlncsNotes_bool
    }
}
\bool_if:NT \l_csLlncsNotes_bool
{
    \RequirePackage
    {
        xcolor,
        marginnote
    }
}
\csLlncsIf:nnT {lists} {true}
{
    \RequirePackage {enumitem}
}
\csLlncsIf:nnT {boxes} {true}
{
    \RequirePackage {framed}
}
\csLlncsIf:nnT {subfigures} {true}
{
    \csLlncsIf:nnT {captions} {true}
    {
        \PackageError {llncscrypto} {Choose~subfigures~or~captions,~not~both}
        {subfigures~uses~subfig;~the~legacy~captions~profile~uses~subcaption.}
    }
    \@ifpackageloaded {subfig}
    {
        \@ifpackageloaded {caption}
        {
            \csLlncsPreprintOnly {Preloaded~caption~restyling}
        } {}
    }
    {
        \RequirePackage
        [
            caption = false,
            font = small
        ] {subfig}
    }
}
\csLlncsIf:nnT {captions} {true}
{
    \RequirePackage
    {
        caption,
        subcaption
    }
    \captionsetup
    {
        font =
            {
                rm,
                small
            },
        labelfont = sc,
        labelsep = period,
        skip = 5pt,
        belowskip = 0pt
    }
    \captionsetup [table] {skip = 4pt}
    \captionsetup [figure] {skip = 4pt}
}
\csLlncsIf:nnT {microtype} {true}
{
    \RequirePackage {microtype}
}
\csLlncsIf:nnT {format} {preprint}
{
    \RequirePackage
    {
        geometry,
        setspace,
        fancyhdr
    }
    \prop_get:NnN \l_csLlncsChoices_prop {preprint-margin} \l_tmpa_tl
    \exp_args:Nx \geometry
    {
        margin = \l_tmpa_tl
    }
    \prop_get:NnN \l_csLlncsChoices_prop {preprint-spacing} \l_tmpa_tl
    \exp_args:NnV \regex_match:nnTF {\A [0-9]+(\.[0-9]+)?\Z} \l_tmpa_tl
    {
        \fp_compare:nNnTF {\l_tmpa_tl}> {0}
            {
                \exp_args:NV \setstretch \l_tmpa_tl
            }
            {
                \PackageError {llncscrypto} {Invalid~preprint-spacing} {Use~a~positive~number.}
            }
    }
    {
        \PackageError {llncscrypto} {Invalid~preprint-spacing} {Use~a~positive~number.}
    }
    \pagestyle {fancy}
    \fancyhf {}
    \fancyfoot [C] {\thepage}
    \renewcommand \headrulewidth {0pt}
}
\ProvideDocumentCommand \preprint
{
    O {}O {}
}
{
    \csLlncsIf:nnTF {format} {preprint}
    {
        \fancyhead [L]
        {
            \footnotesize #1
        }
        \fancyhead [R]
        {
            \footnotesize #2
        }
    }
    {
        \csLlncsPreprintOnly
        {
            \string \preprint
        }
    }
}
\csLlncsIf:nnT {draft-footer} {true}
{
    \csLlncsIf:nnTF {status} {draft}
    {
        \RequirePackage
        {
            scrtime,
            prelim2e
        }
        \renewcommand \PrelimText
        {
            \normalfont \footnotesize
            Draft~\number \year -\number \month -\number \day {}~\thistime ;~not~for~distribution
        }
    }
    {
        \PackageError {llncscrypto} {draft-footer~requires~draft} {Editorial~status~and~layout~are~separate.}
    }
}

