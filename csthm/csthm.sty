\cs_new_protected:Npn \csThmCheckReferenceOrder
{
    \@ifpackageloaded {cleveref}
    {
        \if@cref@amsmathloaded \else
            \PackageError {csthm} {cleveref~was~loaded~before~required~amsmath}
            {Load~amsmath~before~cleveref,~or~load~csthm~before~cleveref.}
        \fi
        \@ifpackageloaded {hyperref}
        {
            \if@cref@hyperrefloaded \else \csThmHyperrefOrderError \fi
        } {}
    } {}
}

\cs_new_protected:Npn \csThmHyperrefOrderError
{
    \PackageError {csthm} {hyperref~must~be~loaded~before~cleveref}
    {Move~hyperref~before~cleveref.~With~cleveref=true,~load~hyperref~before~csthm.}
}
\csThmCheckReferenceOrder

\@ifpackageloaded {hyperref} {}
{
