%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Theorem Heading Targets
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_new:N \g_csThmHeadingTargets_bool
\bool_new:N \g_csThmPendingTarget_bool
\clist_new:N \g_csThmHeadingFamilies_clist
\box_new:N \l_csThmTarget_box
\int_new:N \g_csThmTarget_int
\NewDocumentCommand \CsthmUseHeadingTargets {}
{
    \bool_gset_true:N \g_csThmHeadingTargets_bool
}
\@onlypreamble \CsthmUseHeadingTargets
\cs_new_protected:Npn \csThmUseUniqueTarget #1#2#3
{
    \cs_gset:cpn {theH#1}
    {
        csthm.\int_use:N \g_csThmTarget_int
    }
    \clist_gput_right:Nn \g_csThmHeadingFamilies_clist {#1,#1*}
}

\NewDocumentCommand \csThmStepWithTarget {om}
{
    \cs_set_eq:NN \refstepcounter \csThmNativeStep
    \exp_args:NNx \clist_if_in:NnTF \g_csThmHeadingFamilies_clist {\InTheoType}
    {
        \LinkTargetOff
        \IfNoValueTF {#1}
        {
            \refstepcounter {#2}
        }
        {
            \refstepcounter [#1] {#2}
        }
        \LinkTargetOn
        \hbox_set:Nn \l_csThmTarget_box
        {
            \MakeLinkTarget *
            {
                #2.csthm.\int_use:N \g_csThmTarget_int
            }
        }
        \bool_gset_true:N \g_csThmPendingTarget_bool
    }
    {
        \IfNoValueTF {#1}
        {
            \refstepcounter {#2}
        }
        {
            \refstepcounter [#1] {#2}
        }
    }
}

\cs_new_protected:Npn \csThmPlaceHeadingTarget
{
    \bool_if:NT \g_csThmPendingTarget_bool
    {
        \bool_gset_false:N \g_csThmPendingTarget_bool
        \box_use_drop:N \l_csThmTarget_box
    }
}

\cs_new_protected:Npn \csThmInstallHeadingTargets
{
    \AddToHook {cmd/@thm/before} [csthm/heading-targets]
    {
        \cs_set_eq:NN \csThmNativeStep \refstepcounter
        \cs_set_eq:NN \refstepcounter \csThmStepWithTarget
    }
}
\AddToHook {begindocument/end} [csthm/heading-targets]
{
    \bool_if:NT \g_csThmHeadingTargets_bool
    {
        \@ifpackageloaded {hyperref}
        {
            \CsthmMapFamilies \csThmUseUniqueTarget
            \AddToHook {cmd/@thm/before} [csthm/unique-targets]
            {
                \int_gincr:N \g_csThmTarget_int
            }
            \@ifpackageloaded {cleveref} {\csThmInstallHeadingTargets}
            {
                \cs_if_exist:NF \Hy@theorem@refstepcounter
                {\csThmInstallHeadingTargets}
            }
        } {}
    }
}

\tl_if_eq:NnT \csThmNumberWithin {chapter}
{
    \cs_if_exist:cF {c@chapter}
    {
        \PackageError {csthm} {Chapter~numbering~requires~a~chapter~counter}
        {Use~a~chapter-based~class,~or~numberwithin=section~or~none.}
    }
}
\tl_if_eq:NnT \csThmStyle {normal}
{
    \bool_gset_true:N \csThmUseFrame
}
\tl_if_eq:NnT \csThmStyle {fancy}
{
    \bool_gset_true:N \csThmUseFrame
}

