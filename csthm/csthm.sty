%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Legacy Families
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tl_if_eq:NnF \csThmAppearance {modern}
{
    \csThmRemoveFamily \csThmRemarkList {observation}
    \clist_gput_right:Nn \csThmTheoremList
    {
        {observation} {Observation} {Observations}
    }
    \csThmRemoveFamily \csThmRemarkList {example}
    \clist_gput_right:Nn \csThmDefinitionList
    {
        {example} {Example} {Examples}
    }
    \csThmRemoveFamily \csThmDefinitionList {openproblem}
    \clist_gput_right:Nn \csThmRemarkList
    {
        {openproblem} {Open~Problem} {Open~Problems}
    }
    \exp_args:NnV \clist_if_in:nnT
    {
        legacy-article,
        legacy-book
    }
    \csThmAppearance
    {
        \clist_map_inline:nn
        {
            theorem,
            definition,
            remark,
            highlight
        }
        {
            \CsthmSetupFamily {#1}
            {
                body-font = normal,
                end-symbol = \CsthmEndMark
            }
        }
        \CsthmSetupFamily {remark}
        {
            head-font =
                {
                    \normalfont \scshape
                }
        }
        \CsthmSetupFamily {highlight}
        {
            head-font =
                {
                    \normalfont \sffamily
                }
        }
        \tl_if_eq:NnTF \csThmAppearance {legacy-article}
        {
            \CsthmSetupFamily {theorem} {head-font = bold}
            \CsthmSetupFamily {definition} {head-font = bold}
            \SetTheoremEndSymbol
            {
                \ensuremath
                {
                    \scriptstyle \lrcorner
                }
            }
            \SetQEDSymbol
            {
                \ensuremath
                {
                    \scriptstyle \CsthmQED
                }
            }
        }
        {
            \CsthmSetupFamily {definition}
            {
                start-symbol = \CsthmStartMark
            }
            \SetQEDSymbol
            {
                \ensuremath {\diamond}
            }
        }
    }
}

