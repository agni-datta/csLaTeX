%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% QED and end-mark symbols
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NewDocumentCommand \CsthmQED     {}
{ \ensuremath{ \color{\g_csthm_accent_tl} \square   } }
\NewDocumentCommand \CsthmEndMark {}
{ \ensuremath{ \color{\g_csthm_accent_tl} \lrcorner } }
\global\qedsymbol{\CsthmQED}
\renewcommand{\proofSymbol}{\the\qedsymbol}
\ProvideDocumentCommand{\setqedsymbol}{m}{\global\qedsymbol{#1}}
\ProvideDocumentCommand{\settheoremendsymbol}{m}{ \RenewDocumentCommand{\CsthmEndMark}{}{#1} }
\ProvideDocumentCommand{\SetQEDSymbol}{m}{ \setqedsymbol{#1} }
\ProvideDocumentCommand{\SetTheoremEndSymbol}{m}{ \settheoremendsymbol{#1} }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Case environment
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newlist{csthm@caselist}{enumerate}{1}
\setlist[csthm@caselist]{ label = \textbf{Case~\arabic*:} , leftmargin = * }

\NewDocumentEnvironment{case}{O{}}
{ \begin{csthm@caselist}[#1] }
{ \end{csthm@caselist}       }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Theorem environments
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newtheoremstyle{csthmplain}
{\item[\hskip\labelsep\theorem@headerfont ##1\ ##2\unskip\theorem@separator]}
{\item[\hskip\labelsep\theorem@headerfont ##1\ ##2\ {\normalfont(##3)}\unskip\theorem@separator]}
\newtheoremstyle{nonumbercsthmplain}
{\item[\hskip\labelsep\theorem@headerfont ##1\unskip\theorem@separator]}
{\item[\hskip\labelsep\theorem@headerfont ##1\ {\normalfont(##3)}\unskip\theorem@separator]}

\newif\ifcsthm@useframe
\def\csthm@preskip{0pt}
\def\csthm@postskip{0pt}
\def\csthm@currentframe{}

\def\csthm@configurefamily#1#2#3#4{%
	\theoremstyle{csthmplain}%
	\theoremheaderfont{#1}%
	\theorembodyfont{#2}%
	\theoremseparator{.}%
	\theorempreskip{\csthm@preskip}%
	\theorempostskip{\csthm@postskip}%
	\theoremsymbol{#3}%
	\def\csthm@currentframe{#4}%
}
\def\csthm@declareone#1{\expandafter\csthm@declareone@parse#1\csthm@nil}
\def\csthm@declareone@parse#1/#2\csthm@nil{%
	\newtheorem{#1}{#2}[section]%
	\renewtheorem*{#1*}{#2}%
	\ifcsthm@useframe
		\surroundwithmdframed[style=\csthm@currentframe]{#1}%
		\surroundwithmdframed[style=\csthm@currentframe]{#1*}%
	\fi
}
\def\csthm@declarefamily#1#2#3#4#5{%
	\csthm@configurefamily{#1}{#2}{#3}{#4}%
	\expandafter\csthm@processlist\expandafter{#5}%
}
\def\csthm@processlist#1{\forcsvlist{\csthm@declareone}{#1}}

\def\csthm@theoremlist{%
	theorem/Theorem,assertion/Assertion,assumption/Assumption,axiom/Axiom,
	claim/Claim,conclusion/Conclusion,conjecture/Conjecture,corollary/Corollary,
	fact/Fact,folklore/Folklore,hypothesis/Hypothesis,lemma/Lemma,
	postulate/Postulate,property/Property,proposition/Proposition%
}
\def\csthm@definitionlist{%
	application/Application,construction/Construction,convention/Convention,
	definition/Definition,experiment/Experiment,notation/Notation,
	openproblem/Open~Problem,problem/Problem,protocol/Protocol,result/Result%
}
\def\csthm@remarklist{%
	commentary/Commentary,contribution/Contribution,example/Example,exercise/Exercise,
	motivation/Motivation,notationabuse/Notation~Abuse,note/Note,
	observation/Observation,question/Question,remark/Remark%
}
\def\csthm@highlightlist{%
	guideline/Guideline,highlight/Highlight,important/Important,insight/Insight,
	keypoint/Key~Point,recall/Recall,summary/Summary,takeaway/Takeaway,
	tip/Tip,warning/Warning%
}

\def\csthm@declareproofhelpers{%
	\NewDocumentEnvironment{proofsketch}{o}
	{
		\IfNoValueTF{##1}
		{ \begin{proof}[Proof~(Sketch)] }
		{ \begin{proof}[Proof~(Sketch~##1)] }
	}
	{ \end{proof} }
	\NewDocumentEnvironment{proofidea}{o}
	{
		\IfNoValueTF{##1}
		{ \begin{proof}[Proof~(Idea)] }
		{ \begin{proof}[Proof~(Idea~##1)] }
	}
	{ \end{proof} }
	\NewDocumentEnvironment{proofofclaim}{o}
	{
		\IfNoValueTF{##1}
		{ \begin{proof}[Proof~of~Claim] }
		{ \begin{proof}[Proof~of~Claim~(##1)] }
	}
	{ \end{proof} }
}

\def\csthm@setupnormal{%
	\csthm@useframetrue
	\def\csthm@preskip{0pt}\def\csthm@postskip{0pt}
	\mdfdefinestyle{csthm@ruled}{
		linewidth         = 0.5pt,
		topline           = true,
		bottomline        = true,
		leftline          = false,
		rightline         = false,
		innertopmargin    = 7.5pt,
		innerbottommargin = 7.5pt,
		innerleftmargin   = 0pt,
		innerrightmargin  = 0pt,
		skipabove         = 0.75\baselineskip,
		skipbelow         = 0.75\baselineskip
	}
	\csthm@declarefamily{\scshape}{\normalfont}{\CsthmEndMark}{csthm@ruled}{\csthm@theoremlist}
	\csthm@declarefamily{\scshape}{\normalfont}{\CsthmEndMark}{csthm@ruled}{\csthm@definitionlist}
	\csthm@declarefamily{\scshape}{\normalfont}{\CsthmEndMark}{csthm@ruled}{\csthm@remarklist}
	\csthm@declarefamily{\sffamily}{\normalfont\sffamily}{\CsthmEndMark}{csthm@ruled}{\csthm@highlightlist}
	\csthm@declareproofhelpers
}

\def\csthm@definefancyframe#1#2{%
	\mdfdefinestyle{#1}{
		linewidth       = 2pt,
		topline         = false,
		bottomline      = false,
		rightline       = false,
		leftline        = true,
		linecolor       = #2,
		backgroundcolor = #2!5
	}
}
\def\csthm@setupfancy{%
	\csthm@useframetrue
	\def\csthm@preskip{0pt}\def\csthm@postskip{0pt}
	\colorlet{csthm@thmcolor}{SeaGreen4}
	\colorlet{csthm@defcolor}{RoyalBlue2}
	\colorlet{csthm@remarkcolor}{Aquamarine4}
	\colorlet{csthm@hltcolor}{DeepPink4}
	\csthm@definefancyframe{csthm@thmframe}{csthm@thmcolor}
	\csthm@definefancyframe{csthm@defframe}{csthm@defcolor}
	\csthm@definefancyframe{csthm@remarkframe}{csthm@remarkcolor}
	\csthm@definefancyframe{csthm@hltframe}{csthm@hltcolor}
	\csthm@declarefamily{\sffamily\color{csthm@thmcolor}}{\normalfont}{}{csthm@thmframe}{\csthm@theoremlist}
	\csthm@declarefamily{\sffamily\color{csthm@defcolor}}{\normalfont}{}{csthm@defframe}{\csthm@definitionlist}
	\csthm@declarefamily{\sffamily\color{csthm@remarkcolor}}{\normalfont}{}{csthm@remarkframe}{\csthm@remarklist}
	\csthm@declarefamily{\sffamily\color{csthm@hltcolor}}{\normalfont\sffamily}{}{csthm@hltframe}{\csthm@highlightlist}
	\csthm@declareproofhelpers
}

\def\csthm@setupoldschool{%
	\csthm@useframefalse
	\def\csthm@preskip{\topsep}\def\csthm@postskip{\topsep}
	\csthm@declarefamily{\scshape}{\normalfont}{}{}{\csthm@theoremlist}
	\csthm@declarefamily{\scshape}{\normalfont}{\CsthmEndMark}{}{\csthm@definitionlist}
	\csthm@declarefamily{\scshape}{\normalfont}{\CsthmEndMark}{}{\csthm@remarklist}
	\csthm@declarefamily{\sffamily}{\normalfont\sffamily}{\CsthmEndMark}{}{\csthm@highlightlist}
	\csthm@declareproofhelpers
}

\bool_if:NTF \g_csthm_fancy_bool
{ \csthm@setupfancy }
{
	\bool_if:NTF \g_csthm_normal_bool
	{ \csthm@setupnormal }
	{
		\bool_if:NTF \g_csthm_oldschool_bool
		{ \csthm@setupoldschool }
		{
			\PackageInfo{csthm}
			{ No~style~option~given;~no~theorem~environments~defined. }
		}
	}
}

