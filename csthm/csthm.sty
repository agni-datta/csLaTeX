\bool_new:N \g_csThmInitialized_bool
\tl_new:N \csThmCounters
\tl_new:N \csThmFamilies
\tl_new:N \csThmStarred
\tl_new:N \csThmSolution
\tl_new:N \csThmAppearance
\tl_new:N \g_csThmFamilyOptions_tl
\cs_new_protected:Npn \csThmSelectOption #1#2#3
{
    \bool_if:NTF \g_csThmInitialized_bool
    {
        \tl_if_eq:NnF #1 {#3}
        {
            \PackageError {csthm} {Theorem~configuration~is~fixed:~#2}
            {Select~counter,~family,~star~and~appearance~options~at~the~initial~package~load.}
        }
    }
    {
        \tl_if_empty:NTF #1
        {
            \tl_gset:Nn #1 {#3}
        }
        {
            \tl_if_eq:NnF #1 {#3}
            {
                \PackageError {csthm} {Conflicting~#2~selections} {Choose~one~value~for~#2.}
            }
        }
    }
}

\msg_new:nnn {csthm} {conflicting-styles}
{Conflicting~styles~'#1'~and~'#2'.~Select~one~csthm~style.}
\cs_new_protected:Npn \csThmSelectStyle #1
{
    \bool_if:NTF \g_csThmInitialized_bool
    {
        \tl_if_eq:NnF \csThmStyle {#1}
        {
            \PackageError {csthm} {Theorem~configuration~is~fixed:~style}
            {Select~a~style~at~initial~load.}
        }
    }
    {
        \tl_if_empty:NTF \csThmStyle
        {
            \tl_gset:Nn \csThmStyle {#1}
        }
        {
            \tl_if_eq:NnF \csThmStyle {#1}
            {
                \msg_error:nnxx {csthm} {conflicting-styles} {\csThmStyle} {#1}
            }
        }
    }
}
\keys_define:nn {csthm}
{
    style .choice:,
    style/normal .code:n =
        {
            \csThmSelectStyle {normal}
        },
    style/fancy .code:n =
        {
            \csThmSelectStyle {fancy}
        },
    style/oldschool .code:n =
        {
            \csThmSelectStyle {oldschool}
        },
    style .value_required:n = true,
    normal .code:n =
        {
            \csThmSelectStyle {normal}
        },
    fancy .code:n =
        {
            \csThmSelectStyle {fancy}
        },
    oldschool .code:n =
        {
            \csThmSelectStyle {oldschool}
        },
    normal .value_forbidden:n = true,
    fancy .value_forbidden:n = true,
    oldschool .value_forbidden:n = true,
    numberwithin .choices:nn =
        {
            section,
            chapter,
            none
        }
        {
            \exp_args:NNnV \csThmSelectOption \csThmNumberWithin {numberwithin} \l_keys_choice_tl
        },
    numberwithin .value_required:n = true,
    cleveref .choices:nn =
        {
            auto,
            true,
            false
        }
        {
            \exp_args:NNnV \csThmSelectOption \csThmCleveref {cleveref} \l_keys_choice_tl
        },
    cleveref .default:n = true,
    counters .choices:nn =
        {
            independent,
            shared
        }
        {
            \exp_args:NNnV \csThmSelectOption \csThmCounters {counters} \l_keys_choice_tl
        },
    counters .value_required:n = true,
    families .choices:nn =
        {
            standard,
            extended
        }
        {
            \exp_args:NNnV \csThmSelectOption \csThmFamilies {families} \l_keys_choice_tl
        },
    families .value_required:n = true,
    starred .choices:nn =
        {
            unnumbered,
            legacy,
        }
        {
            \exp_args:NNnV \csThmSelectOption \csThmStarred {starred} \l_keys_choice_tl
        },
    starred .value_required:n = true,
    appearance .choices:nn =
        {
            modern,
            legacy-article,
            legacy-book,
        }
        {
            \exp_args:NNnV \csThmSelectOption \csThmAppearance {appearance} \l_keys_choice_tl
        },
    appearance .value_required:n = true,
    solution .choices:nn =
        {
            theorem,
            proof
        }
        {
            \exp_args:NNnV \csThmSelectOption \csThmSolution {solution} \l_keys_choice_tl
        },
    solution .value_required:n = true,
    family-style .code:n =
        {
            \bool_if:NTF \g_csThmInitialized_bool
            {
                \PackageError {csthm} {Use~CsthmSetupFamily~for~preamble~styling} {Package~configuration~is~already~fixed.}
            }
            {
                \tl_gput_right:Nn \g_csThmFamilyOptions_tl {#1,}
            }
        },
    family-style .value_required:n = true,
}
