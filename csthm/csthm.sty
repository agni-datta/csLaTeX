%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Family Typography
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_generate_variant:Nn \prop_gput:Nnn
{
    Nxn,
    NxV
}
\prop_new:N \g_csThmFamilyStyle_prop
\tl_new:N \l_csThmFamily_tl
\cs_new_protected:Npn \csThmSetFamilyFont #1#2
{
    \str_case:nnF {#2}
    {
        {normal}
        {
            \tl_set:Nn \l_tmpa_tl {\normalfont}
        }
        {roman}
        {
            \tl_set:Nn \l_tmpa_tl {\normalfont}
        }
        {bold}
        {
            \tl_set:Nn \l_tmpa_tl {\bfseries}
        }
        {boldsans}
        {
            \tl_set:Nn \l_tmpa_tl
            {
                \sffamily \bfseries
            }
        }
        {italic}
        {
            \tl_set:Nn \l_tmpa_tl {\itshape}
        }
        {italics}
        {
            \tl_set:Nn \l_tmpa_tl {\itshape}
        }
        {sans}
        {
            \tl_set:Nn \l_tmpa_tl {\sffamily}
        }
        {smallcaps}
        {
            \tl_set:Nn \l_tmpa_tl {\scshape}
        }
    }
    {
        \tl_set:Nn \l_tmpa_tl {#2}
    }
    \prop_gput:NxV \g_csThmFamilyStyle_prop
    {
        \l_csThmFamily_tl /#1
    } \l_tmpa_tl
}
\keys_define:nn {csthm/family}
{
    head-font .value_required:n = true,
    head-font .code:n =
        {
            \csThmSetFamilyFont {head-font} {#1}
        },
    body-font .value_required:n = true,
    body-font .code:n =
        {
            \csThmSetFamilyFont {body-font} {#1}
        },
    start-symbol .value_required:n = true,
    start-symbol .code:n =
        {
            \prop_gput:Nxn \g_csThmFamilyStyle_prop
            {
                \l_csThmFamily_tl /start-symbol
            } {#1}
        },
    end-symbol .value_required:n = true,
    end-symbol .code:n =
        {
            \prop_gput:Nxn \g_csThmFamilyStyle_prop
            {
                \l_csThmFamily_tl /end-symbol
            } {#1}
        },
}

\NewDocumentCommand \CsthmSetupFamily {mm}
{
    \clist_if_in:nnTF
    {
        theorem,
        definition,
        remark,
        highlight
    } {#1}
    {
        \tl_if_empty:NTF \csThmStyle
        {
            \PackageError {csthm} {Family~styling~requires~theorem~ownership} {Select~a~csthm~style.}
        }
        {
            \tl_set:Nn \l_csThmFamily_tl {#1}
            \keys_set:nn {csthm/family} {#2}
        }
    }
    {
        \PackageError {csthm} {Unknown~theorem~family~group~#1} {Use~theorem,~definition,~remark~or~highlight.}
    }
}
\@onlypreamble \CsthmSetupFamily
\clist_map_inline:nn
{
    theorem,
    definition,
    remark,
    highlight
}
{
    \keys_define:nn {csthm/families}
    {
        #1 .code:n =
            {
                \CsthmSetupFamily {#1} {##1}
            }
    }
}

\cs_new_protected:Npn \csThmFamilyValue #1#2
{
    \prop_item:Nn \g_csThmFamilyStyle_prop {#1/#2}
}

\cs_new_protected:Npn \csThmFamilyStart #1
{
    \prop_get:NnN \g_csThmFamilyStyle_prop {#1/start-symbol} \l_tmpa_tl
    \tl_if_empty:NF \l_tmpa_tl
    {
        \tl_use:N \l_tmpa_tl \nobreakspace
    }
}

\cs_new_protected:Npn \csThmFamilyDefault #1#2#3
{
    \prop_if_in:NnF \g_csThmFamilyStyle_prop {#1/#2}
    {
        \prop_gput:Nnn \g_csThmFamilyStyle_prop {#1/#2} {#3}
    }
}

\cs_new_protected:Npn \csThmConfigureFamily #1#2
{
    \theoremstyle {csthmplain}
    \theoremheaderfont
    {
        \csThmFamilyValue {#1} {head-font}
        \csThmFamilyStart {#1}
    }
    \theorembodyfont
    {
        \csThmFamilyValue {#1} {body-font}
    }
    \theoremseparator {.}
    \theorempreskip {\csThmPreSkip}
    \theorempostskip {\csThmPostSkip}
    \theoremsymbol
    {
        \csThmFamilyValue {#1} {end-symbol}
    }
    \def \csThmCurrentFrame {#2}
}
\clist_const:Nn \csThmLegacyUnnumbered
{
    claim,
    conjecture,
    corollary,
    hypothesis,
    informaltheorem,
    lemma,
    theorem,
    openproblem,
    syntax
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Starred Environments
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_new:N \l_csThmSteppingStar_bool
\cs_new_protected:Npn \csThmDeclareOne #1#2#3
{
    \bool_lazy_and:nnTF
    {
        \str_if_eq_p:Vn \csThmCounters {shared}
    }
    {
        !\str_if_eq_p:nn {#1} {theorem}
    }
    {
        \newaliascnt {#1} {theorem}
        \newtheorem {#1} [#1] {#2}
        \aliascntresetthe {#1}
        \tl_if_eq:NnF \csThmNumberWithin {none}
        {
            \counterwithin * {#1} {\csThmNumberWithin}
        }
        \cs_gset:cpn {theH#1} {\theHtheorem}
    }
    {
        \tl_if_eq:NnTF \csThmNumberWithin {none}
        {
            \newtheorem {#1} {#2}
        }
        {
            \newtheorem {#1} {#2} [\csThmNumberWithin]
        }
        \tl_if_eq:NnT \csThmCounters {shared}
        {
            \tl_if_eq:NnTF \csThmNumberWithin {none}
            {
                \cs_gset:Npn \theHtheorem
                {
                    \arabic {theorem}
                }
            }
            {
                \cs_gset:Npx \theHtheorem
                {
                    \exp_not:c
                    {
                        theH\csThmNumberWithin
                    }.\exp_not:N \arabic {theorem}
                }
            }
        }
    }
    \bool_set_false:N \l_csThmSteppingStar_bool
    \str_case:Vn \csThmStarred
    {
        {legacy}
        {
            \clist_if_in:NnF \csThmLegacyUnnumbered {#1}
            {
                \str_if_eq:nnF {#1} {contribution}
                {
                    \bool_set_true:N \l_csThmSteppingStar_bool
                }
            }
        }
    }
    \bool_if:NF \l_csThmSteppingStar_bool
    {
        \renewtheorem * {#1*} {#2}
    }
    \bool_if:NT \csThmUseFrame
    {
        \surroundwithmdframed [style = \csThmCurrentFrame ] {#1}
        \bool_lazy_and:nnF
        {
            \str_if_eq_p:Vn \csThmAppearance {legacy-book}
        } {\l_csThmSteppingStar_bool}
        {
            \surroundwithmdframed [style = \csThmCurrentFrame ] {#1*}
        }
    }
}

\cs_new_protected:Npn \csThmDeclareFamily #1#2#3#4#5#6
{
    \csThmFamilyDefault {#1} {head-font} {#2}
    \csThmFamilyDefault {#1} {body-font} {#3}
    \csThmFamilyDefault {#1} {end-symbol} {#4}
    \csThmFamilyDefault {#1} {start-symbol} {}
    \csThmConfigureFamily {#1} {#5}
    \clist_map_inline:Nn #6
    {
        \csThmDeclareOne ##1
    }
}

