\def \csThmDeclareProofHelpers
{
    \NewDocumentEnvironment {proofsketch} {o}
    {
        \IfNoValueTF {##1}
        {
            \begin {proof} [Proof~(Sketch)]
        }
        {
            \begin {proof} [Proof~(Sketch~##1)]
        }
    }
    {
        \end {proof}
    }
    \NewDocumentEnvironment {proofidea} {o}
    {
        \IfNoValueTF {##1}
        {
            \begin {proof} [Proof~(Idea)]
        }
        {
            \begin {proof} [Proof~(Idea~##1)]
        }
    }
    {
        \end {proof}
    }
    \NewDocumentEnvironment {proofofclaim} {o}
    {
        \IfNoValueTF {##1}
        {
            \begin {proof} [Proof~of~Claim]
        }
        {
            \begin {proof} [Proof~of~Claim~(##1)]
        }
    }
    {
        \end {proof}
    }
}

\def \csThmSetupNormal
{
    \def \csThmPreSkip {0pt}
    \def \csThmPostSkip {0pt}
    \mdfdefinestyle {csThmRuled}
    {
        linewidth = 0.5pt,
        topline = true,
        bottomline = true,
        leftline = false,
        rightline = false,
        innertopmargin = 7.5pt,
        innerbottommargin = 7.5pt,
        innerleftmargin = 0pt,
        innerrightmargin = 0pt,
        skipabove = 0.75\baselineskip ,
        skipbelow = 0.75\baselineskip
    }
    \csThmDeclareFamily {theorem} {\scshape} {\normalfont} {\CsthmEndMark} {csThmRuled} {\csThmTheoremList}
    \csThmDeclareFamily {definition} {\scshape} {\normalfont} {\CsthmEndMark} {csThmRuled} {\csThmDefinitionList}
    \csThmDeclareFamily {remark} {\scshape} {\normalfont} {\CsthmEndMark} {csThmRuled} {\csThmRemarkList}
    \csThmDeclareFamily {highlight} {\sffamily}
    {
        \normalfont \sffamily
    } {\CsthmEndMark} {csThmRuled} {\csThmHighlightList}
    \csThmDeclareProofHelpers
}

\def \csThmDefineFancyFrame #1#2
{
    \mdfdefinestyle {#1}
    {
        linewidth = 2pt,
        topline = false,
        bottomline = false,
        rightline = false,
        leftline = true,
        linecolor = #2,
        backgroundcolor = #2!5
    }
}
\def \csThmSetupFancy
{
    \def \csThmPreSkip {0pt}
    \def \csThmPostSkip {0pt}
    \colorlet {csThmTheoremColor} {SeaGreen4}
    \colorlet {csThmDefinitionColor} {RoyalBlue2}
    \colorlet {csThmRemarkColor} {Aquamarine4}
    \colorlet {csThmHighlightColor} {DeepPink4}
    \csThmDefineFancyFrame {csThmTheoremFrame} {csThmTheoremColor}
    \csThmDefineFancyFrame {csThmDefinitionFrame} {csThmDefinitionColor}
    \csThmDefineFancyFrame {csThmRemarkFrame} {csThmRemarkColor}
    \csThmDefineFancyFrame {csThmHighlightFrame} {csThmHighlightColor}
    \csThmDeclareFamily {theorem}
    {
        \sffamily \color {csThmTheoremColor}
    } {\normalfont} {} {csThmTheoremFrame} {\csThmTheoremList}
    \csThmDeclareFamily {definition}
    {
        \sffamily \color {csThmDefinitionColor}
    } {\normalfont} {} {csThmDefinitionFrame} {\csThmDefinitionList}
    \csThmDeclareFamily {remark}
    {
        \sffamily \color {csThmRemarkColor}
    } {\normalfont} {} {csThmRemarkFrame} {\csThmRemarkList}
    \csThmDeclareFamily {highlight}
    {
        \sffamily \color {csThmHighlightColor}
    }
    {
        \normalfont \sffamily
    } {} {csThmHighlightFrame} {\csThmHighlightList}
    \csThmDeclareProofHelpers
}

\def \csThmSetupOldschool
{
    \def \csThmPreSkip {\topsep}
    \def \csThmPostSkip {\topsep}
    \tl_if_eq:NnT \csThmAppearance {legacy-article}
    {
        \def \csThmPreSkip {3pt}
        \def \csThmPostSkip {3pt}
    }
    \csThmDeclareFamily {theorem} {\scshape} {\normalfont} {} {} {\csThmTheoremList}
    \csThmDeclareFamily {definition} {\scshape} {\normalfont} {\CsthmEndMark} {} {\csThmDefinitionList}
    \csThmDeclareFamily {remark} {\scshape} {\normalfont} {\CsthmEndMark} {} {\csThmRemarkList}
    \csThmDeclareFamily {highlight} {\sffamily}
    {
        \normalfont \sffamily
    } {\CsthmEndMark} {} {\csThmHighlightList}
    \csThmDeclareProofHelpers
}

\str_case:VnF \csThmStyle
{
    {normal} {\csThmSetupNormal}
    {fancy} {\csThmSetupFancy}
    {oldschool} {\csThmSetupOldschool}
}
{
    \PackageInfo {csthm} {No~style~selected;~only~auxiliary~environments~defined}
}

