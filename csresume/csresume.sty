\NeedsTeXFormat{LaTeX2e}[2022/06/01]
\ProvidesExplPackage{csresume}{2026/10/14}{5.4}{Compact academic CVs}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Options
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_new:N \g__csresume_allowbreaks_bool
\keys_define:nn {csresume}
{
  allowbreaks .bool_gset:N = \g__csresume_allowbreaks_bool,
  allowbreaks .default:n = true,
  allowbreaks .initial:n = false
}
\ProcessKeyOptions [csresume]
\ExplSyntaxOff

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Dependencies and Typography
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage{babel}
\RequirePackage[autostyle=true]{csquotes}
\RequirePackage{microtype}
\RequirePackage{setspace}
\RequirePackage[margin=0.8in,heightrounded]{geometry}
\RequirePackage{needspace}
\RequirePackage{tabularx}
\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage{multicol}
\RequirePackage[x11names]{xcolor}
\RequirePackage[colorlinks]{hyperref}
\RequirePackage{lastpage}
\RequirePackage[
  backend=biber,
  style=numeric,
  sorting=ydnt,
  defernumbers=true,
  isbn=false,
  maxnames=999,
  giveninits=false
]{biblatex}

% Inherit the article class's Computer Modern roman, sans, and math fonts.
\setstretch{1.075}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\setcounter{secnumdepth}{0}
\raggedbottom
\hypersetup{allcolors=SteelBlue4,pdftitle={Curriculum Vitae}}
\urlstyle{tt}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Section Headings and Lists
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\titleformat{\section}[block]{\large\sffamily\mdseries\filright}{}{0pt}
{\titleline{\titlerule[0.3pt]}\smallskip}%
[{\smallskip\titleline{\titlerule[0.3pt]}\smallskip}]
\titleformat{\subsection}[block]{\normalsize\sffamily\mdseries\filright}{}{0pt}
{\titleline{\titlerule[0.25pt]}\smallskip}%
[{\smallskip\titleline{\titlerule[0.25pt]}\smallskip}]
\titleformat{\subsubsection}{\normalsize\sffamily\mdseries}{}{0pt}{}
\titlespacing*{\section}{0pt}{0.65\baselineskip}{0.3\baselineskip}
\titlespacing*{\subsection}{0pt}{0.65\baselineskip}{0.3\baselineskip}
\titlespacing*{\subsubsection}{0pt}{0.6\baselineskip}{0.3\baselineskip}
\setlist{topsep=0.25\baselineskip,itemsep=0pt,parsep=0pt,leftmargin=*}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Publication Lists
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\DeclareNameAlias{default}{given-family}
\DeclareFieldFormat[article,inproceedings,incollection,inbook,book,thesis,unpublished]{title}{\mkbibemph{#1}\ifkeyword{randomized-authorship}{\addspace\cvrandomized}{}\isdot}
\AtEveryBibitem{\clearfield{issn}\clearfield{series}}
\setlength{\bibitemsep}{0.55\baselineskip}
\setlength{\bibparsep}{0pt}

\ExplSyntaxOn

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Publication Numbering and Authorship
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\int_new:N \g__csresume_bib_total_int
\int_new:N \g__csresume_bib_printed_int
\AtDataInput{\int_gincr:N \g__csresume_bib_total_int}
\cs_new:Npn \__csresume_bib_number:
{
  \int_compare:nNnT
  {\g__csresume_bib_total_int-\g__csresume_bib_printed_int+1} < {10} {0}
  \int_eval:n {\g__csresume_bib_total_int-\g__csresume_bib_printed_int+1}
}
\defbibenvironment{bibliography}
{
  \list{}
  {
    \setlength{\labelwidth}{2.4em}
    \setlength{\labelsep}{0.6em}
    \setlength{\leftmargin}{\labelwidth}
    \addtolength{\leftmargin}{\labelsep}
    \setlength{\itemindent}{0pt}
    \setlength{\itemsep}{\bibitemsep}
    \setlength{\parsep}{\bibparsep}
  }
}
{\endlist}
{
  \int_gincr:N \g__csresume_bib_printed_int
  \item[\cvright{(\__csresume_bib_number:)}]
}
\cs_new_protected:Npn \__csresume_dagger:
{(\textcolor{SteelBlue4}{\textdagger})}
\NewDocumentCommand{\cvrandomized}{}
{\hyperlink{cv:authorship}{\__csresume_dagger:}}
\NewDocumentCommand{\cvauthorshiplegend}{}
{\hypertarget{cv:authorship}{\__csresume_dagger:}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Isolated Ampersand Glyph
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Select only the upright Biolinum ampersand; keep surrounding fonts unchanged.
\cs_new_protected:Npn \__csresume_ampersand:
{
  \group_begin:
  \fontencoding{T1}\fontfamily{LinuxBiolinumT-TLF}
  \fontseries{m}\fontshape{n}\selectfont
  \char_generate:nn {38}{12}
  \group_end:
}
\RenewDocumentCommand{\&}{}
{\mode_if_math:TF {\hbox{\__csresume_ampersand:}} {\__csresume_ampersand:}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Publication Name Highlighting
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tl_new:N \g__csresume_bib_given_tl
\tl_new:N \g__csresume_bib_family_tl
\NewDocumentCommand{\cvbibname}{m m}
{
  \tl_gset:Nn \g__csresume_bib_given_tl {#1}
  \tl_gset:Nn \g__csresume_bib_family_tl {#2}
}
\cs_new_eq:NN \__csresume_bib_given:n \mkbibnamegiven
\cs_new_eq:NN \__csresume_bib_family:n \mkbibnamefamily
\cs_new_protected:Npn \__csresume_bib_name:nn #1#2
{
  \str_if_eq:eeTF {\namepartgiven} {\g__csresume_bib_given_tl}
  {
    \str_if_eq:eeTF {\namepartfamily} {\g__csresume_bib_family_tl}
    {\textsc{#2}} {#1{#2}}
  }
  {#1{#2}}
}
\RenewDocumentCommand{\mkbibnamegiven}{m}
{\__csresume_bib_name:nn \__csresume_bib_given:n {#1}}
\RenewDocumentCommand{\mkbibnamefamily}{m}
{\__csresume_bib_name:nn \__csresume_bib_family:n {#1}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Contact Links
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tl_new:N \g__csresume_orcid_tl
\NewDocumentCommand{\cvorcid}{m}{\tl_gset:Nn \g__csresume_orcid_tl {#1}}
\cs_new_protected:Npn \__csresume_orcid:n #1
{\href{\tl_to_str:n {https://orcid.org/#1}}{\texttt{ORCID:}\,\nolinkurl{#1}}}
\cs_new_protected:Npn \__csresume_email:n #1
{
  \tl_if_blank:nF {#1} {\href{\tl_to_str:n {mailto:#1}}{\nolinkurl{#1}}\par}
}
\cs_new_protected:Npn \__csresume_site:n #1
{
  \tl_if_blank:nF {#1}
  {
    \regex_match:nnTF {\A https?://} {#1}
    {\href{\tl_to_str:n {#1}}{\nolinkurl{#1}}}
    {\href{\tl_to_str:n {https://#1}}{\nolinkurl{#1}}}
  }
}
\cs_new_protected:Npn \__csresume_links:nnn #1#2#3
{
  \tl_if_blank:nF {#1} {\__csresume_site:n {#1}}
  \tl_if_blank:nF {#2}
  {
    \tl_if_blank:nF {#1} {\enspace\textbullet\enspace}
    \href{\tl_to_str:n {https://scholar.google.com/citations?user=#2}}{\texttt{Scholar}}
  }
  \tl_if_blank:nF {#3}
  {
    \bool_lazy_or:nnT
    {!\tl_if_blank_p:n {#1}} {!\tl_if_blank_p:n {#2}}
    {\enspace\textbullet\enspace}
    \href{\tl_to_str:n {https://dblp.org/pid/#3}}{\texttt{DBLP}}
  }
  \tl_if_blank:VF \g__csresume_orcid_tl
  {\par\exp_args:NV \__csresume_orcid:n \g__csresume_orcid_tl}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Letterhead
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NewDocumentCommand{\cvheader}{m m m m m m m m m}
{
  \par
  \noindent
  {\huge\sffamily\mdseries #4\par}
  \addvspace{0.35\baselineskip}
  \hrule height 0.4pt
  \addvspace{0.45\baselineskip}
  \noindent
  \begin{minipage}[t]{0.58\linewidth}
    \raggedright
    \tl_if_blank:nF {#5} {#5\par}
    \__csresume_email:n {#6}
    \__csresume_links:nnn {#7}{#8}{#9}
  \end{minipage}
  \hfill
  \begin{minipage}[t]{0.38\linewidth}
    \raggedleft\sffamily
    \tl_if_blank:nF {#1} {#1\par}
    \tl_if_blank:nF {#2} {#2\par}
    #3\par
  \end{minipage}
  \par
  \hypersetup{pdfauthor={#4}}
  \addvspace{0.5\baselineskip}
}

% Keep the original seven-field header API for other CVs.
\NewDocumentCommand{\contactblock}{m m m m m m m}
{\cvheader{}{}{#3}{#1}{#2}{#4}{#5}{#6}{#7}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Dated Entries
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \__csresume_entry_space:n #1
{
  \par
  \addvspace{0.45\baselineskip}
  \bool_if:NF \g__csresume_allowbreaks_bool
  {\Needspace{#1\baselineskip}}
}
\cs_new_protected:Npn \__csresume_entry_heading:nn #1#2
{
  \noindent
  \begin{tabularx}{\linewidth}{@{}>{\raggedright\arraybackslash}X@{\hspace{1.2em}}r@{}}
    #1 & \cvright{#2} \\
  \end{tabularx}
  \par\nopagebreak[4]
}
\NewDocumentCommand{\cvright}{m} {{\small\sffamily #1}}
\NewDocumentCommand{\cvlabel}{m} {\textsc{#1}}
\NewDocumentCommand{\years}{m} {\par\noindent\hfill\cvright{#1}\par}
\NewDocumentCommand{\details}{m m m m}
{
  \__csresume_entry_space:n {3}
  \__csresume_entry_heading:nn
  {\textbf{#2}}
  {#1}
  \tl_if_blank:nF {#3} {#3\par\nopagebreak[4]}
  \tl_if_blank:nF {#4} {#4\par}
}
\NewDocumentCommand{\columndetails}{m m m}
{
  \par\addvspace{0.25\baselineskip}
  \bool_if:NF \g__csresume_allowbreaks_bool
  {\Needspace{2\baselineskip}}
  \noindent
  \begin{tabularx}{\linewidth}{@{}p{6.25em}>{\raggedright\arraybackslash}X@{\hspace{1.2em}}r@{}}
    #1 & #2 & \cvright{#3} \\
  \end{tabularx}
  \par
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Referees and Footer
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tl_new:N \g__csresume_footer_date_tl
\tl_new:N \g__csresume_footer_site_tl
\cs_new_protected:cpn {ps@csresume}
{
  \cs_set:cpn {@oddhead} {}
  \cs_set_eq:cc {@evenhead} {@oddhead}
  \cs_set_protected:cpn {@oddfoot}
  {
    \int_compare:nNnT {\value{page}} = {\getpagerefnumber{LastPage}}
    {{\small\hbox_overlap_right:n
        {\exp_args:NV \__csresume_site:n \g__csresume_footer_site_tl}}}
    \hfil\thepage\hfil
    \int_compare:nNnT {\value{page}} = {\getpagerefnumber{LastPage}}
    {{\small\sffamily\hbox_overlap_left:n
        {Updated~\tl_use:N \g__csresume_footer_date_tl}}}
  }
  \cs_set_eq:cc {@evenfoot} {@oddfoot}
}

\NewDocumentCommand{\referals}{m m m m m m m m}
{
  \par\noindent
  \begin{minipage}[t]{\linewidth}
    \raggedright
    \textbf{\tl_if_blank:nF {#1} {#1\ }#2~#3}\par
    \tl_if_blank:nF {#4} {#4\par}
    \tl_if_blank:nF {#5} {#5\par}
    \tl_if_blank:nF {#6} {#6\par}
    \__csresume_email:n {#7}
    \__csresume_site:n {#8}
  \end{minipage}
  \par\addvspace{0.5\baselineskip}
}
\NewDocumentCommand{\finishcv}{m m}
{
  \tl_gset:Nn \g__csresume_footer_date_tl {#1}
  \tl_gset:Nn \g__csresume_footer_site_tl {#2}
  \pagestyle{csresume}
}
\NewDocumentEnvironment{refcolumns}{}
{\setlength{\columnsep}{2em}\begin{multicols}{2}}
{\end{multicols}}
\NewDocumentEnvironment{ditemize}{}
{\begin{multicols}{2}\begin{itemize}}
{\end{itemize}\end{multicols}}

\ExplSyntaxOff
\endinput
