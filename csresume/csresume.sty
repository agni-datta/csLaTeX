%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Options
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_new:N \g__csresume_allowbreaks_bool
\tl_new:N \g__csresume_accent_tl
\keys_define:nn {csresume}
{
  accent .tl_gset:N = \g__csresume_accent_tl,
  accent .value_required:n = true,
  accent .initial:n = SteelBlue4,
  allowbreaks .bool_gset:N = \g__csresume_allowbreaks_bool,
  allowbreaks .default:n = true,
  allowbreaks .initial:n = false
}
\ProcessKeyOptions [csresume]
\ExplSyntaxOff

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Dependencies and Typography
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage[autostyle=true]{csquotes}
\RequirePackage[margin=0.8in,heightrounded]{geometry}
\RequirePackage[x11names]{xcolor}
\RequirePackage{babel}
\RequirePackage{enumitem}
\RequirePackage{fix-cm}
\RequirePackage{microtype}
\RequirePackage{moresize}
\RequirePackage{multicol}
\RequirePackage{needspace}
\RequirePackage{setspace}
\RequirePackage{tabularx}
\RequirePackage{titlesec}
\ExplSyntaxOn
\exp_args:NnV \colorlet {csresumeAccent} \g__csresume_accent_tl
\ExplSyntaxOff
\RequirePackage[colorlinks]{hyperref}
\RequirePackage{lastpage}
\RequirePackage[
  backend=biber,
  style=numeric,
  sorting=ydnt,
  defernumbers=true,
  isbn=false,
  maxnames=999,
  giveninits=false
]{biblatex}

% Inherit the article class's Computer Modern roman, sans, mono, and math fonts.
\setstretch{1.05}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\setcounter{secnumdepth}{0}
\raggedbottom
\hypersetup{allcolors=csresumeAccent,pdftitle={Curriculum Vitae}}
\urlstyle{tt}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Section Headings and Lists
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\titleformat{\section}[block]{\large\sffamily\bfseries\filright}{}{0pt}
{\titleline{\titlerule[0.3pt]}\smallskip\MakeUppercase}%
[{\smallskip\titleline{\titlerule[0.3pt]}\smallskip}]
\titleformat{\subsection}[block]{\small\sffamily\bfseries\filright}{}{0pt}
{\MakeUppercase}%
[{\smallskip\titleline{\titlerule[0.2pt]}\smallskip}]
\titleformat{\subsubsection}{\normalsize\sffamily\bfseries}{}{0pt}{\MakeUppercase}
\titlespacing*{\section}{0pt}{0.45\baselineskip}{0.2\baselineskip}
\titlespacing*{\subsection}{0pt}{0.45\baselineskip}{0.2\baselineskip}
\titlespacing*{\subsubsection}{0pt}{0.45\baselineskip}{0.2\baselineskip}
\setlist{topsep=0.15\baselineskip,itemsep=0pt,parsep=0pt,leftmargin=*}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Publication Lists
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\DeclareNameAlias{default}{given-family}
\DeclareFieldFormat[article,inproceedings,incollection,inbook,book,thesis,unpublished]{title}{\textsc{#1}\ifkeyword{randomized-authorship}{\addnbspace\cvrandomized}{}\isdot}
\DeclareFieldFormat{maintitle}{#1}
\DeclareFieldFormat{booktitle}{#1}
\DeclareFieldFormat{journaltitle}{#1\isdot}
\DeclareFieldFormat{issuetitle}{#1}
\DeclareFieldFormat{doi}{%
  \ifhyperref
  {\href{https://doi.org/#1}{\texttt{doi:}\nolinkurl{#1}}}
  {\texttt{doi:}\nolinkurl{#1}}}
\DeclareFieldFormat{pages}{%
  \begingroup
  \let\bibstring\biblstring
  \mkpageprefix[bookpagination]{#1}%
  \endgroup}
\AtEveryBibitem{\clearfield{issn}\clearfield{series}}
\AtBeginBibliography{\raggedright}
\setlength{\bibitemsep}{0.55\baselineskip}
\setlength{\bibparsep}{0pt}

% Deferred block boundaries survive native title/contributor macros, but produce
% no paragraph when the following block has no printable data. BibLaTeX's
% insertion flag records earlier output even when a final optional field is empty;
% horizontal mode alone cannot distinguish text from a bibliography item anchor.
\newbibmacro*{csresume:blockpunct}{\addperiod\par\nobreak}
\newbibmacro*{csresume:block}{%
  \iftoggle{blx@insert}{\printunit{\usebibmacro{csresume:blockpunct}}}{}}
\newbibmacro*{csresume:comma}{\setunit{\addcomma\space}}
\newbibmacro*{csresume:volumes}{%
  \iffieldundef{maintitle}
  {\printfield{volume}\printfield{part}}
  {}%
  \usebibmacro{csresume:comma}%
  \printfield{volumes}%
  \usebibmacro{csresume:comma}%
  \usebibmacro{series+number}}
\newbibmacro*{csresume:contributors}{%
  \printlist{language}%
  \newunit
  \usebibmacro{byauthor}%
  \newunit
  \usebibmacro{byeditor+others}%
  \newunit}
\newbibmacro*{csresume:identifiers}{%
  \iftoggle{bbx:doi}
  {\usebibmacro{csresume:block}\printfield{doi}}
  {}%
  \iftoggle{bbx:eprint}
  {\usebibmacro{csresume:block}\usebibmacro{eprint}}
  {}%
  \iftoggle{bbx:url}
  {\usebibmacro{csresume:block}\usebibmacro{url+urldate}}
  {}}
\newbibmacro*{csresume:entry}[3]{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{#2}%
  \usebibmacro{csresume:block}%
  \usebibmacro{#1}%
  \usebibmacro{csresume:block}%
  \usebibmacro{csresume:contributors}%
  \usebibmacro{csresume:details}{#3}%
  \newunit
  \iftoggle{bbx:isbn}
  {\ifentrytype{article}{\printfield{issn}}{\printfield{isbn}}}
  {}%
  \ifentrytype{unpublished}
  {}%
  {\usebibmacro{csresume:block}\printfield{note}}%
  \usebibmacro{csresume:identifiers}%
  \usebibmacro{csresume:block}%
  \usebibmacro{addendum+pubstate}%
  \setunit{\bibpagerefpunct}\newblock
  \usebibmacro{pageref}%
  \newunit\newblock
  \iftoggle{bbx:related}
  {\usebibmacro{related:init}\usebibmacro{related}}
  {}%
  \usebibmacro{finentry}}

% Type-specific details retain native metadata while placing pages before the
% full publication date. Titles and publication details use upright type.
\newbibmacro*{csresume:article}{%
  \printfield{version}%
  \newunit
  \usebibmacro{journal}%
  \setunit{\addspace}%
  \usebibmacro{volume+number+eid}%
  \usebibmacro{csresume:comma}%
  \printfield{issue}%
  \usebibmacro{csresume:comma}%
  \usebibmacro{issue}%
  \usebibmacro{csresume:comma}%
  \printfield{pages}%
  \usebibmacro{csresume:comma}%
  \usebibmacro{date}}
\newbibmacro*{csresume:book}{%
  \printfield{edition}%
  \usebibmacro{csresume:comma}%
  \usebibmacro{csresume:volumes}%
  \usebibmacro{csresume:comma}%
  \usebibmacro{chapter+pages}%
  \usebibmacro{csresume:comma}%
  \printfield{pagetotal}%
  \usebibmacro{csresume:comma}%
  \usebibmacro{publisher+location+date}}
\newbibmacro*{csresume:collection}{%
  \ifentrytype{inbook}{\usebibmacro{bybookauthor}\newunit}{}%
  \usebibmacro{maintitle+booktitle}%
  \usebibmacro{csresume:comma}%
  \ifentrytype{inproceedings}
  {\usebibmacro{event+venue+date}}
  {\printfield{edition}}%
  \usebibmacro{csresume:comma}%
  \usebibmacro{csresume:volumes}%
  \usebibmacro{csresume:comma}%
  \ifentrytype{inproceedings}{\printlist{organization}}{}%
  \usebibmacro{csresume:comma}%
  \usebibmacro{chapter+pages}%
  \usebibmacro{csresume:comma}%
  \usebibmacro{publisher+location+date}}
\newbibmacro*{csresume:thesis}{%
  \printfield{type}%
  \usebibmacro{csresume:comma}%
  \usebibmacro{chapter+pages}%
  \usebibmacro{csresume:comma}%
  \printfield{pagetotal}%
  \usebibmacro{csresume:comma}%
  \usebibmacro{institution+location+date}}
\newbibmacro*{csresume:unpublished}{%
  \printfield{howpublished}%
  \usebibmacro{csresume:comma}%
  \printfield{type}%
  \usebibmacro{csresume:comma}%
  \usebibmacro{event+venue+date}%
  \usebibmacro{csresume:comma}%
  \printfield{note}%
  \usebibmacro{csresume:comma}%
  \usebibmacro{institution+location+date}}

\DeclareBibliographyDriver{article}{%
  \usebibmacro{csresume:entry}{author/translator+others}{title}{csresume:article}}
\DeclareBibliographyDriver{book}{%
  \usebibmacro{csresume:entry}{author/editor+others/translator+others}
  {maintitle+title}{csresume:book}}
\DeclareBibliographyDriver{inbook}{%
  \usebibmacro{csresume:entry}{author/translator+others}{title}{csresume:collection}}
\DeclareBibliographyDriver{incollection}{%
  \usebibmacro{csresume:entry}{author/translator+others}{title}{csresume:collection}}
\DeclareBibliographyDriver{inproceedings}{%
  \usebibmacro{csresume:entry}{author/translator+others}{title}{csresume:collection}}
\DeclareBibliographyDriver{thesis}{%
  \usebibmacro{csresume:entry}{author/translator+others}{title}{csresume:thesis}}
\DeclareBibliographyDriver{unpublished}{%
  \usebibmacro{csresume:entry}{author/translator+others}{title}{csresume:unpublished}}

\ExplSyntaxOn

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Publication Categories and Notes
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\seq_new:N \g__csresume_bib_categories_seq
\prop_new:N \g__csresume_bib_colours_prop
\prop_new:N \g__csresume_bib_notes_prop
\prop_new:N \g__csresume_bib_venues_prop
\bool_new:N \g__csresume_bib_notes_bool
\tl_new:N \l__csresume_bib_note_tl
\tl_new:N \l__csresume_bib_venue_tl
\cs_new_protected:Npn \__csresume_bib_label:n #1
{
  \group_begin:
  \seq_map_inline:Nn \g__csresume_bib_categories_seq
  {
    \ifcategory{##1}
    {\exp_args:Ne \color {\prop_item:Nn \g__csresume_bib_colours_prop {##1}}}
    {}
  }
  {\normalsize\texttt{[#1]}}
  \group_end:
}
\cs_generate_variant:Nn \prop_get:NnNTF {NeNTF}
\newbibmacro*{csresume:details}[1]
{
  \prop_get:NeNTF \g__csresume_bib_venues_prop {\thefield{entrykey}}
  \l__csresume_bib_venue_tl
  {\printtext{\tl_use:N \l__csresume_bib_venue_tl}}
  {\usebibmacro{#1}}
}
\cs_new_protected:Npn \__csresume_bib_note:n #1
{
  \prop_get:NeNTF \g__csresume_bib_notes_prop {\thefield{entrykey}} \l__csresume_bib_note_tl
  {\tl_use:N \l__csresume_bib_note_tl}
  {\group_begin:\restorefieldformat{note}\printtext[note]{#1}\group_end:}
}
\DeclareFieldFormat{labelnumberwidth}{\__csresume_bib_label:n {#1}}
\NewDocumentCommand{\cvpublicationcategory}{m m m}
{
  \seq_if_in:NnTF \g__csresume_bib_categories_seq {#1}
  {\seq_gremove_all:Nn \g__csresume_bib_categories_seq {#1}}
  {\DeclareBibliographyCategory{#1}}
  \addtocategory{#1}{#3}
  \seq_gput_right:Nn \g__csresume_bib_categories_seq {#1}
  \prop_gput:Nnn \g__csresume_bib_colours_prop {#1}{#2}
}
\NewDocumentCommand{\cvpublicationnote}{m +m}
{
  \bool_if:NF \g__csresume_bib_notes_bool
  {
    \savefieldformat{note}
    \DeclareFieldFormat{note}{\__csresume_bib_note:n {##1}}
    \bool_gset_true:N \g__csresume_bib_notes_bool
  }
  \prop_gput:Nnn \g__csresume_bib_notes_prop {#1}{#2}
}
\NewDocumentCommand{\cvpublicationvenue}{m +m}
{\prop_gput:Nnn \g__csresume_bib_venues_prop {#1}{#2}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Publication Numbering and Authorship
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\int_new:N \g__csresume_bib_total_int
\int_new:N \g__csresume_bib_printed_int
\AtDataInput{\int_gincr:N \g__csresume_bib_total_int}
\cs_new:Npn \__csresume_bib_number:
{
  \int_compare:nNnT
  {\g__csresume_bib_total_int-\g__csresume_bib_printed_int+1} < {10} {0}
  \int_eval:n {\g__csresume_bib_total_int-\g__csresume_bib_printed_int+1}
}
\defbibenvironment{bibliography}
{
  \list{}
  {
    \settowidth{\labelwidth}{{\normalsize\texttt{[\int_compare:nNnT
            {\g__csresume_bib_total_int} < {10} {0}
            \int_use:N \g__csresume_bib_total_int]}}}
    \setlength{\labelsep}{0.45em}
    \setlength{\leftmargin}{\labelwidth}
    \addtolength{\leftmargin}{\labelsep}
    \setlength{\itemindent}{0pt}
    \setlength{\topsep}{0pt}
    \setlength{\partopsep}{0pt}
    \setlength{\itemsep}{\bibitemsep}
    \setlength{\parsep}{\bibparsep}
    \cs_set:Npn \makelabel ##1 {##1\hfil}
  }
}
{\endlist}
{
  \int_gincr:N \g__csresume_bib_printed_int
  \item[{\printtext[labelnumberwidth]{\__csresume_bib_number:}}]
}
\cs_new_protected:Npn \__csresume_dagger:
{(\textcolor{csresumeAccent}{\textdagger})}
\NewDocumentCommand{\cvrandomized}{}
{\hyperlink{cv:authorship}{\__csresume_dagger:}}
\NewDocumentCommand{\cvauthorshiplegend}{}
{\hypertarget{cv:authorship}{\__csresume_dagger:}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Isolated Ampersand Glyph
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Select only the upright Biolinum ampersand; keep surrounding fonts unchanged.
\cs_new_protected:Npn \__csresume_ampersand:
{
  \group_begin:
  \fontencoding{T1}\fontfamily{LinuxBiolinumT-TLF}
  \fontseries{m}\fontshape{n}\selectfont
  \char_generate:nn {38}{12}
  \group_end:
}
\RenewDocumentCommand{\&}{}
{\mode_if_math:TF {\hbox{\__csresume_ampersand:}} {\__csresume_ampersand:}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Publication Name Highlighting
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tl_new:N \g__csresume_bib_given_tl
\tl_new:N \g__csresume_bib_family_tl
\NewDocumentCommand{\cvbibname}{m m}
{
  \tl_gset:Nn \g__csresume_bib_given_tl {#1}
  \tl_gset:Nn \g__csresume_bib_family_tl {#2}
}
\cs_new_eq:NN \__csresume_bib_given:n \mkbibnamegiven
\cs_new_eq:NN \__csresume_bib_family:n \mkbibnamefamily
\cs_new_protected:Npn \__csresume_bib_name:nn #1#2
{
  \str_if_eq:eeTF {\namepartgiven} {\g__csresume_bib_given_tl}
  {
    \str_if_eq:eeTF {\namepartfamily} {\g__csresume_bib_family_tl}
    {\textsc{#2}} {#1{#2}}
  }
  {#1{#2}}
}
\RenewDocumentCommand{\mkbibnamegiven}{m}
{\__csresume_bib_name:nn \__csresume_bib_given:n {#1}}
\RenewDocumentCommand{\mkbibnamefamily}{m}
{\__csresume_bib_name:nn \__csresume_bib_family:n {#1}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Contact Links
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tl_new:N \g__csresume_orcid_tl
\NewDocumentCommand{\cvorcid}{m}{\tl_gset:Nn \g__csresume_orcid_tl {#1}}
\NewDocumentCommand{\cvlink}{m m}
{\href{\tl_to_str:n {#1}}{\texttt{#2}}}
\cs_new_protected:Npn \__csresume_orcid:n #1
{\href{\tl_to_str:n {https://orcid.org/#1}}{\texttt{ORCID:}\,\nolinkurl{#1}}}
\cs_new_protected:Npn \__csresume_email:n #1
{
  \tl_if_blank:nF {#1} {\href{\tl_to_str:n {mailto:#1}}{\nolinkurl{#1}}\par}
}
\cs_new_protected:Npn \__csresume_site:n #1
{
  \tl_if_blank:nF {#1}
  {
    \regex_match:nnTF {\A https?://} {#1}
    {\href{\tl_to_str:n {#1}}{\nolinkurl{#1}}}
    {\href{\tl_to_str:n {https://#1}}{\nolinkurl{#1}}}
  }
}
\cs_new_protected:Npn \__csresume_links:nnn #1#2#3
{
  \tl_if_blank:nF {#1} {\__csresume_site:n {#1}}
  \tl_if_blank:nF {#2}
  {
    \tl_if_blank:nF {#1} {\enspace\textbullet\enspace}
    \href{\tl_to_str:n {https://scholar.google.com/citations?user=#2}}{\texttt{Scholar}}
  }
  \tl_if_blank:nF {#3}
  {
    \bool_lazy_or:nnT
    {!\tl_if_blank_p:n {#1}} {!\tl_if_blank_p:n {#2}}
    {\enspace\textbullet\enspace}
    \href{\tl_to_str:n {https://dblp.org/pid/#3}}{\texttt{DBLP}}
  }
  \tl_if_blank:VF \g__csresume_orcid_tl
  {\par\exp_args:NV \__csresume_orcid:n \g__csresume_orcid_tl}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Letterhead
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\seq_new:N \l__csresume_header_name_seq
\cs_new_protected:Npn \__csresume_header_name:n #1
{
  \group_begin:
  \seq_set_split:Nnn \l__csresume_header_name_seq {~} {#1}
  \seq_remove_all:Nn \l__csresume_header_name_seq {}
  \seq_map_indexed_inline:Nn \l__csresume_header_name_seq
  {
    \int_compare:nNnT {##1} > {1} {~}
    \bool_lazy_or:nnTF
    {\int_compare_p:nNn {##1} = {1}}
    {\int_compare_p:nNn {##1} = {\seq_count:N \l__csresume_header_name_seq}}
    {\textcolor{csresumeAccent}{\tl_head:n {##2}}\tl_tail:n {##2}}
    {##2}
  }
  \group_end:
}

\NewDocumentCommand{\cvheader}{m m m m m m m m m}
{
  \par
  \noindent
  {\HUGE\sffamily\mdseries\__csresume_header_name:n {#4}\par}
  \addvspace{0.35\baselineskip}
  \hrule height 0.4pt
  \addvspace{0.45\baselineskip}
  \noindent
  \begin{minipage}[t]{0.58\linewidth}
    \raggedright
    \tl_if_blank:nF {#5} {#5\par}
    \__csresume_email:n {#6}
    \__csresume_links:nnn {#7}{#8}{#9}
  \end{minipage}
  \hfill
  \begin{minipage}[t]{0.38\linewidth}
    \raggedleft\normalfont
    \tl_if_blank:nF {#1} {#1\par}
    \tl_if_blank:nF {#2} {#2\par}
    #3\par
  \end{minipage}
  \par
  \hypersetup{pdfauthor={#4}}
  \addvspace{0.5\baselineskip}
}

% Keep the original seven-field header API for other CVs.
\NewDocumentCommand{\contactblock}{m m m m m m m}
{\cvheader{}{}{#3}{#1}{#2}{#4}{#5}{#6}{#7}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Named Profile Fields
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tl_new:N \g__csresume_profile_address_tl
\tl_new:N \g__csresume_profile_dblp_tl
\tl_new:N \g__csresume_profile_department_tl
\tl_new:N \g__csresume_profile_email_tl
\tl_new:N \g__csresume_profile_institution_tl
\tl_new:N \g__csresume_profile_name_tl
\tl_new:N \g__csresume_profile_position_tl
\tl_new:N \g__csresume_profile_scholar_tl
\tl_new:N \g__csresume_profile_website_tl
\keys_define:nn {csresume/profile}
{
  address .tl_gset:N = \g__csresume_profile_address_tl,
  bib-family .tl_gset:N = \g__csresume_bib_family_tl,
  bib-given .tl_gset:N = \g__csresume_bib_given_tl,
  dblp .tl_gset:N = \g__csresume_profile_dblp_tl,
  department .tl_gset:N = \g__csresume_profile_department_tl,
  email .tl_gset:N = \g__csresume_profile_email_tl,
  institution .tl_gset:N = \g__csresume_profile_institution_tl,
  name .tl_gset:N = \g__csresume_profile_name_tl,
  orcid .tl_gset:N = \g__csresume_orcid_tl,
  position .tl_gset:N = \g__csresume_profile_position_tl,
  scholar .tl_gset:N = \g__csresume_profile_scholar_tl,
  website .tl_gset:N = \g__csresume_profile_website_tl
}
\msg_new:nnn {csresume}{missing-profile-name}
{Declare~a~nonempty~name~with~\token_to_str:N \cvprofile~before~\token_to_str:N \makecvheader.}
\NewDocumentCommand{\cvprofile}{m}
{\keys_set:nn {csresume/profile}{#1}}
\NewDocumentCommand{\makecvheader}{}
{
  \tl_if_blank:VTF \g__csresume_profile_name_tl
  {\msg_error:nn {csresume}{missing-profile-name}}
  {
    \use:e
    {
      \exp_not:N \cvheader
      {\exp_not:V \g__csresume_profile_institution_tl}
      {\exp_not:V \g__csresume_profile_department_tl}
      {\exp_not:V \g__csresume_profile_address_tl}
      {\exp_not:V \g__csresume_profile_name_tl}
      {\exp_not:V \g__csresume_profile_position_tl}
      {\exp_not:V \g__csresume_profile_email_tl}
      {\exp_not:V \g__csresume_profile_website_tl}
      {\exp_not:V \g__csresume_profile_scholar_tl}
      {\exp_not:V \g__csresume_profile_dblp_tl}
    }
  }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Dated Entries
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \__csresume_entry_space:n #1
{
  \par
  \addvspace{0.35\baselineskip}
  \bool_if:NF \g__csresume_allowbreaks_bool
  {\Needspace{#1\baselineskip}}
}
\cs_new_protected:Npn \__csresume_entry_heading:nn #1#2
{
  \noindent
  \begin{tabularx}{\linewidth}{@{}>{\raggedright\arraybackslash}X@{\hspace{1.2em}}r@{}}
    #1 & \cvright{#2} \\
  \end{tabularx}
  \par\nopagebreak[4]
}
\NewDocumentCommand{\cvright}{m} {{\normalfont\small #1}}
\NewDocumentCommand{\cvlabel}{m} {\textsc{#1}}
\NewDocumentCommand{\years}{m} {\par\noindent\hfill\cvright{#1}\par}
\NewDocumentCommand{\details}{m m m m}
{
  \__csresume_entry_space:n {3}
  \__csresume_entry_heading:nn
  {\textbf{#2}}
  {#1}
  \tl_if_blank:nF {#3} {#3\par\nopagebreak[4]}
  \tl_if_blank:nF {#4} {#4\par}
}
\NewDocumentCommand{\columndetails}{m m m}
{
  \par\addvspace{0.25\baselineskip}
  \bool_if:NF \g__csresume_allowbreaks_bool
