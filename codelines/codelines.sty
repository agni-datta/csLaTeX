\NeedsTeXFormat{LaTeX2e}[2022/06/01]
\ProvidesPackage{codelines}[2026/10/10 v2.0.1 Configurable pseudocode and line references]
\RequirePackage{enumitem}
\RequirePackage{xcolor}
\ExplSyntaxOn

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Configuration
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\msg_new:nnn {codelines} {invalid} {Invalid~#1:~#2.}
\msg_new:nnn {codelines} {unknown} {Unknown~option~'#1'.}
\msg_new:nnn {codelines} {depth} {Codelines~supports~at~most~10~nested~levels.}
\msg_new:nnn {codelines} {width} {Line-number~width~changed;~rerun~LaTeX~for~stable~alignment.}

\clist_map_inline:nn
{
    NumberFamily,
    NumberFace,
    NumberSize,
    NumberColor,
    BodyFamily,
    BodySize,
    BodyColor,
    CommentFace,
    CommentSize,
    CommentColor,
    CommentPrefix,
    Digits
}
{
    \tl_new:c {l_csCode#1_tl}
}

\bool_new:N \l_csCodePadding_bool
\dim_new:N \l_csCodeIndent_dim
\skip_new:N \l_csCodeCommentSpace_skip
\int_new:N \l_csCodeStart_int
\newlength{\codelineslinenrsymbolwidth}
\newlength{\codelineslinenrwidth}
\newlength{\codelineslinenrsep}
\newlength{\codelinescurrentboxwidth}
\newlength{\codelinesextraboxwidth}

\cs_new_protected:Npn \csCodeNonnegative #1#2
{
    \int_set:Nn \l_tmpa_int {#2}
    \int_compare:nNnTF {\l_tmpa_int} < {0}
        {
            \msg_error:nnnn {codelines} {invalid} {nonnegative~line~number} {#2}
        }
        {#1}
}

\cs_new_protected:Npn \csCodeDimension #1#2#3
{
    \dim_set:Nn #1 {#3}
    \dim_compare:nNnT {#1} < {0pt}
        {
            \msg_error:nnnn {codelines} {invalid} {#2~(nonnegative~dimension~required)} {#3}
        }
}

\keys_define:nn {codelines}
{
    number-family .choices:nn =
        {
            inherit,
            roman,
            sans,
            tt
        }
        {
            \tl_set_eq:NN \l_csCodeNumberFamily_tl \l_keys_choice_tl
        },
    number-face .choices:nn =
        {
            normal,
            bold,
            italic,
            bolditalic,
            smallcaps,
            tt
        }
        {
            \tl_set_eq:NN \l_csCodeNumberFace_tl \l_keys_choice_tl
        },
    number-size .choices:nn =
        {
            normal,
            tiny,
            scriptsize,
            footnotesize,
            small,
            normalsize,
            large,
            Large
        }
        {
            \tl_set_eq:NN \l_csCodeNumberSize_tl \l_keys_choice_tl
        },
    number-color .tl_set:N = \l_csCodeNumberColor_tl,
    number-digits .code:n =
        {
            \str_if_eq:nnTF {#1} {auto}
            {
                \tl_set:Nn \l_csCodeDigits_tl {auto}
            }
            {
                \regex_match:nnTF {\A[1-9][0-9]*\Z} {#1}
                {
                    \tl_set:Nn \l_csCodeDigits_tl {#1}
                }
                {
                    \msg_error:nnnn {codelines} {invalid} {number-digits} {#1}
                }
            }
        },
    number-padding .bool_set:N = \l_csCodePadding_bool,
    number-width .code:n =
        {
            \csCodeDimension \codelineslinenrwidth {number-width} {#1}
        },
    number-sep .code:n =
        {
            \csCodeDimension \codelineslinenrsep {number-sep} {#1}
        },
    indent .code:n =
        {
            \csCodeDimension \l_csCodeIndent_dim {indent} {#1}
        },
    body-family .choices:nn =
        {
            inherit,
            roman,
            sans,
            tt
        }
        {
            \tl_set_eq:NN \l_csCodeBodyFamily_tl \l_keys_choice_tl
        },
    body-size .choices:nn =
        {
            normal,
            tiny,
            scriptsize,
            footnotesize,
            small,
            normalsize,
            large,
            Large
        }
        {
            \tl_set_eq:NN \l_csCodeBodySize_tl \l_keys_choice_tl
        },
    body-color .tl_set:N = \l_csCodeBodyColor_tl,
    comment-face .choices:nn =
        {
            normal,
            italic,
            bold,
            bolditalic,
            smallcaps
        }
        {
            \tl_set_eq:NN \l_csCodeCommentFace_tl \l_keys_choice_tl
        },
    comment-size .choices:nn =
        {
            normal,
            tiny,
            scriptsize,
            footnotesize,
            small,
            normalsize,
            large,
            Large
        }
        {
            \tl_set_eq:NN \l_csCodeCommentSize_tl \l_keys_choice_tl
        },
    comment-color .tl_set:N = \l_csCodeCommentColor_tl,
    comment-prefix .tl_set:N = \l_csCodeCommentPrefix_tl,
    comment-space .skip_set:N = \l_csCodeCommentSpace_skip,
    start .code:n =
        {
            \csCodeNonnegative
            {
                \int_set:Nn \l_csCodeStart_int {#1}
            }
            {#1}
        },
    unknown .code:n =
        {
            \msg_error:nnx {codelines} {unknown} {\l_keys_key_str}
        }
}

\clist_map_inline:nn
{
    number-family,
    number-face,
    number-size,
    number-color,
    number-digits,
    number-width,
    number-sep,
    indent,
    body-family,
    body-size,
    body-color,
    comment-face,
    comment-size,
    comment-color,
    comment-prefix,
    comment-space,
    start
}
{
    \keys_define:nn {codelines}
    {
        #1 .value_required:n = true
    }
}

\keys_set:nn {codelines}
{
    number-family = tt,
    number-face = normal,
    number-size = footnotesize,
    number-color = black!50,
    number-digits = auto,
    number-padding = true,
    number-width = 0pt,
    number-sep = .5em,
    indent = 1em,
    body-family = inherit,
    body-size = normal,
    body-color = inherit,
    comment-face = italic,
    comment-size = normal,
    comment-color = black!50,
    comment-prefix = **,
    comment-space = .33333em,
    start = 1
}

\ProcessKeyOptions[codelines]

\NewDocumentCommand \CodelinesSetup {m}
{
    \keys_set:nn {codelines} {#1}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Typography
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \csCodeFamily #1
{
    \str_case:Vn #1
    {
        {roman}
        {
            \rmfamily
        }
        {sans}
        {
            \sffamily
        }
        {tt}
        {
            \ttfamily
        }
    }
}

\cs_new_protected:Npn \csCodeFace #1
{
    \str_case:Vn #1
    {
        {normal}
        {
            \mdseries
            \upshape
        }
        {bold}
        {
            \bfseries
            \upshape
        }
        {italic}
        {
            \itshape
        }
        {bolditalic}
        {
            \bfseries
            \itshape
        }
        {smallcaps}
        {
            \scshape
        }
        {tt}
        {
            \ttfamily
        }
    }
}

\cs_new_protected:Npn \csCodeSize #1
{
    \tl_if_eq:NnF #1 {normal}
    {
        \use:c {#1}
    }
}

\cs_new_protected:Npn \csCodeColor #1
{
    \tl_if_eq:NnF #1 {inherit}
    {
        \exp_args:NV \color #1
    }
}

\NewDocumentCommand \codelineslinenrformat {}
{
    \tl_if_eq:NnF \l_csCodeNumberFamily_tl {inherit}
    {
        \normalfont
    }
    \csCodeSize \l_csCodeNumberSize_tl
    \csCodeFamily \l_csCodeNumberFamily_tl
    \csCodeFace \l_csCodeNumberFace_tl
    \csCodeColor \l_csCodeNumberColor_tl
}

\NewExpandableDocumentCommand \codelineslinenrdigits {}
{
    \l_csCodeDigits_tl
}

\NewExpandableDocumentCommand \codelinesrefprefix {} {}

\int_new:N \l_csCodeDigits_int

\cs_new_protected:Npn \csCodeReadDigits
{
    \tl_set:Nx \l_tmpa_tl {\codelineslinenrdigits}
    \tl_if_eq:NnTF \l_tmpa_tl {auto}
    {
        \int_set:Nn \l_csCodeDigits_int {2}
    }
    {
        \exp_args:NnV \regex_match:nnTF {\A[1-9][0-9]*\Z} \l_tmpa_tl
        {
            \int_set:Nn \l_csCodeDigits_int {\l_tmpa_tl}
        }
        {
            \msg_error:nnnn {codelines} {invalid} {number-digits} {\l_tmpa_tl}
        }
    }
}

\NewDocumentCommand \codelinesformatnumber {m}
{
    \csCodeReadDigits
    \tl_set:Nx \l_tmpa_tl {\int_eval:n {#1}}
    \bool_if:NT \l_csCodePadding_bool
    {
        \prg_replicate:nn
        {
            \int_max:nn {0}
            {
                \l_csCodeDigits_int - \tl_count:N \l_tmpa_tl
            }
        }
        {0}
    }
    \tl_use:N \l_tmpa_tl
}

\NewDocumentCommand \codecomment {+m}
{
    \group_begin:
    \csCodeSize \l_csCodeCommentSize_tl
    \csCodeFace \l_csCodeCommentFace_tl
    \csCodeColor \l_csCodeCommentColor_tl
    \tl_use:N \l_csCodeCommentPrefix_tl
    \hskip \l_csCodeCommentSpace_skip \relax
    #1
    \group_end:
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Line Counters
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcounter{codelineslinenr}
\setcounter{codelineslinenr}{\l_csCodeStart_int}
\newcounter{csCodeLine}

\cs_set:cpn {thecsCodeLine}
{
    \codelinesrefprefix
    \arabic{codelineslinenr}
}

\cs_set:cpn {theHcsCodeLine}
{
    \arabic{csCodeLine}
}

\int_new:N \g_csCodeBlock_int
\int_new:N \l_csCodeDepth_int
\int_new:N \l_csCodeListDepth_int
\tl_new:N \l_csCodeCounter_tl
\newlist{clcode}{enumerate}{10}

\int_step_inline:nn {10}
{
    \cs_set:cpn {theHclcode\int_to_roman:n {#1}}
    {
        \arabic{csCodeLine}
    }
}

\NewDocumentCommand \codelinessetlinenr {m}
{
    \csCodeNonnegative
    {
        \setcounter{codelineslinenr}{\int_eval:n {#1}}
    }
    {#1}
}

\NewDocumentCommand \codelinesresetlinenr {}
{
    \exp_args:Nx \codelinessetlinenr
    {
        \int_use:N \l_csCodeStart_int
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Line-Number Width
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\prop_new:N \g_csCodeWidths_prop
\dim_new:N \g_csCodeMeasured_dim
\box_new:N \l_csCodeNumber_box

\cs_new_protected:Npn \csCodeRestoreWidth #1#2
{
    \prop_gput:Nnn \g_csCodeWidths_prop {#1} {#2}
}

\cs_new_protected:Npn \csCodeMeasure #1
{
    \csCodeReadDigits
    \hbox_set:Nn \l_csCodeNumber_box
    {
        \codelineslinenrformat
        \exp_args:Nx \codelinesformatnumber
        {
            \int_eval:n {#1}
        }
    }
    \dim_gset:Nn \g_csCodeMeasured_dim
    {
        \dim_max:nn {\g_csCodeMeasured_dim}
        {
            \box_wd:N \l_csCodeNumber_box
        }
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Line Items
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \csCodeItem
{
    \int_compare:nNnTF {\@listdepth} = {\l_csCodeListDepth_int}
    {
        \csCodeLineItem
    }
    {
        \csCodeOriginalItem
    }
}

\NewDocumentCommand \csCodeLineItem {o}
{
    \IfNoValueTF{#1}
    {
        \setcounter{\l_csCodeCounter_tl}
        {
            \int_eval:n {\value{codelineslinenr} - 1}
        }
        \csCodeOriginalItem
        \cs_set:cpx {thecsCodeLine}
        {
            \codelinesrefprefix
            \arabic{codelineslinenr}
        }
        \stepcounter{csCodeLine}
        \refstepcounter{csCodeLine}
        \csCodeMeasure{\value{\l_csCodeCounter_tl}}
        \setcounter{codelineslinenr}
        {
            \int_eval:n {\value{\l_csCodeCounter_tl} + 1}
        }
    }
    {
        \csCodeOriginalItem[#1]
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Codelines Environment
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \csCodeBegin #1
{
    \int_incr:N \l_csCodeDepth_int
    \int_compare:nNnT {\l_csCodeDepth_int} > {10}
        {
            \msg_error:nn {codelines} {depth}
        }
    \csCodeFamily \l_csCodeBodyFamily_tl
    \csCodeSize \l_csCodeBodySize_tl
    \csCodeColor \l_csCodeBodyColor_tl
    \int_compare:nNnT {\l_csCodeDepth_int} = {1}
    {
        \cs_set_eq:NN \csCodeOriginalItem \item
        \int_gincr:N \g_csCodeBlock_int
        \dim_gzero:N \g_csCodeMeasured_dim
        \csCodeMeasure{0}
        \hbox_set:Nn \l_csCodeNumber_box
        {
            \codelineslinenrformat 0
        }
        \dim_set:Nn \codelineslinenrsymbolwidth
        {
            \box_wd:N \l_csCodeNumber_box
        }
        \dim_gset:Nn \g_csCodeMeasured_dim
        {
            \dim_max:nn {\g_csCodeMeasured_dim}
            {
                \l_csCodeDigits_int \codelineslinenrsymbolwidth
            }
        }
        \dim_set:Nn \codelineslinenrwidth
        {
            \dim_max:nn {\codelineslinenrwidth} {\g_csCodeMeasured_dim}
        }
        \exp_args:NNx \prop_get:NnNT \g_csCodeWidths_prop
        {
            \int_use:N \g_csCodeBlock_int
        }
        \l_tmpa_tl
        {
            \dim_set:Nn \codelineslinenrwidth
            {
                \dim_max:nn {\codelineslinenrwidth} {\l_tmpa_tl}
            }
        }
    }
    \tl_if_blank:nF {#1}
    {
        \codelinessetlinenr{#1}
    }
    \setlistdepth{20}
    \tl_set:Nx \l_csCodeCounter_tl
    {
        clcode\int_to_roman:n {\l_csCodeDepth_int}
    }
    \dim_set:Nn \l_tmpa_dim
    {
        \codelineslinenrwidth + \codelineslinenrsep
    }
    \int_compare:nNnT {\l_csCodeDepth_int} > {1}
        {
            \dim_set_eq:NN \l_tmpa_dim \l_csCodeIndent_dim
        }
    \begin{clcode}[
        label =
            {
                \codelineslinenrformat
                \codelinesformatnumber{\arabic*}
            },
        ref =
            {
                \codelinesrefprefix
                \arabic*
            },
        leftmargin = \l_tmpa_dim,
        labelwidth = \codelineslinenrwidth,
        labelsep = \dimexpr \codelineslinenrsep +
        \int_eval:n {\l_csCodeDepth_int - 1} \l_csCodeIndent_dim \relax,
        itemindent = 0pt,
        labelindent = 0pt,
        topsep = 0pt,
        partopsep = 0pt,
        noitemsep,
        before = \raggedright,
        listparindent = \parindent
    ]
    \int_set:Nn \l_csCodeListDepth_int {\@listdepth}
    \cs_set_eq:NN \item \csCodeItem
}

\cs_new_protected:Npn \csCodeEnd
{
    \end{clcode}
    \int_compare:nNnT {\l_csCodeDepth_int} = {1}
    {
        \dim_compare:nNnT {\g_csCodeMeasured_dim} > {\codelineslinenrwidth + .1pt}
            {
                \msg_warning:nn {codelines} {width}
            }
        \if@filesw
            \iow_now:Nx \@auxout
            {
                \token_to_str:N \csCodeRestoreWidth
                {
                    \int_use:N \g_csCodeBlock_int
                }
                {
                    \dim_use:N \g_csCodeMeasured_dim
                }
            }
        \fi
    }
}

\NewDocumentEnvironment{codelines}{O{}}
{
    \csCodeBegin{#1}
}
{
    \csCodeEnd
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Layout Helpers
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NewDocumentCommand \codelinesbox {m +m}
{
    \parbox[t]{#1}
    {
        \setlength \codelinescurrentboxwidth {\linewidth}
        \setlength \codelinesextraboxwidth {0pt}
        \strut
        \ignorespaces #2
        \unskip
        \strut
    }
}

\NewDocumentCommand \codelinesrightalign {m}
{
    \null
    \hfill
    {#1}
    \null
}

\NewDocumentCommand \codelinescenteralign {m}
{
    \null
    \hfill
    {#1}
    \hfill
    \null
}

\NewDocumentCommand \codelinesplus {}
{
    \addtolength \itemindent {\l_csCodeIndent_dim}
    \addtolength \labelsep {\l_csCodeIndent_dim}
}

\NewDocumentCommand \codelinesminus {}
{
    \addtolength \itemindent {-\l_csCodeIndent_dim}
    \addtolength \labelsep {-\l_csCodeIndent_dim}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Reference Registration
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \csCodeRegisterCleveref
{
    \cs_if_exist:cF {cref@codeline@name}
    {
        \crefname{codeline}{line}{lines}
    }
    \cs_if_exist:cF {Cref@codeline@name}
    {
        \Crefname{codeline}{Line}{Lines}
    }
    \crefalias{csCodeLine}{codeline}
    \int_step_inline:nn {10}
    {
        \exp_args:Nx \crefalias
        {
            clcode\int_to_roman:n {##1}
        }
        {codeline}
    }
}

\cs_new_protected:Npn \csCodeRegisterZref
{
    \zcsetup
    {
        countertype =
            {
                csCodeLine = line
            }
    }
    \int_step_inline:nn {10}
    {
        \exp_args:Nx \zcsetup
        {
            countertype =
                {
                    clcode\int_to_roman:n {##1} = line
                }
        }
    }
}

\@ifpackageloaded{cleveref}
{
    \csCodeRegisterCleveref
}
{
    \AddToHook{package/cleveref/after}[codelines]
    {
        \csCodeRegisterCleveref
    }
}

\@ifpackageloaded{zref-clever}
{
    \csCodeRegisterZref
}
{
    \AddToHook{package/zref-clever/after}[codelines]
    {
        \csCodeRegisterZref
    }
}

\ExplSyntaxOff
