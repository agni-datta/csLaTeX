% Csextras
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Author: Agni Datta. https://github.com/agni-datta/csLaTeX
% Maintained work, LPPL 1.3c.
\NeedsTeXFormat{LaTeX2e}[2022/06/01]
\ProvidesPackage{csextras}[2026/10/10 v2.0 Explicit optional facilities for csLaTeX]
\ExplSyntaxOn
\msg_new:nnn {csextras} {configuration} {#1}
\cs_new_protected:Npn \csExtrasError #1
{
    \msg_fatal:nnx {csextras} {configuration} {#1}
}
\sys_if_engine_xetex:T
{
    \csExtrasError {XeLaTeX~is~not~supported.~Use~pdfLaTeX~or~LuaLaTeX.}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Options
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\prop_new:N \g_csExtrasChoices_prop
\cs_new_protected:Npn \csExtrasRecord #1#2
{
    \prop_get:NnNTF \g_csExtrasChoices_prop {#1} \l_tmpa_tl
    {
        \tl_if_eq:NnF \l_tmpa_tl {#2}
        {
            \csExtrasError
            {
                Contradictory~option~'#1':~\l_tmpa_tl ~and~#2.
            }
        }
    }
    {
        \prop_gput:Nnn \g_csExtrasChoices_prop {#1} {#2}
    }
}

\cs_new_protected:Npn \csExtrasBoolean #1#2
{
    \str_case:nnF {#2}
    {
        {true}
        {
            \csExtrasRecord {#1} {true}
            \bool_gset_true:c {g_csextras_#1_bool}
        }
        {false}
        {
            \csExtrasRecord {#1} {false}
            \bool_gset_false:c {g_csextras_#1_bool}
        }
    }
    {
        \csExtrasError {Invalid~value~'#2'~for~'#1';~use~true~or~false.}
    }
}

\cs_new_protected:Npn \csExtrasChoice #1#2#3
{
    \clist_if_in:nnTF {#3} {#2}
    {
        \csExtrasRecord {#1} {#2}
        \tl_gset:cn {g_csextras_#1_tl} {#2}
    }
    {
        \csExtrasError {Invalid~value~'#2'~for~'#1';~use~#3.}
    }
}
\clist_map_inline:nn
{
    acknowledgements,
    algorithm,
    beautify,
    bibliography,
    boxes,
    epigraph,
    exercises,
    extralists,
    extramath,
    extratables,
    figureposition,
    footnotes,
    forest,
    glossary,
    hyperrefcolors,
    hyperxmp,
    index,
    listings,
    loadmacros,
    metadata,
    minted,
    nowarning,
    numbering,
    orcid,
    pdftools,
    siunitx,
    tcscrypto,
    tikz,
    tocbibind,
    verbatim,
    watermark,
    zcref,
    abstract,
    amsaddr,
    informalheaders,
    titlepage,
    tocspacing,
    chapterabstract,
    lettrine,
    algorithmtwoe,
    crazybib,
    crazynumbering,
    indentfirst,
    nagmode,
    parskip,
    tightcaptions,
    todonotes
}
{
    \bool_new:c {g_csextras_#1_bool}
    \keys_define:nn {csextras}
    {
        #1 .code:n =
            {
                \csExtrasBoolean {#1} {##1}
            },
        #1 .default:n = true
    }
}

\tl_new:N \g_csextras_copyright_tl
\tl_new:N \g_csextras_lipsum_tl
\tl_new:N \g_csextras_references_tl
\tl_new:N \g_csextras_layout_tl
\tl_gset:Nn \g_csextras_copyright_tl {none}
\tl_gset:Nn \g_csextras_lipsum_tl {none}
\tl_gset:Nn \g_csextras_references_tl {none}
\tl_gset:Nn \g_csextras_layout_tl {none}
\keys_define:nn {csextras}
{
    copyright .code:n =
        {
            \csExtrasChoice {copyright} {#1}
            {
                none,
                footnote,
                page
            }
        },
    copyright .value_required:n = true,
    lipsum .code:n =
        {
            \csExtrasChoice {lipsum} {#1}
            {
                none,
                paragraph,
                content
            }
        },
    lipsum .value_required:n = true,
    references .code:n =
        {
            \csExtrasChoice {references} {#1}
            {
                none,
                hyperref,
                cleveref,
                zref,
                both
            }
        },
    references .value_required:n = true,
    layout .code:n =
        {
            \str_case:nnF {#1}
            {
                {true}
                {
                    \csExtrasChoice {layout} {balanced}
                    {
                        none,
                        balanced,
                        legacy
                    }
                }
                {false}
                {
                    \csExtrasChoice {layout} {none}
                    {
                        none,
                        balanced,
                        legacy
                    }
                }
            }
            {
                \csExtrasChoice {layout} {#1}
                {
                    none,
                    balanced,
                    legacy
                }
            }
        },
    layout .default:n = balanced,
    unknown .code:n =
        {
            \csExtrasError
            {
                Unknown~option~'\l_keys_key_str '.
            }
        }
}
\ProcessKeyOptions [csextras]
\bool_if:NT \g_csextras_nowarning_bool
{
    \PackageWarningNoLine {csextras} {nowarning~is~obsolete;~normal~diagnostics~remain~enabled}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Foundation Configuration
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tl_new:N \g_csextras_mode_tl
\cs_new_protected:Npn \csExtrasDetectMathMode
{
    \tl_gset:Nn \g_csextras_mode_tl {standalone}
    \@ifpackageloaded {csmath}
    {
        \tl_gset:Nx \g_csextras_mode_tl
        {
            \CsmathConfiguration {mode}
        }
    }
    {
        \@ifclassloaded {llncs}
        {
            \tl_gset:Nn \g_csextras_mode_tl {venue}
        } {}
    }
}
\csExtrasDetectMathMode
\cs_new_protected:Npn \csExtrasRequireArticle #1#2
{
    \exp_args:NnV \clist_if_in:nnTF
    {
        article,
        manuscript
    } \g_csextras_mode_tl {#2}
    {
        \csExtrasError {Feature~'#1'~requires~preloaded~csmath~in~article~or~manuscript~mode.}
    }
}

\cs_new_protected:Npn \csExtrasRequireBook #1#2
{
    \tl_if_eq:NnTF \g_csextras_mode_tl {book}
    {
        \cs_if_exist:NTF \chapter {#2}
         {
          \csExtrasError {Feature~'#1'~requires~chapter~support.}
         }
    }
    {
        \csExtrasError {Feature~'#1'~requires~preloaded~csmath~in~book~mode.}
    }
}

\cs_new_protected:Npn \csExtrasRequireFree #1
{
    \cs_if_exist:cT {#1}
    {
        \csExtrasError {Interface~'#1'~is~already~owned;~remove~the~conflicting~feature.}
    }
}

\cs_new_protected:Npn \csExtrasNote #1#2
{
    \PackageInfo {csextras} {Explicit~feature~'#1':~#2}
}

\cs_new_protected:Npn \csExtrasValidatePublisherMode
{
    \tl_if_eq:NnT \g_csextras_mode_tl {venue}
    {
        \tl_if_eq:NnF \g_csextras_layout_tl {none}
        {
            \csExtrasError {Feature~'layout'~conflicts~with~inherited~venue~formatting.}
        }
        \clist_map_inline:nn
        {
            beautify,
            figureposition,
            footnotes,
            informalheaders,
            titlepage,
            tocspacing,
            numbering,
            crazynumbering,
            tightcaptions,
            parskip,
            indentfirst,
            tocbibind,
            abstract,
            epigraph
        }
        {
            \bool_if:cT {g_csextras_##1_bool}
            {
                \csExtrasError {Feature~'##1'~conflicts~with~inherited~venue~formatting.}
            }
        }
    }
}
\csExtrasValidatePublisherMode
\AddToHook {package/csmath/after} [csextras]
{
    \csExtrasDetectMathMode \csExtrasValidatePublisherMode
}
\@ifpackageloaded {csmath} {}
{
    \bool_if:nT
    {
        \g_csextras_index_bool ||\g_csextras_metadata_bool ||\g_csextras_exercises_bool ||\g_csextras_todonotes_bool
    }
    {
        \AddToHook {package/csmath/before} [csextras]
        {
            \csExtrasError {Load~csmath~before~csextras~when~using~index,~metadata,~exercises,~or~todonotes;~providers~must~be~resolved~first.}
        }
    }
}
\bool_if:nT
{
    \g_csextras_algorithm_bool &&\g_csextras_algorithmtwoe_bool
}
{
    \csExtrasError {algorithm~and~algorithmtwoe~select~conflicting~float~providers.}
}
\bool_if:nT
{
    \g_csextras_numbering_bool &&\g_csextras_crazynumbering_bool
}
{
    \csExtrasError {numbering~and~crazynumbering~select~conflicting~depths.}
}
\bool_if:nT
{
    \g_csextras_bibliography_bool ||\g_csextras_crazybib_bool
}
{
    \cs_new_protected:Npn \csExtrasValidateBibliography
    {
        \csExtrasError {Selected~bibliography/crazybib~features~require~BibTeX~and~conflict~with~biblatex.}
    }
    \@ifpackageloaded {biblatex} {\csExtrasValidateBibliography} {}
    \AddToHook {package/biblatex/before} [csextras] {\csExtrasValidateBibliography}
}

