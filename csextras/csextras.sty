%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% References
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_if:NT \g_csextras_zcref_bool
{
    \prop_get:NnNT \g_csExtrasChoices_prop {references} \l_tmpa_tl
    {
        \tl_if_eq:NnT \l_tmpa_tl {none}
        {
            \csExtrasError {zcref~conflicts~with~references=none.}
        }
    }
    \str_case:Vn \g_csextras_references_tl
    {
        {none}
        {
            \tl_gset:Nn \g_csextras_references_tl {zref}
        }
        {hyperref}
        {
            \tl_gset:Nn \g_csextras_references_tl {zref}
        }
        {cleveref}
        {
            \tl_gset:Nn \g_csextras_references_tl {both}
        }
    }
}

\cs_new_protected:Npn \csExtrasLoadHyperref
{
    \@ifpackageloaded {hyperref} {}
    {
        \RequirePackage {hyperref}
    }
}
\tl_if_eq:NnF \g_csextras_references_tl {none} {\csExtrasLoadHyperref}
\bool_if:nT
{
    \g_csextras_hyperxmp_bool ||\g_csextras_metadata_bool ||\g_csextras_hyperrefcolors_bool
}
{\csExtrasLoadHyperref}
\bool_if:NT \g_csextras_hyperxmp_bool
{
    \cs_if_exist:NT \IfDocumentMetadataTF
    {
        \IfDocumentMetadataTF
        {
            \csExtrasError {hyperxmp~conflicts~with~DocumentMetadata;~use~native~PDF~metadata~instead.}
        } {}
    }
    \RequirePackage {hyperxmp}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% TCS Notation
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_if:NT \g_csextras_tcscrypto_bool
{
    \tl_if_eq:NnTF \g_csextras_mode_tl {venue}
    {
        \RequirePackage [notoc] {tcscrypto}
    }
    {
        \RequirePackage {tcscrypto}
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% TikZ
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_if:NT \g_csextras_tikz_bool
{
    \ExplSyntaxOff
    \RequirePackage {tikz}
    \RequirePackage {tikz-cd}
    \RequirePackage {tikzscale}
    \RequirePackage {pgfplots}
    \pgfplotsset {compat = 1.18}
    \usetikzlibrary
    {
        arrows.meta,
        calc,
        decorations.markings,
        decorations.pathmorphing,
        fit,
        intersections,
        matrix,
        patterns,
        patterns.meta,
        positioning,
        shadows,
        shapes.geometric,
        tikzmark,
        trees
    }
    \ExplSyntaxOn
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Algorithms
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_if:NT \g_csextras_algorithm_bool
{
    \csExtrasRequireFree {algorithm}
    \RequirePackage
    {
        newfloat,
        codelines
    }
    \DeclareFloatingEnvironment [fileext = loa,
        listname = {List~of~Algorithms},
        name = Algorithm,
        placement = !hbt] {algorithm}
    \cs_new_protected:Npn \csExtrasRegisterReferences
    {
        \cs_if_exist:cF {cref@algorithm@name}
        {
            \crefname {algorithm} {algorithm} {algorithms}
        }
        \cs_if_exist:cF {Cref@algorithm@name}
        {
            \Crefname {algorithm} {Algorithm} {Algorithms}
        }
    }
    \@ifpackageloaded {cleveref} {\csExtrasRegisterReferences}
    {
        \AddToHook {package/cleveref/after} [csextras] {\csExtrasRegisterReferences}
    }
    \cs_new_protected:Npn \csExtrasRegisterZref
    {
        \zcsetup
        {
            countertype = {algorithm = algorithm}
        }
    }
    \@ifpackageloaded {zref-clever} {\csExtrasRegisterZref}
    {
        \AddToHook {package/zref-clever/after} [csextras] {\csExtrasRegisterZref}
    }
    \AddToHook {package/algorithm2e/before} [csextras]
    {
        \csExtrasError {algorithm2e~conflicts~with~the~csextras~algorithm~float.}
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Layout
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tl_if_eq:NnF \g_csextras_layout_tl {none}
{
    \@ifpackageloaded {geometry}
    {
        \csExtrasError {layout~would~overwrite~existing~geometry;~configure~that~provider~directly.}
    }
    {
        \RequirePackage [margin = 1in] {geometry}
    }
    \linespread {1.05}
    \tl_if_eq:NnT \g_csextras_layout_tl {legacy}
    {
        \setlength \emergencystretch {2em}
        \interfootnotelinepenalty = 10000
        \@ifpackageloaded {amsmath} {\allowdisplaybreaks} {}
        \AddToHook {package/amsmath/after} [csextras] {\allowdisplaybreaks}
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Footnotes
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_if:NT \g_csextras_footnotes_bool
{
    \RequirePackage {bigfoot}
    \RequirePackage {footnote}
    \RequirePackage
    [
        bottom,
        multiple,
        hang
    ] {footmisc}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% ORCID
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_if:NT \g_csextras_orcid_bool
{
    \RequirePackage {orcidlink}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Paragraph Headings
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_if:NT \g_csextras_informalheaders_bool
{
    \csExtrasRequireArticle {informalheaders}
    {
        \RequirePackage {titlesec}
        \titleformat {\section}
        {
            \normalfont \Large \sffamily \color {accentcolor}
        }
        {\thesection} {0.75em} {}
        \titleformat {\subsection}
        {
            \normalfont \large \sffamily \color {accentcolor}
        }
        {\thesubsection} {0.65em} {}
        \titleformat {\subsubsection}[runin]
        {
            \normalfont \sffamily \color {accentcolor}
        }
        {\thesubsubsection} {0.55em} {}[.]
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Caption Colors
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_if:NT \g_csextras_beautify_bool
{
    \@ifpackageloaded {caption}
    {
        \captionsetup
        {
            labelfont =
                {
                    color = figurecolor,
                    small,
                    bf
                }
        }
    }
    {
        \csExtrasError {beautify~requires~a~preloaded~caption~provider;~select~csmath~caption~first.}
    }
}
\bool_if:NT \g_csextras_hyperrefcolors_bool
{
    \hypersetup
    {
        citecolor = accentcolor,
        linkcolor = accentcolor,
        urlcolor = accentcolor
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Figure Placement
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_if:NT \g_csextras_figureposition_bool
{
    \renewcommand {\topfraction} {0.92}
    \renewcommand {\bottomfraction} {0.82}
    \renewcommand {\textfraction} {0.06}
    \renewcommand {\floatpagefraction} {0.78}
    \setcounter {topnumber} {3}
    \setcounter {bottomnumber} {2}
    \setcounter {totalnumber} {4}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Numbering
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_if:NT \g_csextras_numbering_bool
{
    \setcounter {secnumdepth} {3}
    \setcounter {tocdepth} {2}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Boxes
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_if:NT \g_csextras_boxes_bool
{
    \clist_map_inline:nn
    {
        openproblemframe,
        questionbox,
        proofbox,
        diagramframe,
        figurebox
    }
    {
        \csExtrasRequireFree {#1}
    }
    \RequirePackage {mdframed}
    \mdfdefinestyle {csExtrasBox}
    {
        innertopmargin = 7.5pt,
        innerbottommargin = 7.5pt,
        innerleftmargin = 7.5pt,
        innerrightmargin = 7.5pt,
        linewidth = 0.5pt,
        nobreak = true,
        roundcorner = 0pt,
        skipabove = 0.75\baselineskip ,
        skipbelow = 0.75\baselineskip ,
    }
    \newmdenv
    [style = csExtrasBox,
        linecolor = accentcolor!30,
        backgroundcolor = accentcolor!5,
    ] {openproblemframe}
    \newmdenv
    [style = csExtrasBox,
        linecolor = accentcolor!30,
        backgroundcolor = accentcolor!5,
    ] {questionbox}
    \newmdenv
    [style = csExtrasBox,
        linecolor = accentcolor!30,
        backgroundcolor = accentcolor!5,
    ] {proofbox}
    \newmdenv
    [style = csExtrasBox,
        linecolor = diagramborder,
        backgroundcolor = diagrambackground!15,
    ] {diagramframe}
    \newmdenv
    [style = csExtrasBox,
        linecolor = diagramborder!50,
        backgroundcolor = white,
    ] {figurebox}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Title Page
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_if:NT \g_csextras_titlepage_bool
{
    \csExtrasRequireArticle {titlepage}
    {
        \@ifpackageloaded {cslecture}
        {
            \csExtrasError {titlepage~conflicts~with~cslecture~title~ownership;~select~its~title~option.}
        } {}
        \RequirePackage {titling}
        \RequirePackage {authblk}
        \RenewDocumentCommand \Authfont {}
        {
            \normalfont \large \sffamily \color {accentcolor}
        }
        \RenewDocumentCommand \Affilfont {}
        {
            \normalfont \small \sffamily \color {accentcolor!70}
        }
        \pretitle
        {
            \begin {flushleft}
            \normalfont \LARGE \sffamily \color {accentcolor}
        }
        \posttitle
        {
            \par
            \end {flushleft}
            \vspace
            {
                -0.35\baselineskip
            }
        }
        \preauthor
        {
            \begin {flushleft}
            \normalfont \Large \sffamily \color {accentcolor!60}
        }
        \postauthor
        {
            \par
            \end {flushleft}
            \vspace
            {
                -0.25\baselineskip
            }
        }
        \predate
        {
            \begin {flushleft}
            \normalfont \small \sffamily
        }
        \postdate
        {
            \par
            \end {flushleft}
        }
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Epigraphs
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_if:NT \g_csextras_epigraph_bool
{
    \RequirePackage {epigraph}
    \renewcommand {\epigraphflush} {flushright}
    \renewcommand {\textflush} {flushright}
    \renewcommand {\sourceflush} {flushright}
    \let \csExtrasSavedEpigraph \epigraph
    \RenewDocumentCommand \epigraph {mm}
    {
        \csExtrasSavedEpigraph
        {
            \normalsize \sffamily #1
        }
        {
            \medskip \footnotesize \scshape #2
        }
    }
    \RenewDocumentEnvironment {quotation} {}
    {
        \par
        \vspace
        {
            0.35\baselineskip
        }
        \begin {center}
        \begin {minipage}
        {
            0.78\linewidth
        }
        \centering \small \itshape \color {accentcolor}
        {
            \Large \color {accentcolor}
            \textquotedblleft
        }
        \hspace {0.12em}
        \ignorespaces
    }
    {
        \hspace {0.08em}
        {
            \Large \color {accentcolor}
            \textquotedblright
        }
        \end {minipage}
        \end {center}
        \vspace
        {
            0.15\baselineskip
        }
    }
    \NewDocumentEnvironment {dedication} {mm}
    {
        \def \csExtrasDedicationFirst {#1}
        \def \csExtrasDedicationLast {#2}
        \clearpage
        \thispagestyle {empty}
        \vspace * {\fill}
        \begin {center}
        \itshape \ignorespaces
    }
    {
        \par
        \smallskip
        {
            \normalfont \scshape \csExtrasDedicationFirst ~
            {
                \large \csExtrasDedicationLast
            }
        }
        \end {center}
        \vspace * {\fill}
        \clearpage
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Abstracts
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_if:NT \g_csextras_abstract_bool
{
    \csExtrasRequireArticle {abstract}
    {
        \RenewDocumentEnvironment {abstract} {}
        {
            \small
            \addcontentsline {toc} {section} {Abstract}
            \parhead {Abstract.}~~\ignorespaces
        }
        {\par
        }
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Chapter Abstracts
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_if:NT \g_csextras_chapterabstract_bool
{
    \csExtrasRequireBook {chapterabstract}
    {
        \NewDocumentEnvironment {chapterabstract} {}
        {
            \begin {quotation}
            \noindent \textbf {Chapter~Abstract.}
            \enspace \ignorespaces
        }
        {
            \end {quotation}
            \addcontentsline {toc} {section} {Chapter~Abstract}
        }
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Acknowledgments
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_if:NT \g_csextras_acknowledgements_bool
{
    \ProvideDocumentEnvironment {acknowledgements} {}
    {
        \cs_if_exist:NTF \chapter
         {
          \chapter * {Acknowledgements}
          \addcontentsline {toc} {chapter} {Acknowledgements}
         }
         {
          \par
          \bigskip
          \cs_if_exist:NTF \parhead
          {
              \parhead {Acknowledgements}
          }
          {
              \noindent \textbf {Acknowledgements.}
              \enspace
          }
          \ignorespaces
         }
    }
    {\par
    }
