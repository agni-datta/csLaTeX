\providecolor {accentcolor} {RGB} {54,100,139}
\providecolor {bordercolor} {RGB} {54,100,139}
\providecolor {figurecolor} {RGB} {139,58,58}
\providecolor {backgroundcolor} {RGB} {202,225,255}
