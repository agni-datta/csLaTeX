\bool_new:N \g_csExtrasTheoremReferences_bool
\cs_new_protected:Npn \csExtrasTheoremReferenceName #1#2#3
{
    \zcsetup
    {
        countertype = {#1 = #1}
    }
    \use:e
    {
        \exp_not:N \zcLanguageSetup {english}
        {
            type = {#1},
            name-sg =
                {
                    \str_lowercase:n {#2}
                },
            name-pl =
                {
                    \str_lowercase:n {#3}
                },
            Name-sg = {#2},
            Name-pl = {#3}
        }
    }
}

\cs_new_protected:Npn \csExtrasRegisterTheoremReferences
{
    \bool_if:NF \g_csExtrasTheoremReferences_bool
    {
        \cs_if_exist:NT \CsthmMapFamilies
        {
            \@ifpackageloaded {zref-clever}
            {
                \CsthmMapFamilies \csExtrasTheoremReferenceName
                \bool_gset_true:N \g_csExtrasTheoremReferences_bool
            } {}
        }
    }
}
\csExtrasRegisterTheoremReferences
\AddToHook {package/csthm/after} [csextras] {\csExtrasRegisterTheoremReferences}
\AddToHook {package/zref-clever/after} [csextras] {\csExtrasRegisterTheoremReferences}
