	commentary/Commentary,exercise/Exercise,motivation/Motivation,
	notationabuse/Notation Abuse,note/Note,openproblem/Open Problem,question/Question,remark/Remark
}
\cslc@newtheoremfamily{\sffamily}{\normalfont\sffamily}{
