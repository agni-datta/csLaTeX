%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Options
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\prop_new:N \g_csLectureChoices_prop
\prop_new:N \g_csLectureMath_prop
\cs_new_protected:Npn \csLectureSelect #1#2
{
    \prop_get:NnNTF \g_csLectureChoices_prop {#1} \l_tmpa_tl
    {
        \tl_if_eq:NnF \l_tmpa_tl {#2}
        {
            \PackageError {cslecture} {Contradictory~#1~selections} {Select~one~value~for~#1.}
        }
    }
    {
        \prop_gput:Nnn \g_csLectureChoices_prop {#1} {#2}
    }
}

\cs_new_protected:Npn \csLectureDefault #1#2
{
    \prop_if_in:NnF \g_csLectureChoices_prop {#1}
    {
        \prop_gput:Nnn \g_csLectureChoices_prop {#1} {#2}
    }
}
\prg_new_conditional:Npnn \csLectureIf:nn #1#2
{
    T,
    F,
    TF
}
{
    \str_if_eq:eeTF
    {
        \prop_item:Nn \g_csLectureChoices_prop {#1}
    } {#2}
    {\prg_return_true:} {\prg_return_false:}
}

\cs_new_protected:Npn \csLectureChoiceKey #1#2
{
    \keys_define:nn {cslecture}
    {
        #1 .choices:nn = {#2}
            {
                \exp_args:NnV \csLectureSelect {#1} \l_keys_choice_tl
            },
        #1 .value_required:n = true
    }
}
\csLectureChoiceKey {mode}
{
    single,
    series,
    scribe
}
\csLectureChoiceKey {font}
{
    inherit,
    baskervaldx,
    concrete,
    garamond,
    gfsdidot,
    kpfonts,
    latinmodern,
    libertine,
    palatino,
}
\csLectureChoiceKey {font-policy}
{
    compatible,
    strict
}
\csLectureChoiceKey {theorems}
{
    normal,
    fancy,
    oldschool,
    none,
    inherit
}
\csLectureChoiceKey {numberwithin}
{
    section,
    chapter,
    none
}
\csLectureChoiceKey {equations}
{
    inherit,
    section,
    chapter,
    none
}
\csLectureChoiceKey {paragraphs}
{
    runin,
    inherit
}
\csLectureChoiceKey {counters}
{
    independent,
    shared
}
\csLectureChoiceKey {families}
{
    standard,
    extended
}
\csLectureChoiceKey {solution}
{
    theorem,
    proof
}
\csLectureChoiceKey {title}
{
    lecture,
    boxed,
    course,
    scribe,
    inherit
}
\csLectureChoiceKey {chapters}
{
    native,
    boxed
}
\csLectureChoiceKey {headers}
{
    inherit,
    course
}
\csLectureChoiceKey {references}
{
    none,
    hyperref,
    cleveref,
    zref,
    both
}
\clist_map_inline:nn
{
    layout,
    lists,
    boxes,
    graphics,
    table,
    caption,
    float,
    index,
    annotations,
    microtype,
    quotes,
    diagrams,
    scribe,
    draft
}
{
    \keys_define:nn {cslecture}
    {
        #1 .choices:nn =
            {
                true,
                false
            }
            {
                \exp_args:NnV \csLectureSelect {#1} \l_keys_choice_tl
            },
        #1 .default:n = true
    }
}
\keys_define:nn {cslecture}
{
    final .code:n =
        {
            \csLectureSelect {draft} {false}
        },
    final .value_forbidden:n = true,
    family-style .code:n =
        {
            \csLectureSelect {family-style} {#1}
        },
    family-style .value_required:n = true,
    references .default:n = cleveref,
    title .default:n = lecture
}
\ProcessKeyOptions [cslecture]
\csLectureDefault {mode} {single}
\csLectureIf:nnT {scribe} {true}
{
    \csLectureDefault {title} {scribe}
}
\csLectureIf:nnTF {mode} {series}
{
    \csLectureDefault {title} {course}
}
{
    \csLectureIf:nnTF {mode} {scribe}
    {
        \csLectureDefault {title} {scribe}
        \csLectureDefault {scribe} {true}
    }
    {
        \csLectureDefault {title} {lecture}
    }
}
\csLectureDefault {chapters} {native} \csLectureDefault {headers} {inherit}
\csLectureDefault {references} {none}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Class Compatibility
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_new:N \l_csLectureSupported_bool
\clist_map_inline:nn
{
    article,
    book,
    report,
    amsart,
    amsbook,
    scrartcl,
    scrbook,
    scrreprt
}
{
    \@ifclassloaded {#1}
    {
        \bool_set_true:N \l_csLectureSupported_bool
    } {}
}

\clist_map_inline:nn
{
    llncs,
    beamer
}
{
    \@ifclassloaded {#1}
    {
        \bool_set_false:N \l_csLectureSupported_bool
    } {}
}
\bool_if:NF \l_csLectureSupported_bool
{
    \PackageError {cslecture} {Unsupported~document~class} {Use~article,~book,~report,~an~AMS~or~KOMA~equivalent.}
}
\csLectureIf:nnTF {mode} {series}
{
    \cs_if_exist:NF \chapter
     {
      \PackageError {cslecture} {Series~mode~requires~chapters} {Use~a~book~or~report~class.}
     }
    \prop_gput:Nnn \g_csLectureMath_prop {mode} {book}
}
{
    \cs_if_exist:NT \chapter
     {
      \PackageError {cslecture} {Chapter~classes~require~mode=series} {Use~mode=series,scribe~for~scribe~notes~in~a~book.}
     }
    \prop_gput:Nnn \g_csLectureMath_prop {mode} {article}
}
\csLectureIf:nnF {mode} {series}
{
    \csLectureIf:nnT {chapters} {boxed}
    {
        \PackageError {cslecture} {Boxed~chapters~require~series~mode} {Use~mode=series.}
    }
    \csLectureIf:nnT {headers} {course}
    {
        \PackageError {cslecture} {Course~headers~require~series~mode} {Use~mode=series.}
    }
}
\clist_map_inline:nn
{
    font,
    font-policy,
    theorems,
    numberwithin,
    equations,
    paragraphs,
    counters,
    families,
    solution,
    family-style,
    lists,
    boxes,
    graphics,
    table,
    caption,
    float,
    index,
    annotations,
    microtype,
    quotes,
    draft
}
{
    \prop_get:NnNT \g_csLectureChoices_prop {#1} \l_tmpa_tl
    {
        \prop_gput:NnV \g_csLectureMath_prop {#1} \l_tmpa_tl
    }
}
\tl_new:N \g_csLectureMathOptions_tl
\cs_new_protected:Npn \csLectureBuildMathOptions
{
    \tl_gclear:N \g_csLectureMathOptions_tl
    \prop_map_inline:Nn \g_csLectureMath_prop
    {
        \tl_gput_right:Nn \g_csLectureMathOptions_tl
        {
            ##1 = {##2},
        }
    }
}
\@ifpackageloaded {csmath}
{
    \cs_if_exist:NF \CsmathCheckConfiguration
    {
        \PackageError {cslecture} {Preloaded~csmath~is~too~old} {Use~csmath~1.2~or~newer.}
    }
    \csLectureIf:nnT {theorems} {inherit}
    {
        \prop_gremove:Nn \g_csLectureMath_prop {theorems}
    }
    \csLectureBuildMathOptions
    \exp_args:NV \CsmathCheckConfiguration \g_csLectureMathOptions_tl

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Foundation Loading
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

    \str_if_eq:eeT
    {
        \CsmathConfiguration {layout}
    } {true}
    {
        \csLectureIf:nnF {title} {inherit}
        {
            \PackageError {cslecture} {Preloaded~csmath~layout~owns~the~title} {Use~title=inherit,chapters=native,headers=inherit.}
        }
        \csLectureIf:nnF {chapters} {native}
        {
            \PackageError {cslecture} {Preloaded~csmath~layout~owns~chapters} {Use~chapters=native.}
        }
        \csLectureIf:nnF {headers} {inherit}
        {
            \PackageError {cslecture} {Preloaded~csmath~layout~owns~headers} {Use~headers=inherit.}
        }
        \csLectureIf:nnT {layout} {true}
        {
            \PackageError {cslecture} {Preloaded~csmath~layout~already~initialized} {Omit~the~lecture~layout~option.}
        }
    }
}
{
    \@ifpackageloaded {csthm} {}
    {
        \prop_gput:Nnn \g_csLectureMath_prop {cleveref} {false}
    }
    \csLectureBuildMathOptions
    \exp_args:NV \PassOptionsToPackage \g_csLectureMathOptions_tl {csmath}
    \RequirePackage {csmath} [2026/10/09]
}
\@ifpackageloaded {csthm}
{
    \cs_if_exist:NF \CsthmMapFamilies
    {
        \PackageError {cslecture} {The~loaded~csthm~is~too~old} {Use~csthm~4.2~or~newer.}
    }
    \CsthmUseHeadingTargets
} {}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Lecture Metadata and Titles
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\prop_new:N \g_csLectureMetadata_prop
\clist_map_inline:nn
{
    course,
    coursetitle,
    lecturer,
    scribe,
    lecturenumber,
    lecturetitle,
    lecturedate,
    lectureterm,
    lectureinstitution
}
{
    \exp_args:Nc \NewDocumentCommand {#1} {m}
    {
        \prop_put:Nnn \g_csLectureMetadata_prop {#1} {##1}
    }
}

\cs_new:Npn \csLectureMeta #1
{
    \prop_item:Nn \g_csLectureMetadata_prop {#1}
}

\cs_new_protected:Npn \csLectureField #1#2
{
    \prop_get:NnNT \g_csLectureMetadata_prop {#1} \l_tmpa_tl
    {
        \tl_if_blank:VF \l_tmpa_tl
        {
            \noindent \textbf {#2:}~\tl_use:N \l_tmpa_tl\par
        }
    }
}

\cs_new_protected:Npn \csLectureCourse
{
    \prop_if_in:NnTF \g_csLectureMetadata_prop {coursetitle}
    {
        \csLectureMeta {coursetitle}
    }
    {
        \csLectureMeta {course}
    }
}

\cs_new_protected:Npn \csLectureTitleText
{
    \prop_if_in:NnTF \g_csLectureMetadata_prop {lecturetitle}
    {
        \csLectureMeta {lecturetitle}
    }
    {
        \tl_if_blank:VTF \@title {\csLectureCourse}
        {
            \tl_if_in:NnTF \@title {\@latex@error} {\csLectureCourse} {\@title}
        }
    }
}

\cs_new_protected:Npn \csLectureAuthor
{
    \tl_if_in:NnF \@author {\@latex@warning@no@line}
    {
        \tl_if_blank:VF \@author
        {
            \noindent \@author\par
        }
    }
}

\cs_new_protected:Npn \csLectureCompactTitle
{
    \par
    \noindent
    {
        \large \scshape \csLectureCourse\par
    }
    \smallskip
    \noindent
    {
        \Large \bfseries
        \prop_get:NnNT \g_csLectureMetadata_prop {lecturenumber} \l_tmpa_tl
        {
            \tl_if_blank:VF \l_tmpa_tl
            {
                Lecture~\l_tmpa_tl \enspace
            }
        }
        \csLectureTitleText\par
    }
    \medskip
    \csLectureAuthor
    \csLectureField {lecturer} {Lecturer}
    \csLectureField {scribe} {Scribe}
    \csLectureField {lecturedate} {Date}
    \csLectureField {lectureterm} {Term}
    \csLectureField {lectureinstitution} {Institution}
    \medskip
}

\cs_new_protected:Npn \csLectureSingleTitle
{
    \noindent
    {
        \Large \bfseries \csLectureTitleText\par
    }
    \medskip
    \csLectureAuthor
    \tl_if_blank:VF \@date
    {
        \noindent \@date\par
    }
    \csLectureField {lecturer} {Lecturer}
    \csLectureField {course} {Course}
    \csLectureField {scribe} {Scribe}
    \csLectureField {lecturedate} {Lecture~date}
    \csLectureField {lectureterm} {Term}
    \csLectureField {lectureinstitution} {Institution}
}

\cs_new_protected:Npn \csLectureCourseTitle
{
    \@ifpackageloaded {hyperref}
    {
        \hypersetup {pageanchor = false}
    } {}
    \begin {titlepage}
    \thispagestyle {empty}
    \centering
    \noindent \rule {\linewidth} {1pt}
    \par
    \vspace {2.5cm}
    {
        \normalsize \scshape Lecture~Notes~on\par
    }
    \vspace {.75cm}
    {
        \Huge \scshape \csLectureCourse\par
    }
    \vspace {2.5cm}
    \tl_if_in:NnF \@author {\@latex@warning@no@line}
    {
        \tl_if_blank:VF \@author
        {
            {
                \normalsize \itshape by\par
            }
            \vspace {.5cm}
            {
                \Large \scshape \csLectureAuthor
            }
        }
    }
    \csLectureField {lecturer} {Lecturer}
    \csLectureField {lectureterm} {Term}
    \csLectureField {lectureinstitution} {Institution}
    \vfill
    {
        \normalsize \scshape \@date\par
    }
    \vspace {1.5cm}
    \noindent \rule {\linewidth} {1pt}
    \par
    \end {titlepage}
    \cleardoublepage
}

\NewDocumentCommand \makelecturetitle {}
{
    \begingroup
    \cs_set:Npn \and
    {
        \par
        \medskip
    }
    \csLectureCompactTitle \endgroup
}
\csLectureIf:nnF {title} {inherit}
{
    \RenewDocumentCommand \maketitle {}
    {
        \begingroup
        \cs_set:Npn \and
        {
            \par
            \medskip
        }
        \exp_args:Ne \str_case:nn
        {
            \prop_item:Nn \g_csLectureChoices_prop {title}
        }
        {
            {course} {\csLectureCourseTitle}
            {scribe} {\csLectureCompactTitle}
            {lecture}
            {
                \par
                \noindent \rule {\linewidth} {.4pt}
                \par
                \smallskip
                \csLectureSingleTitle \smallskip \noindent \rule {\linewidth} {.4pt}
                \par
                \bigskip
            }
            {boxed}
            {
                \par
                \noindent \fboxsep = 12pt\fboxrule = 1pt
                \fcolorbox {black} {gray!1}
                {
                    \begin {minipage}
                    {
                        \dimexpr \linewidth -2\fboxsep -2\fboxrule \relax
                    }
                    \csLectureSingleTitle \end {minipage}
                }
                \par
                \vspace {20pt}
            }
        }
        \endgroup
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Lecture Presentation
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\csLectureIf:nnT {layout} {true}
{
    \RequirePackage [margin = 1in] {geometry}
    \RequirePackage {setspace}
}
\csLectureIf:nnT {diagrams} {true}
{
    \RequirePackage {tikz-cd}
}
\csLectureIf:nnT {headers} {course}
{
    \RequirePackage {fancyhdr}
    \setlength \headheight {15pt}
    \pagestyle {fancy}
    \fancyhf {}
    \RenewDocumentCommand \chaptermark {m}
    {
        \markboth
        {
            \normalfont \scshape \chaptername \ \thechapter .\ #1
        } {}
    }
    \fancyhead
    [
        LE,
        RO
    ] {\thepage}
    \fancyhead [CO] {\leftmark}
    \fancyhead [CE]
    {
        \scshape \csLectureCourse
    }
    \renewcommand \headrulewidth {.5pt}
}

\cs_new_protected:Npn \csLectureChapterBox #1#2
{
    \par
    \noindent \fboxsep = 8pt\fboxrule = .6pt
    \fbox
    {
        \begin {minipage}
        {
            \dimexpr \linewidth -2\fboxsep -2\fboxrule \relax
        }
        \centering
        \tl_if_blank:nTF {#1} {
            {
                \large \scshape #2
            }}
        {
            {
                \normalsize \scshape #1
            }\\[4pt]
            {
                \LARGE \scshape #2
            }
        }
        \end {minipage}
    }
    \par
}
\csLectureIf:nnT {chapters} {boxed}
{
    \RequirePackage {titlesec}
    \titleformat {\chapter}[block] {} {} {0pt}
    {
        \csLectureChapterBox
        {
            \chaptertitlename \ \thechapter
        }
    }
    \titleformat
    {
        name = \chapter ,
        numberless
    }[block] {} {} {0pt}
    {
        \csLectureChapterBox {}
    }
    \titlespacing * {\chapter} {0pt}
    {
        2\baselineskip
    }
    {
        2\baselineskip
    }
}
\ProvideDocumentCommand \emphindex {m}
{
    \emph {#1}
    \str_if_eq:eeT
    {
        \CsmathConfiguration {index}
    } {true}
    {
        \index {#1}
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Reference Providers
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\csLectureIf:nnF {references} {none}
{
    \@ifpackageloaded {hyperref} {}
    {
        \RequirePackage {hyperref}
    }
    \RequirePackage {nameref}
}
\csLectureIf:nnT {references} {cleveref}
{
    \@ifpackageloaded {cleveref} {}
    {
        \RequirePackage
        [
            nameinlink,
            noabbrev
        ] {cleveref}
    }
}
\csLectureIf:nnT {references} {zref}
{
    \RequirePackage {zref-clever}
}
\csLectureIf:nnT {references} {both}
{
    \@ifpackageloaded {cleveref} {}
    {
        \RequirePackage
        [
            nameinlink,
            noabbrev
        ] {cleveref}
    }
    \RequirePackage {zref-clever}
}



\cs_new_protected:Npn \csLectureZrefName #1#2#3
{
    \zcsetup
    {
        countertype = {#1 = #1}
    }
    \use:e
    {
        \exp_not:N \zcLanguageSetup {english}
        {
            type = {#1},
            name-sg =
                {
                    \str_lowercase:n {#2}
                },
            name-pl =
                {
                    \str_lowercase:n {#3}
                },
            Name-sg = {#2},
            Name-pl = {#3}
        }
    }
}

\cs_new_protected:Npn \csLectureRegisterZref
{
    \cs_if_exist:NT \CsthmMapFamilies
    {
        \CsthmMapFamilies \csLectureZrefName
    }
}
\@ifpackageloaded {zref-clever} {\csLectureRegisterZref}
{
    \AddToHook {package/zref-clever/after} [cslecture] {\csLectureRegisterZref}
}
\ProvideDocumentCommand \fullref {m}
{
    \@ifpackageloaded {hyperref}
    {
        \hyperref [#1]
        {
            \@ifpackageloaded {cleveref}
            {
                \cref * {#1}
            }
            {
                \autoref * {#1}
            }
            \space (\nameref * {#1})
        }
    }
    {
        \ref {#1}
    }
}
\ExplSyntaxOff
