\newtheoremstyle{cslcplain}
{\item[\hskip\labelsep\theorem@headerfont ##1\ ##2\unskip\theorem@separator]}
{\item[\hskip\labelsep\theorem@headerfont ##1\ ##2\ {\normalfont(##3)}\unskip\theorem@separator]}
\newtheoremstyle{nonumbercslcplain}
{\item[\hskip\labelsep\theorem@headerfont ##1\unskip\theorem@separator]}
{\item[\hskip\labelsep\theorem@headerfont ##1\ {\normalfont(##3)}\unskip\theorem@separator]}

\def\cslc@configuretheorem#1#2{%
	\theoremstyle{cslcplain}%
	\theoremheaderfont{#1}%
	\theorembodyfont{#2}%
	\theoremseparator{.}%
	\theorempreskip{0pt}%
	\theorempostskip{0pt}%
	\theoremsymbol{\cs@endsymb}%
}
\def\cslc@surroundtheorem#1{\@ifundefined{surroundwithmdframed}{}{\surroundwithmdframed[style=cs@ruled]{#1}}}
\def\cslc@newtheorem#1{\expandafter\cslc@newtheorem@parse#1\cslc@nil}
\def\cslc@newtheorem@parse#1/#2\cslc@nil{%
	\newtheorem{#1}[theorem]{#2}%
	\cslc@surroundtheorem{#1}%
}
\def\cslc@newtheoremfamily#1#2#3{\cslc@configuretheorem{#1}{#2}\forcsvlist{\cslc@newtheorem}{#3}}
\def\cslc@renewtheoremstar#1{\expandafter\cslc@renewtheoremstar@parse#1\cslc@nil}
\def\cslc@renewtheoremstar@parse#1/#2\cslc@nil{%
	\renewtheorem*{#1}{#2}%
	\cslc@surroundtheorem{#1}%
}

\cslc@configuretheorem{\scshape}{\normalfont}
\newtheorem{theorem}{Theorem}[section]
\cslc@surroundtheorem{theorem}
