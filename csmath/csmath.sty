%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Options
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\prop_new:N \g_csMathChoices_prop
\msg_new:nnn {csmath} {conflict}
{Contradictory~#1~selections:~#2.~Choose~one~value.}
\msg_new:nnn {csmath} {incompatible}
{csmath~cannot~be~loaded~with~#1.~Remove~the~overlapping~package~and~configure~csmath~directly.}
\msg_new:nnn {csmath} {feature}
{#1~requires~the~csmath~#2~option.}
\cs_new_protected:Npn \csMathSelect #1#2
{
    \prop_get:NnNTF \g_csMathChoices_prop {#1} \l_tmpa_tl
    {
        \tl_if_eq:NnF \l_tmpa_tl {#2}
        {
            \msg_error:nnxx {csmath} {conflict} {#1}
            {
                '\l_tmpa_tl '~and~'#2'
            }
        }
    }
    {
        \prop_gput:Nnn \g_csMathChoices_prop {#1} {#2}
    }
}

\cs_new_protected:Npn \csMathDefault #1#2
{
    \prop_if_in:NnF \g_csMathChoices_prop {#1}
    {
        \prop_gput:Nnn \g_csMathChoices_prop {#1} {#2}
    }
}
\keys_define:nn {csmath}
{
    mode .choices:nn =
        {
            article,
            manuscript,
            book,
            venue
        }
        {
            \exp_args:NnV \csMathSelect {mode} \l_keys_choice_tl
        },
    mode .value_required:n = true,
    font .choices:nn =
        {
            inherit,
            baskervaldx,
            concrete,
            garamond,
            gfsdidot,
            kpfonts,
            latinmodern,
            libertine,
            palatino
        }
        {
            \exp_args:NnV \csMathSelect {font} \l_keys_choice_tl
        },
    font .value_required:n = true,
    font-policy .choices:nn =
        {
            compatible,
            strict
        }
        {
            \exp_args:NnV \csMathSelect {font-policy} \l_keys_choice_tl
        },
    font-policy .value_required:n = true,
    theorems .choices:nn =
        {
            normal,
            fancy,
            oldschool,
            none,
            inherit
        }
        {
            \exp_args:NnV \csMathSelect {theorems} \l_keys_choice_tl
        },
    theorems .value_required:n = true,
    numberwithin .choices:nn =
        {
            section,
            chapter,
            none
        }
        {
            \exp_args:NnV \csMathSelect {numberwithin} \l_keys_choice_tl
        },
    numberwithin .value_required:n = true,
    equations .choices:nn =
        {
            inherit,
            section,
            chapter,
            none
        }
        {
            \exp_args:NnV \csMathSelect {equations} \l_keys_choice_tl
        },
    equations .value_required:n = true,
    paragraphs .choices:nn =
        {
            runin,
            inherit
        }
        {
            \exp_args:NnV \csMathSelect {paragraphs} \l_keys_choice_tl
        },
    paragraphs .value_required:n = true,
    cleveref .choices:nn =
        {
            auto,
            true,
            false
        }
        {
            \exp_args:NnV \csMathSelect {cleveref} \l_keys_choice_tl
        },
    cleveref .default:n = true,
    draft .choices:nn =
        {
            true,
            false
        }
        {
            \exp_args:NnV \csMathSelect {draft} \l_keys_choice_tl
        },
    draft .default:n = true,
    final .code:n =
        {
            \csMathSelect {draft} {false}
        },
    final .value_forbidden:n = true,
}
\clist_map_inline:nn
{
    baskervaldx,
    concrete,
    garamond,
    gfsdidot,
    kpfonts,
    latinmodern,
    libertine,
    palatino
}
{
    \keys_define:nn {csmath}
    {
        #1 .code:n =
            {
                \csMathSelect {font} {#1}
            },
        #1 .value_forbidden:n = true
    }
}
\clist_map_inline:nn
{
    table,
    caption,
    float,
    graphics,
    lists,
    references,
    layout,
    microtype,
    index,
    annotations,
    boxes,
    quotes,
    lastpage,
    sanshdr
}
{
    \keys_define:nn {csmath}
    {
        #1 .choices:nn =
            {
                true,
                false
            }
            {
                \exp_args:NnV \csMathSelect {#1} \l_keys_choice_tl
            },
        #1 .default:n = true
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Legacy Theorem Profiles
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\keys_define:nn {csmath}
{
    compatibility .choices:nn =
        {
            none,
            legacy-article,
            legacy-book
        }
        {
            \exp_args:NnV \csMathSelect {compatibility} \l_keys_choice_tl
            \str_case:Vn \l_keys_choice_tl
            {
                {legacy-article}
                {
                    \csMathConfigureLegacyTheorems {article} {oldschool}
                }
                {legacy-book}
                {
                    \csMathConfigureLegacyTheorems {book} {normal}
                }
            }
        },
    compatibility .value_required:n = true,
    counters .choices:nn =
        {
            independent,
            shared
        }
        {
            \exp_args:NnV \csMathSelect {counters} \l_keys_choice_tl
        },
    counters .value_required:n = true,
    families .choices:nn =
        {
            standard,
            extended
        }
        {
            \exp_args:NnV \csMathSelect {families} \l_keys_choice_tl
        },
    families .value_required:n = true,
    starred .choices:nn =
        {
            unnumbered,
            legacy,
        }
        {
            \exp_args:NnV \csMathSelect {starred} \l_keys_choice_tl
        },
    starred .value_required:n = true,
    appearance .choices:nn =
        {
            modern,
            legacy-article,
            legacy-book,
        }
        {
            \exp_args:NnV \csMathSelect {appearance} \l_keys_choice_tl
        },
    appearance .value_required:n = true,
    solution .choices:nn =
        {
            theorem,
            proof
        }
        {
            \exp_args:NnV \csMathSelect {solution} \l_keys_choice_tl
        },
    solution .value_required:n = true,
    family-style .code:n =
        {
            \csMathSelect {family-style} {#1}
        },
    family-style .value_required:n = true,
}

\cs_new_protected:Npn \csMathConfigureLegacyTheorems #1#2
{
    \csMathSelect {mode} {#1}
    \csMathSelect {theorems} {#2}
    \csMathSelect {numberwithin} {section}
    \csMathSelect {counters} {shared}
    \csMathSelect {families} {extended}
    \csMathSelect {starred} {legacy}
    \csMathSelect {appearance} {legacy-#1}
}
\ProcessKeyOptions [csmath]
\prop_new:N \g_csMathExplicit_prop
\prop_gset_eq:NN \g_csMathExplicit_prop \g_csMathChoices_prop

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Package Compatibility
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\clist_map_inline:nn
{
    csamsmath,
    csbook,
    eudoxus
}
{
    \@ifpackageloaded {#1}
    {
        \msg_error:nnn {csmath} {incompatible} {#1}
    }
    {
        \AddToHook {package/#1/before} [csmath]
        {
            \msg_error:nnn {csmath} {incompatible} {#1}
        }
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Configuration Queries
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NewExpandableDocumentCommand \CsmathConfiguration {m}
{
    \prop_item:Nn \g_csMathChoices_prop {#1}
}

\NewDocumentCommand \CsmathCheckConfiguration {m}
{
    \keys_set:nn {csmath} {#1}
}
\@onlypreamble \CsmathCheckConfiguration
\sys_if_engine_xetex:T
{
    \PackageError {csmath} {XeLaTeX~is~not~supported} {Use~pdfLaTeX~or~LuaLaTeX;~no~unverified~font~branch~is~selected.}
}
\csMathDefault {compatibility} {none}
\csMathDefault {mode} {article}
\csMathDefault {font} {inherit}
\csMathDefault {font-policy} {compatible}
\csMathDefault {equations} {inherit}
\csMathDefault {cleveref} {auto}
\csMathDefault {draft} {false}
\tl_new:N \csMathMode
\tl_new:N \csMathFont
\tl_new:N \csMathEffectiveFont
\tl_new:N \csMathTheorems
\tl_new:N \csMathNumberWithin
\tl_new:N \csMathParagraphs
\tl_new:N \csMathCleveref
\prop_get:NnN \g_csMathChoices_prop {mode} \csMathMode
\prop_get:NnN \g_csMathChoices_prop {font} \csMathFont
\tl_if_eq:NnTF \csMathMode {venue}
{
    \csMathDefault {theorems} {inherit}
    \csMathDefault {paragraphs} {inherit}
}
{
    \@ifpackageloaded {csthm}
    {
        \csMathDefault {theorems} {inherit}
    }
    {
        \csMathDefault {theorems} {oldschool}
    }
    \csMathDefault {paragraphs} {runin}
}
\tl_if_eq:NnTF \csMathMode {book}
{
    \cs_if_exist:NTF \chapter
     {
      \cs_if_exist:cF {c@chapter}
      {
          \PackageError {csmath} {Book~mode~requires~a~chapter~counter} {Use~book~or~report.}
      }
     }
     {
      \PackageError {csmath} {Book~mode~requires~a~chapter~structure} {Use~book~or~report;~manuscript~supports~article~classes.}
     }
    \csMathDefault {numberwithin} {chapter}
}
{
    \csMathDefault {numberwithin} {section}
}
\prop_get:NnN \g_csMathChoices_prop {theorems} \csMathTheorems
\prop_get:NnN \g_csMathChoices_prop {numberwithin} \csMathNumberWithin
\prop_get:NnN \g_csMathChoices_prop {paragraphs} \csMathParagraphs
\prop_get:NnN \g_csMathChoices_prop {cleveref} \csMathCleveref
\cs_new_protected:Npn \csMathIfFeature #1#2
{
    \prop_get:NnNT \g_csMathChoices_prop {#1} \l_tmpa_tl
    {
        \tl_if_eq:NnT \l_tmpa_tl {true} {#2}
    }
}
\csMathIfFeature {draft}
{
    \csMathSelect {annotations} {true}
}
\csMathIfFeature {lastpage}
{
    \csMathSelect {layout} {true}
}
\csMathIfFeature {sanshdr}
{
    \csMathSelect {layout} {true}
}

\cs_new_protected:Npn \csMathRequireFeature #1#2
{
    \prop_get:NnNTF \g_csMathChoices_prop {#1} \l_tmpa_tl
    {
        \tl_if_eq:NnF \l_tmpa_tl {true}
        {
            \msg_error:nnnn {csmath} {feature} {#2} {#1}
        }
    }
    {
        \msg_error:nnnn {csmath} {feature} {#2} {#1}
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Mathematics and Fonts
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage {amsmath}

\sys_if_engine_pdftex:T
{
    \@ifpackageloaded {newtxmath} {} {\RequirePackage {amssymb}}
}
\tl_set_eq:NN \csMathEffectiveFont \csMathFont
\sys_if_engine_pdftex:T
{
    \exp_args:NnV \clist_if_in:nnT
    {
        concrete,
        garamond,
        gfsdidot,
        kpfonts
    }
    \csMathFont
    {
        \prop_get:NnN \g_csMathChoices_prop {font-policy} \l_tmpa_tl
        \tl_if_eq:NnTF \l_tmpa_tl {strict}
        {
            \PackageError {csmath}
            {
                Requested~font~\csMathFont \space requires~LuaLaTeX
            }
            {Use~LuaLaTeX~or~font-policy=compatible~for~an~explicit~Latin~Modern~fallback.}
        }
        {
            \PackageWarning {csmath}
            {
                Requested~font~\csMathFont ;~effective~font~latinmodern~(pdfLaTeX~fallback)
            }
        }
        \tl_set:Nn \csMathEffectiveFont {latinmodern}
    }
}

\NewExpandableDocumentCommand \CsmathSelectedFont {} {\csMathFont}
\NewExpandableDocumentCommand \CsmathEffectiveFont {} {\csMathEffectiveFont}
\cs_new_protected:Npn \csMathCheckFontFile #1
{
    \IfFontExistsTF {#1} {}
    {
        \PackageError {csmath} {Required~font~file~#1~is~unavailable}
        {Install~the~corresponding~TeX~font~collection,~or~select~font=inherit.~No~unrelated~font~is~substituted.}
    }
}

\cs_new_protected:Npn \csMathIfFont #1#2
{
    \tl_if_eq:NnT \csMathEffectiveFont {#1} {#2}
}

\cs_new_protected:Npn \csMathIfNamedFont #1
{
    \exp_args:NnV \clist_if_in:nnF
    {
        inherit,
    }
    \csMathEffectiveFont {#1}
}

