\cs_new_protected:Npn \csMathCheckTheorems
{
    \cs_if_exist:NF \CsthmConfiguration
    {
        \PackageError {csmath} {Preloaded~csthm~is~too~old} {Use~csthm~4.1~or~newer.}
    }
    \clist_map_inline:nn
    {
        numberwithin,
        cleveref,
        counters,
        families,
        starred,
        appearance,
        solution
    }
    {
        \tl_set:Nx \l_tmpb_tl
        {
            \CsthmConfiguration {##1}
        }
        \prop_get:NnNTF \g_csMathExplicit_prop {##1} \l_tmpa_tl
        {
            \tl_if_eq:NNF \l_tmpa_tl \l_tmpb_tl
            {
                \str_case:nnF {##1}
                {
                    {numberwithin}
                    {
                        \PackageError {csmath} {Preloaded~csthm~numbering~conflicts} {Match~the~initial~numberwithin~selection.}
                    }
                    {cleveref}
                    {
                        \PackageError {csmath} {Preloaded~csthm~cleveref~policy~conflicts} {Match~the~initial~cleveref~selection.}
                    }
                }
                {
                    \PackageError {csmath} {Preloaded~csthm~##1~conflicts} {Select~the~same~configuration~at~initial~load.}
                }
            }
        }
        {
            \prop_gput:NnV \g_csMathChoices_prop {##1} \l_tmpb_tl
        }
    }
    \tl_if_eq:NnTF \csMathTheorems {inherit}
    {
        \tl_set:Nx \l_tmpa_tl
        {
            \CsthmConfiguration {style}
        }
        \tl_if_empty:NT \l_tmpa_tl
        {
            \tl_set:Nn \l_tmpa_tl {none}
        }
        \prop_gput:NnV \g_csMathChoices_prop {theorems} \l_tmpa_tl
    }
    {
        \tl_set_eq:NN \l_tmpa_tl \csMathTheorems
        \tl_if_eq:NnT \l_tmpa_tl {none}
        {
            \tl_clear:N \l_tmpa_tl
        }
        \tl_set:Nx \l_tmpb_tl
        {
            \CsthmConfiguration {style}
        }
        \tl_if_eq:NNF \l_tmpa_tl \l_tmpb_tl
        {
            \PackageError {csmath}
            {
                Preloaded~csthm~style~conflicts~with~theorems=\csMathTheorems
            }
            {Match~the~existing~style~or~use~theorems=inherit.}
        }
    }
    \prop_get:NnN \g_csMathChoices_prop {numberwithin}
    \csMathNumberWithin
    \prop_get:NnN \g_csMathChoices_prop {cleveref}
    \csMathCleveref
    \csMathIfFeature {references}
    {
        \tl_if_eq:NnT \csMathCleveref {auto}
        {
            \tl_set:Nn \csMathCleveref {true}
        }
    }
}
\keys_define:nn {csmath/families}
{
    theorem .code:n =
        {
            \CsthmSetupFamily {theorem} {#1}
        },
    definition .code:n =
        {
            \CsthmSetupFamily {definition} {#1}
        },
    remark .code:n =
        {
            \CsthmSetupFamily {remark} {#1}
        },
    highlight .code:n =
        {
            \CsthmSetupFamily {highlight} {#1}
        },
}
\@ifpackageloaded {csthm}
{
    \csMathCheckTheorems
    \prop_get:NnNT \g_csMathChoices_prop {family-style} \l_tmpa_tl
    {
        \exp_args:NnV \keys_set:nn {csmath/families} \l_tmpa_tl
    }
}
{
    \tl_if_eq:NnTF \csMathTheorems {inherit}
    {
        \clist_map_inline:nn
        {
            counters,
            families,
            starred,
            appearance,
            solution,
            family-style
        }
        {
            \prop_if_in:NnT \g_csMathExplicit_prop {#1}
            {
                \PackageError {csmath} {Theorem~option~#1~requires~csthm~ownership} {Choose~a~theorem~style.}
            }
        }
    }
    {
        \tl_if_eq:NnF \csMathTheorems {none}
        {
            \exp_args:Nx \PassOptionsToPackage
            {
                style = \csMathTheorems
            } {csthm}
        }
        \exp_args:Nx \PassOptionsToPackage
        {
            numberwithin = \csMathNumberWithin ,
            cleveref = \csMathCleveref
        } {csthm}
        \clist_map_inline:nn
        {
            counters,
            families,
            starred,
            appearance,
            solution
        }
        {
            \prop_get:NnNT \g_csMathChoices_prop {#1} \l_tmpa_tl
            {
                \exp_args:Nx \PassOptionsToPackage
                {
                    #1 = \l_tmpa_tl
                } {csthm}
            }
        }
        \prop_get:NnNT \g_csMathChoices_prop {family-style} \l_tmpa_tl
        {
            \exp_args:Nx \PassOptionsToPackage
            {
                family-style =
                    {
                        \exp_not:V \l_tmpa_tl
                    }
            } {csthm}
        }
        \RequirePackage {csthm} [2026/10/08]
    }
}
\csMathDefault {counters} {independent} \csMathDefault {families} {standard}
\csMathDefault {starred} {unnumbered} \csMathDefault {appearance} {modern}
\csMathDefault {solution} {theorem} \csMathDefault {family-style} {}

