\clist_map_inline:nn
{
    mathbfcal,
    mathbfbb,
    mathbbi,
    mathbfbbi,
    mathscr,
    mathbfscr
}
{
    \cs_if_exist:cF {#1}
    {
        \exp_args:Nc \NewDocumentCommand {#1} {m}
        {
            \PackageError {csmath} {Alphabet~#1~is~not~provided~by~the~inherited~font}
            {Choose~a~named~font~or~define~this~alphabet~in~your~document.}
        }
    }
}
\@ifpackageloaded {unicode-math}
{
    \AddToHook {begindocument} [csmath/unicode-aliases]
    {
        \cs_set_eq:NN \leadsto \rightsquigarrow
        \cs_set_eq:NN \square \mdlgwhtsquare
    }
} {}
\RenewDocumentCommand \Pr {}
{
    \mathop
    {
        \mathsf {Pr}
    }
}

\NewDocumentCommand \annotation {m}
{
    \footnote {#1}
}
\prop_get:NnN \g_csMathChoices_prop {equations} \l_tmpa_tl
\str_case:Vn \l_tmpa_tl
{
    {section}
    {
        \numberwithin {equation} {section}
    }
    {chapter}
    {
        \cs_if_exist:cTF {c@chapter}
        {
            \numberwithin {equation} {chapter}
        }
        {
            \PackageError {csmath} {Chapter~equations~require~a~chapter~counter} {Choose~equations=section~or~none.}
        }
    }
    {none}
    {
        \counterwithout * {equation} {section}
        \cs_if_exist:cT {c@chapter}
        {
            \counterwithout * {equation} {chapter}
        }
        \renewcommand \theequation
        {
            \arabic {equation}
        }
    }
}

