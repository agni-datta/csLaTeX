\ExplSyntaxOn
\bool_new:N \l_csMathStylishAlphabet_bool
\cs_new_protected:Npn \csMathSetStylishAlphabet #1
{
    \bool_set:Nn \l_csMathStylishAlphabet_bool
    {
        \str_if_eq_p:nn {#1} {true}
    }
}

\cs_new_protected:Npn \csMathIfStylishAlphabet #1#2
{
    \bool_if:NTF \l_csMathStylishAlphabet_bool {#1} {#2}
}

\cs_new_protected:Npn \csMathIfPDFTeX #1#2
{
    \sys_if_engine_pdftex:TF {#1} {#2}
}

\cs_new_protected:Npn \csMathIfLatinModern #1#2
{
    \tl_if_eq:NnTF \csMathEffectiveFont {latinmodern} {#1} {#2}
}

\cs_new_protected:Npn \csMathIfNotPalatino #1
{
    \tl_if_eq:NnF \csMathEffectiveFont {palatino} {#1}
}

\cs_new_protected:Npn \csMathDefineBoldAlphabets
{
    \cs_set_protected:Npn \mathbfcal ##1
    {
        \boldsymbol
        {
            \mathcal {##1}
        }
    }
    \cs_set_protected:Npn \mathbfbb ##1
    {
        \boldsymbol
        {
            \mathbb {##1}
        }
    }
    \cs_set_protected:Npn \mathbfbbi ##1
    {
        \boldsymbol
        {
            \mathbbi {##1}
        }
    }
    \cs_set_protected:Npn \mathbfscr ##1
    {
        \boldsymbol
        {
            \mathscr {##1}
        }
    }
    \cs_set_protected:Npn \mathbf ##1
    {
        \boldsymbol
        {
            \mathrm {##1}
        }
    }
}
\ExplSyntaxOff
\newcommand{\csMathLoadMathTools}%
{%
    \RequirePackage{mathtools}%
}
\newcommand{\csMathLoadAMSMathTools}%
{%
    \@ifpackageloaded{newtxmath}{}{\RequirePackage{amssymb}}%
    \RequirePackage{mathtools}%
}
\csMathIfNamedFont
{ %
    \csMathIfPDFTeX
    { %
        \RequirePackage[T1]{fontenc}
        \RequirePackage{sansmath}

        \newcommand{\csMathPDFMono}%
        {%
            \RequirePackage[scaled=1.03]{inconsolata}%
        }
        \newcommand{\csMathPDFSans}%
        {%
            \RequirePackage
            [%
                type1,%
                scaled=1.085%
            ]{biolinum}%
        }

        \csMathIfFont{baskervaldx}%
        { %
            \RequirePackage
            [%
                lining,%
                tabular%
            ]{Baskervaldx}
            \csMathPDFSans
            \csMathPDFMono
            \RequirePackage
            [%
                baskervaldx,%
                varbb%
            ]{newtxmath}
            \SetSymbolFont{operators}{bold}{OT1}{Baskervaldx-TLF}{b}{n}
            \SetMathAlphabet{\mathbf}{normal}{OT1}{Baskervaldx-TLF}{b}{n}
            \SetMathAlphabet{\mathbf}{bold}{OT1}{Baskervaldx-TLF}{b}{n}
            \SetMathAlphabet{\mathit}{bold}{OT1}{Baskervaldx-TLF}{b}{it}
            \csMathLoadMathTools
            \csMathSetStylishAlphabet{true}
        }

        \csMathIfFont{latinmodern}%
        { %
            \RequirePackage{lmodern}
            \csMathLoadAMSMathTools
            \csMathSetStylishAlphabet{false}
        }

        \csMathIfFont{libertine}%
        { %
            \csMathPDFSans
            \csMathPDFMono
            \RequirePackage
            [%
                lining,%
                tabular%
            ]{libertineRoman}
            \RequirePackage
            [%
                libertine,%
                varbb%
            ]{newtxmath}
            \csMathLoadMathTools
            \csMathSetStylishAlphabet{true}
        }

        \csMathIfFont{palatino}%
        { %
            \RequirePackage
            [%
                sc,%
                noBBpl%
            ]{mathpazo}
            \csMathPDFSans
            \csMathPDFMono
            \csMathLoadAMSMathTools
            \csMathSetStylishAlphabet{true}
        }

    }%
    { %
        \RequirePackage{fontspec}
        \RequirePackage{sansmath}
        \RequirePackage{mathtools}
        \RequirePackage{unicode-math}
        \defaultfontfeatures
        {%
            Numbers=%
                {%
                    Lining,%
                    Monospaced%
                }%
        }
        \newcommand{\csMathLuaMono}%
        {%
            \csMathCheckFontFile{Inconsolatazi4-Regular.otf}
            \csMathCheckFontFile{Inconsolatazi4-Bold.otf}
            \setmonofont{Inconsolatazi4-Regular.otf}[
                BoldFont = Inconsolatazi4-Bold.otf, %
                ItalicFont = Inconsolatazi4-Regular.otf, %
                ItalicFeatures = {FakeSlant=0.2}, %
                BoldItalicFont = Inconsolatazi4-Bold.otf, %
                BoldItalicFeatures = {FakeSlant=0.2}, %
                Scale = MatchLowercase, %
                Ligatures = TeX, %
                RawFeature =
                    {%
                        +calt,%
                        +case,%
                        +kern,%
                        +liga,%
                        +mark,%
                        +mkmk,%
                        +lnum,%
                        +tnum%
                    }
            ]%
        }
        \newcommand{\csMathLuaSans}[1][MatchUppercase]%
        {%
            \csMathCheckFontFile{LibertinusSans-Regular.otf}
            \csMathCheckFontFile{LibertinusSans-Bold.otf}
            \csMathCheckFontFile{LibertinusSans-Italic.otf}
            \setsansfont{LibertinusSans-Regular.otf}[
                BoldFont = LibertinusSans-Bold.otf, %
                ItalicFont = LibertinusSans-Italic.otf, %
                BoldItalicFont = LibertinusSans-Bold.otf, %
                BoldItalicFeatures = {FakeSlant=0.2}, %
                Scale = #1, %
                Ligatures = TeX, %
                SmallCapsFeatures = {RawFeature=+smcp}, %
                RawFeature =
                    {%
                        +calt,%
                        +case,%
                        +kern,%
                        +liga,%
                        +mark,%
                        +mkmk,%
                        +lnum,%
                        +tnum%
                    }
            ]%
        }
        \newcommand{\csMathLuaMathSans}%
        {%
            \setmathfont{LibertinusSans-Regular.otf}[
                BoldFont = LibertinusSans-Bold.otf, %
                Scale = MatchUppercase, %
                range =
                    {%
                        sfup/%
                        {%
                            latin,%
                            Latin,%
                            num%
                        },%
                        sfit/%
                        {%
                            latin,%
                            Latin%
                        }%
                    }, %
                Ligatures = TeX, %
                RawFeature =
                    {%
                        +calt,%
                        +case,%
                        +kern,%
                        +liga,%
                        +mark,%
                        +mkmk,%
                        +lnum,%
                        +tnum%
                    }
            ]%
        }
        \newcommand{\csMathLuaMathMono}%
        {%
            \setmathfont{Inconsolatazi4-Regular.otf}[
                BoldFont = Inconsolatazi4-Bold.otf, %
                Scale = MatchUppercase, %
                range =
                    {%
                        tt/%
                        {%
                            latin,%
                            Latin,%
                            num%
                        }%
                    }, %
                RawFeature =
                    {%
                        +calt,%
                        +case,%
                        +kern,%
                        +liga,%
                        +mark,%
                        +mkmk,%
                        +lnum,%
                        +tnum%
                    }
            ]%
        }

        \csMathIfFont{baskervaldx}%
        { %
            \csMathCheckFontFile{Baskervaldx-Bol.otf}
            \csMathCheckFontFile{Baskervaldx-BolIta.otf}
            \csMathCheckFontFile{Baskervaldx-Ita.otf}
            \csMathCheckFontFile{Baskervaldx-Reg.otf}
            \csMathCheckFontFile{KpMath-Bold.otf}
            \csMathCheckFontFile{KpMath-Regular.otf}

            \setmainfont{Baskervaldx-Reg.otf}[
                BoldFont = Baskervaldx-Bol.otf, %
                ItalicFont = Baskervaldx-Ita.otf, %
                BoldItalicFont = Baskervaldx-BolIta.otf, %
                Ligatures = TeX, %
                SmallCapsFeatures = {RawFeature=+smcp}, %
                RawFeature =
                    {%
                        +calt,%
                        +case,%
                        +kern,%
                        +liga,%
                        +mark,%
                        +mkmk,%
                        +lnum,%
                        +tnum%
                    }
            ]
            \csMathLuaSans
            \csMathLuaMono
            \setmathfont{KpMath-Regular.otf}[
                BoldFont = KpMath-Bold.otf, %
                AutoFakeSlant, %
                Scale = MatchUppercase, %
                RawFeature =
                    {%
                        +calt,%
                        +case,%
                        +kern,%
                        +liga,%
                        +mark,%
                        +mkmk,%
                        +lnum,%
                        +tnum%
                    }
            ]
            \setmathfont{Baskervaldx-Reg.otf}[
                BoldFont = Baskervaldx-Bol.otf, %
                Scale = MatchUppercase, %
                range =
                    {%
                        up/%
                        {%
                            latin,%
                            Latin,%
                            num%
                        }%
                    }, %
                Ligatures = TeX, %
                RawFeature =
                    {%
                        +calt,%
                        +case,%
                        +kern,%
                        +liga,%
                        +mark,%
                        +mkmk,%
                        +lnum,%
                        +tnum%
                    }
            ]
            \setmathfont{Baskervaldx-Ita.otf}[
                BoldFont = Baskervaldx-BolIta.otf, %
                Scale = MatchUppercase, %
                range =
                    {%
                        it/%
                        {%
                            latin,%
                            Latin%
                        }%
                    }, %
                Ligatures = TeX, %
                RawFeature =
                    {%
                        +calt,%
                        +case,%
                        +kern,%
                        +liga,%
                        +mark,%
                        +mkmk,%
                        +lnum,%
                        +tnum%
                    }
            ]
            \csMathLuaMathSans
            \csMathLuaMathMono
            \csMathSetStylishAlphabet{true}
        }

        \csMathIfFont{concrete}%
        { %
            \csMathCheckFontFile{Euler-Math.otf}
            \csMathCheckFontFile{NewCMMono10-Bold.otf}
            \csMathCheckFontFile{NewCMMono10-BoldOblique.otf}
            \csMathCheckFontFile{NewCMMono10-Book.otf}
            \csMathCheckFontFile{NewCMMono10-BookItalic.otf}
            \csMathCheckFontFile{NewCMSans10-Bold.otf}
            \csMathCheckFontFile{NewCMSans10-BoldOblique.otf}
            \csMathCheckFontFile{NewCMSans10-Book.otf}
            \csMathCheckFontFile{NewCMSans10-BookOblique.otf}
            \csMathCheckFontFile{cmunobi.otf}
