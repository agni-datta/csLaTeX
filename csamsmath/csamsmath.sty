			\csam@pdfmono
			\csam@loadamsmathtools
			\csam@alphabet@stylishtrue
		\fi

	\fi

	% These NFSS declarations are the small subset of the alphabet setup that this
	% package needs.  Keeping them here avoids a dependency on version-sensitive
	% alphabet-selection wrappers while retaining the same underlying fonts.
	\def\csam@declare@cmcal{%
		\DeclareFontFamily{U}{cmsy}{\skewchar\font48 }%
		\DeclareFontShape{U}{cmsy}{m}{n}{%
			<-5.5>cmsy5<5.5-6.5>cmsy6<6.5-7.5>cmsy7
			<7.5-8.5>cmsy8<8.5-9.5>cmsy9<9.5->cmsy10}{}%
		\DeclareFontShape{U}{cmsy}{b}{n}{%
			<-5.5>cmbsy5<5.5-6.5>cmbsy6<6.5-7.5>cmbsy7
			<7.5-8.5>cmbsy8<8.5-9.5>cmbsy9<9.5->cmbsy10}{}%
		\DeclareMathAlphabet{\mathcal}{U}{cmsy}{m}{n}%
		\SetMathAlphabet{\mathcal}{bold}{U}{cmsy}{b}{n}%
		\DeclareMathAlphabet{\mathbfcal}{U}{cmsy}{b}{n}%
	}
	\def\csam@declare@stixcal{%
		\DeclareFontFamily{U}{stixplain}{\skewchar\font=127 }%
		\DeclareFontShape{U}{stixplain}{m}{n}{<->stix-mathcal}{}%
		\DeclareFontShape{U}{stixplain}{b}{n}{<->stix-mathcal-bold}{}%
		\DeclareMathAlphabet{\mathcal}{U}{stixplain}{m}{n}%
		\SetMathAlphabet{\mathcal}{bold}{U}{stixplain}{b}{n}%
		\DeclareMathAlphabet{\mathbfcal}{U}{stixplain}{b}{n}%
	}
	\def\csam@declare@stixbb{%
		\DeclareFontFamily{U}{stixonebb}{\skewchar\font=45 }%
		\DeclareFontShape{U}{stixonebb}{m}{n}{<->stix-mathbb}{}%
		\DeclareFontShape{U}{stixonebb}{m}{it}{<->stix-mathbbit}{}%
		\DeclareFontShape{U}{stixonebb}{b}{n}{<->stix-mathbb-bold}{}%
		\DeclareFontShape{U}{stixonebb}{b}{it}{<->stix-mathbbit-bold}{}%
		\DeclareFontSubstitution{U}{stixonebb}{m}{n}%
		\DeclareMathAlphabet{\mathbb}{U}{stixonebb}{m}{n}%
		\SetMathAlphabet{\mathbb}{bold}{U}{stixonebb}{b}{n}%
		\DeclareMathAlphabet{\mathbfbb}{U}{stixonebb}{b}{n}%
		\DeclareMathAlphabet{\mathbbi}{U}{stixonebb}{m}{it}%
		\SetMathAlphabet{\mathbbi}{bold}{U}{stixonebb}{b}{it}%
		\DeclareMathAlphabet{\mathbfbbi}{U}{stixonebb}{b}{it}%
	}
	\def\csam@declare@bboldxbb{%
		\DeclareFontFamily{U}{bboldx}{\skewchar\font=45 }%
		\DeclareFontShape{U}{bboldx}{m}{n}{<->BBOLDX-Regular}{}%
		\DeclareFontShape{U}{bboldx}{b}{n}{<->BBOLDX-Bold}{}%
		\DeclareFontShape{U}{bboldx}{bx}{n}{<->ssub*bboldx/b/n}{}%
		\DeclareMathAlphabet{\mathbb}{U}{bboldx}{m}{n}%
		\SetMathAlphabet{\mathbb}{bold}{U}{bboldx}{b}{n}%
		\DeclareMathAlphabet{\mathbfbb}{U}{bboldx}{b}{n}%
	}
	\def\csam@declare@dutchscr{%
		\DeclareFontFamily{U}{dutchscr}{\skewchar\font=45 }%
		\DeclareFontShape{U}{dutchscr}{m}{n}{<->dutchcal-r}{}%
		\DeclareFontShape{U}{dutchscr}{b}{n}{<->dutchcal-b}{}%
		\DeclareMathAlphabet{\mathscr}{U}{dutchscr}{m}{n}%
		\SetMathAlphabet{\mathscr}{bold}{U}{dutchscr}{b}{n}%
		\DeclareMathAlphabet{\mathbfscr}{U}{dutchscr}{b}{n}%
	}

	\let\mathbb\relax
	\let\mathbfbb\relax
	\let\mathbbi\relax
	\let\mathbfbbi\relax
	\let\mathbfcal\relax
	\let\mathscr\relax
	\let\mathbfscr\relax
	\ifcsam@palatino
		\csam@declare@stixcal
		\csam@declare@bboldxbb
	\else
		\ifcsam@alphabet@stylish
			\csam@declare@stixcal
		\else
			\csam@declare@cmcal
		\fi
		\csam@declare@stixbb
	\fi
	\csam@declare@dutchscr
	\ifPDFTeX
		\ifcsam@latinmodern
			\SetMathAlphabet{\mathsf}{normal}{T1}{lmss}{m}{n}%
			\SetMathAlphabet{\mathsf}{bold}{T1}{lmss}{b}{n}%
			\SetMathAlphabet{\mathtt}{normal}{T1}{lmtt}{m}{n}%
			\SetMathAlphabet{\mathtt}{bold}{T1}{lmtt}{sb}{n}%
		\else
			\SetMathAlphabet{\mathsf}{normal}{T1}{LinuxBiolinumT-TLF}{m}{n}%
			\SetMathAlphabet{\mathsf}{bold}{T1}{LinuxBiolinumT-TLF}{b}{n}%
			\SetMathAlphabet{\mathtt}{normal}{T1}{zi4}{m}{n}%
			\SetMathAlphabet{\mathtt}{bold}{T1}{zi4}{b}{n}%
		\fi
		\RequirePackage{bm}
	\fi

}{}

