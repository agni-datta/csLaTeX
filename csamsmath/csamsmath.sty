	\newcommand{\csam@luamono}{%
		\setmonofont{AnonymousPro-Regular.ttf}[
			BoldFont       = AnonymousPro-Bold.ttf,
			ItalicFont     = AnonymousPro-Italic.ttf,
			BoldItalicFont = AnonymousPro-BoldItalic.ttf,
			Scale          = MatchLowercase,
			Ligatures      = TeX,
			RawFeature     = {+calt,+case,+kern,+liga,+mark,+mkmk,+lnum,+tnum}
		]%
	}
	\newcommand{\csam@luasans}[1][MatchUppercase]{%
		\setsansfont{LibertinusSans-Regular.otf}[
			BoldFont          = LibertinusSans-Bold.otf,
			ItalicFont        = LibertinusSans-Italic.otf,
			BoldItalicFont    = LibertinusSans-Bold.otf,
			BoldItalicFeatures = {FakeSlant=0.2},
			Scale             = #1,
			Ligatures         = TeX,
			SmallCapsFeatures = {RawFeature=+smcp},
			RawFeature        = {+calt,+case,+kern,+liga,+mark,+mkmk,+lnum,+tnum}
		]%
	}
	\newcommand{\csam@luamathsf}{%
		\setmathfont{LibertinusSans-Regular.otf}[
			BoldFont  = LibertinusSans-Bold.otf,
			Scale      = MatchUppercase,
			range      = {sfup/{latin,Latin,num},sfit/{latin,Latin}},
			Ligatures  = TeX,
			RawFeature = {+calt,+case,+kern,+liga,+mark,+mkmk,+lnum,+tnum}
		]%
	}
	\newcommand{\csam@luamathtt}{%
		\setmathfont{AnonymousPro-Regular.ttf}[
