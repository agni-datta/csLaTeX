	\par\smallskip\noindent
	{\csam@parheadfont\ignorespaces\csam@appendpunctuationifneeded{#1}}%
	\hskip 0.30em
	\ignorespaces
}
\newcommand{\csam@subparagraphhead}[1]{%
	\par\smallskip\noindent
	{\csam@subparheadfont\ignorespaces\csam@appendpunctuationifneeded{#1}}%
	\hskip 0.30em
	\ignorespaces
}

\ProvideDocumentCommand{\parhead}   {m}{\csam@paragraphhead{#1}}
\ProvideDocumentCommand{\subparhead}{m}{\csam@subparagraphhead{#1}}

