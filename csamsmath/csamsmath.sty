%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Options
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tl_new:N   \g_csam_font_tl
\bool_new:N \g_csam_draft_bool
\bool_new:N \g_csam_sanshdr_bool

\tl_gset:Nn \g_csam_font_tl { latinmodern }

\keys_define:nn { csamsmath }
{
	font         .code:n      = { \keys_set:nn { csamsmath } { #1 } } ,
	baskervaldx  .code:n      = { \tl_gset:Nn \g_csam_font_tl { baskervaldx } } ,
	concrete     .code:n      = { \tl_gset:Nn \g_csam_font_tl { concrete    } } ,
	garamond     .code:n      = { \tl_gset:Nn \g_csam_font_tl { garamond    } } ,
	gfsdidot     .code:n      = { \tl_gset:Nn \g_csam_font_tl { gfsdidot    } } ,
	kpfonts      .code:n      = { \tl_gset:Nn \g_csam_font_tl { kpfonts     } } ,
	latinmodern  .code:n      = { \tl_gset:Nn \g_csam_font_tl { latinmodern } } ,
	libertine    .code:n      = { \tl_gset:Nn \g_csam_font_tl { libertine   } } ,
	palatino     .code:n      = { \tl_gset:Nn \g_csam_font_tl { palatino    } } ,
	draft        .bool_gset:N = \g_csam_draft_bool ,
	draft        .initial:n   = false ,
	final        .code:n      = { \bool_gset_false:N \g_csam_draft_bool } ,
	sanshdr      .bool_gset:N = \g_csam_sanshdr_bool ,
	sanshdr      .initial:n   = false ,
	unknown      .code:n      = { \PackageWarning{csamsmath}{Unknown~option~`#1'~ignored} } ,
}
\ProcessKeysOptions { csamsmath }
\tl_if_blank:VT \g_csam_font_tl
{
	\tl_gset:Nn \g_csam_font_tl { latinmodern }
}
\tl_if_exist:NT \g_csbk_font_tl
{
	\tl_if_eq:NNF \g_csam_font_tl \g_csbk_font_tl
	{
		\PackageError{csamsmath}{Font~option~must~match~csbook}{Load~csbook~and~csamsmath~with~the~same~font~option.}
	}
}

\newif\ifcsam@baskervaldx  \tl_if_eq:NnT \g_csam_font_tl      { baskervaldx       }{ \csam@baskervaldxtrue }
\newif\ifcsam@concrete     \tl_if_eq:NnT \g_csam_font_tl      { concrete          }{ \csam@concretetrue    }
\newif\ifcsam@garamond     \tl_if_eq:NnT \g_csam_font_tl      { garamond          }{ \csam@garamondtrue    }
\newif\ifcsam@gfsdidot     \tl_if_eq:NnT \g_csam_font_tl      { gfsdidot          }{ \csam@gfsdidottrue    }
\newif\ifcsam@kpfonts      \tl_if_eq:NnT \g_csam_font_tl      { kpfonts           }{ \csam@kpfontstrue     }
\newif\ifcsam@latinmodern  \tl_if_eq:NnT \g_csam_font_tl      { latinmodern       }{ \csam@latinmoderntrue }
\newif\ifcsam@libertine    \tl_if_eq:NnT \g_csam_font_tl 	  { libertine         }{ \csam@libertinetrue   }
\newif\ifcsam@palatino     \tl_if_eq:NnT \g_csam_font_tl 	  { palatino          }{ \csam@palatinotrue    }
\newif\ifcsam@draft        \bool_if:NTF  \g_csam_draft_bool   { \csam@drafttrue   }{ \csam@draftfalse 	   }
\newif\ifcsam@sanshdr      \bool_if:NTF  \g_csam_sanshdr_bool { \csam@sanshdrtrue }{ \csam@sanshdrfalse    }

\ExplSyntaxOff

\def\csam@headingfamily{\normalfont}
\ifcsam@sanshdr
	\def\csam@headingfamily{\sffamily}
\fi

\protected\def\csam@sectionfont{\csam@headingfamily\bfseries\Large}
\protected\def\csam@subsectionfont{\csam@headingfamily\bfseries\large}
\protected\def\csam@subsubsectionfont{\csam@headingfamily\bfseries\normalsize}
\protected\def\csam@parheadfont{\csam@headingfamily\bfseries\boldmath}
\protected\def\csam@subparheadfont{\csam@headingfamily\ifcsam@sanshdr\bfseries\else\scshape\fi}
\protected\def\csam@theoremheaderfont{\bfseries}
\protected\def\csam@definitionheaderfont{\bfseries}
\protected\def\csam@remarkheaderfont{\normalfont\scshape}
\protected\def\csam@highlightheaderfont{\normalfont\sffamily}
\protected\def\csam@theorembodyfont{\normalfont}
\protected\def\csam@definitionbodyfont{\normalfont}
\protected\def\csam@remarkbodyfont{\normalfont}
\protected\def\csam@highlightbodyfont{\normalfont}

\def\csam@setdocufont#1#2{\protected\gdef#1{#2}}

\ExplSyntaxOn
\cs_new_protected:Npn \csam_docufont_set:Nn #1#2
{
	\str_case:nnF { #2 }
	{
		{ bold }     { \csam@setdocufont#1{\bfseries} }
		{ boldsans } { \csam@setdocufont#1{\sffamily\bfseries} }
		{ italic }   { \csam@setdocufont#1{\itshape} }
		{ italics }  { \csam@setdocufont#1{\itshape} }
		{ normal }   { \csam@setdocufont#1{\normalfont} }
		{ roman }    { \csam@setdocufont#1{\normalfont} }
		{ sans }     { \csam@setdocufont#1{\sffamily} }
		{ smallcaps }{ \csam@setdocufont#1{\scshape} }
	}
	{ \csam@setdocufont#1{#2} }
}

\cs_new_protected:Npn \csam_docufont_set_pair:NNn #1#2#3
{
	\csam_docufont_set:Nn #1 { #3 }
	\cs_if_exist:NT #2 { \csam_docufont_set:Nn #2 { #3 } }
}

\keys_define:nn { csamsmath / docufont }
{
	definitionbody .code:n = { \csam_docufont_set_pair:NNn \csam@definitionbodyfont \csbk@definitionbodyfont { #1 } } ,
	definitionhdr  .code:n = { \csam_docufont_set_pair:NNn \csam@definitionheaderfont \csbk@definitionheaderfont { #1 } } ,
	defintionhdr   .code:n = { \csam_docufont_set_pair:NNn \csam@definitionheaderfont \csbk@definitionheaderfont { #1 } } ,
	highlightbody  .code:n = { \csam_docufont_set_pair:NNn \csam@highlightbodyfont \csbk@highlightbodyfont { #1 } } ,
	highlighthdr   .code:n = { \csam_docufont_set_pair:NNn \csam@highlightheaderfont \csbk@highlightheaderfont { #1 } } ,
	parhead        .code:n = { \csam_docufont_set_pair:NNn \csam@parheadfont \csbk@parheadfont { #1 } } ,
	parheadfont    .code:n = { \csam_docufont_set_pair:NNn \csam@parheadfont \csbk@parheadfont { #1 } } ,
	remarkbody     .code:n = { \csam_docufont_set_pair:NNn \csam@remarkbodyfont \csbk@remarkbodyfont { #1 } } ,
	remarkhdr      .code:n = { \csam_docufont_set_pair:NNn \csam@remarkheaderfont \csbk@remarkheaderfont { #1 } } ,
	section        .code:n = { \csam_docufont_set:Nn \csam@sectionfont { #1 } } ,
	sections       .code:n = { \csam_docufont_set:Nn \csam@sectionfont { #1 } } ,
	subparhead     .code:n = { \csam_docufont_set_pair:NNn \csam@subparheadfont \csbk@subparheadfont { #1 } } ,
	subparheadfont .code:n = { \csam_docufont_set_pair:NNn \csam@subparheadfont \csbk@subparheadfont { #1 } } ,
	subsection     .code:n = { \csam_docufont_set:Nn \csam@subsectionfont { #1 } } ,
	subsubsection  .code:n = { \csam_docufont_set:Nn \csam@subsubsectionfont { #1 } } ,
	theorembody    .code:n = { \csam_docufont_set_pair:NNn \csam@theorembodyfont \csbk@theorembodyfont { #1 } } ,
	theoremhdr     .code:n = { \csam_docufont_set_pair:NNn \csam@theoremheaderfont \csbk@theoremheaderfont { #1 } } ,
	unknown        .code:n =
		{
			\PackageError{csamsmath}{Unknown~docufont~key~`\l_keys_key_str'}
			{Use~a~documented~\string\docufont~key.}
		} ,
}

\NewDocumentCommand{\docufont}{m}{\keys_set:nn { csamsmath / docufont } { #1 }}
\ExplSyntaxOff

