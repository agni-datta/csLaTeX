%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Broken-reference markers
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage{marginnote}

\providecommand{\csam@colorize}{\color{Firebrick2}}

\newcommand{\csam@brokenrefmark}[1]{%
	\marginnote[
		{\csam@colorize\normalfont\smash{\LARGE$\star$}\,\tiny\sffamily#1}
	]{
		{\csam@colorize\normalfont\smash{\LARGE$\star$}\,\tiny\sffamily#1}
	}%
}

\newif\ifcsam@markundef
\csam@markundeftrue

\xpretocmd{\G@refundefinedtrue}{%
	\ifcsam@markundef
		\csam@brokenrefmark{\@ifundefined{@citeb}{}{\@citeb}}%
	\fi
}{}{}

\let\csam@old@setref\@setref
\renewcommand{\@setref}[3]{%
	\ifx#1\relax\csam@brokenrefmark{#3}\fi
	\csam@markundeffalse
	\csam@old@setref{#1}{#2}{#3}%
	\csam@markundeftrue
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Draft annotations
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\ProvideDocumentCommand{\newguymarker}{m m m}{%
	\ifcsam@draft
		\expandafter\NewDocumentCommand\csname #1\endcsname{m}{%
			\textcolor{#3}{##1\ \textsc{#2}}%
			\marginnote{\textcolor{#3}{\LARGE$\star$}}%
		}%
	\else
		\expandafter\NewDocumentCommand\csname #1\endcsname{m}{}%
	\fi
}

\ifcsam@draft
	\ProvideDocumentCommand{\added}    {m}{\textcolor{OliveGreen}{#1}\marginnote{\textcolor{OliveGreen}{\LARGE$\star$}}}
	\ProvideDocumentCommand{\changed}  {m}{\textcolor{PineGreen}{#1}\marginnote{\textcolor{PineGreen}{\LARGE$\star$}}}
	\ProvideDocumentCommand{\citelater}{m}{\textcolor{WildStrawberry}{[#1]}\marginnote{\textcolor{WildStrawberry}{\LARGE$\star$}}}
	\ProvideDocumentCommand{\fixme}    {m}{\textcolor{OrangeRed}{[\textsc{Fix-me}: #1]}\marginnote{\textcolor{OrangeRed}{\LARGE$\star$}}}
	\ProvideDocumentCommand{\missing}  {m}{\textcolor{Crimson}{#1}\marginnote{\textcolor{Crimson}{\LARGE$\star$}}}
	\ProvideDocumentCommand{\notes}    {m}{\textcolor{ForestGreen}{[\textsc{Note}: #1]}\marginnote{\textcolor{ForestGreen}{\LARGE$\star$}}}
	\ProvideDocumentCommand{\query}    {m}{\textcolor{RoyalPurple}{[\textsc{Query}: #1]}\marginnote{\textcolor{RoyalPurple}{\LARGE$\star$}}}
	\ProvideDocumentCommand{\removed}  {m}{\textcolor{Periwinkle}{\sout{#1}}\marginnote{\textcolor{Periwinkle}{\LARGE$\star$}}}
	\ProvideDocumentCommand{\todo}     {m}{\textcolor{Mahogany}{[\textsc{To-do}: #1]}\marginnote{\textcolor{Mahogany}{\LARGE$\star$}}}
	\ProvideDocumentCommand{\XXX}{O{XXX}}{%
		\marginnote{{\color{PaleVioletRed3}\normalfont$\star$}}%
		\textcolor{PaleVioletRed3}{\sffamily\bfseries[#1]}%
	}
	\IfFileExists{scrtime.sty}{%
		\RequirePackage{scrtime}%
		\RequirePackage{prelim2e}%
		\newcommand{\csam@datetime}{%
			\number\year-\ifnum\month<10 0\fi\number\month-%
			\ifnum\day<10 0\fi\number\day\space\thistime%
		}%
		\RenewDocumentCommand{\PrelimText}{}{%
			\normalfont\scshape\footnotesize\color{DeepPink3}%
			Draft --- {\csam@datetime} --- Not for Distribution.%
		}%
	}{}%
\else
	\ProvideDocumentCommand{\added}     {m}{}
	\ProvideDocumentCommand{\changed}   {m}{}
	\ProvideDocumentCommand{\citelater} {m}{}
	\ProvideDocumentCommand{\fixme}     {m}{}
	\ProvideDocumentCommand{\missing}   {m}{}
	\ProvideDocumentCommand{\notes}     {m}{}
	\ProvideDocumentCommand{\query}     {m}{}
	\ProvideDocumentCommand{\removed}   {m}{}
	\ProvideDocumentCommand{\todo}      {m}{}
	\ProvideDocumentCommand{\XXX}{O{XXX}}{%
		\@latex@error{\string\XXX{} found in final mode — remove all \string\XXX before submission}\@ehd
	}
\fi

