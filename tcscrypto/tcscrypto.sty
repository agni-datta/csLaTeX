\ExplSyntaxOn

\cs_new_protected:Npn \__crypto_define_one:nnnn #1#2#3#4
{
    \bool_if:NTF \g_csCryptoBuiltIn_bool
    {
        \str_if_eq:nnTF {#1#2} {P}
        {\cs_set:cpx {#1#2} {\exp_not:c {#4} {\exp_not:n {#3}}}}
        {\cs_if_free:cTF {#1#2} {\cs_new:cpx {#1#2} {\exp_not:c {#4} {\exp_not:n {#3}}}} {\csCryptoCommandCollision {#1#2}}}
    }
    {\cs_if_free:cT {#1#2} {\cs_new:cpx {#1#2} {\exp_not:c {#4} {\exp_not:n {#3}}}}}
}

\cs_new_protected:Npn \__crypto_parse_pair:w #1/#2\q_stop #3#4 {\__crypto_define_one:nnnn {#3} {#1} {#2} {#4}}

\NewDocumentCommand \cryptoDefineAlgoCSV {m}
{
    \clist_map_inline:nn {#1}
    {
        \__crypto_parse_pair:w ##1\q_stop {} {algostyle}
    }
}

\NewDocumentCommand \cryptoDefineClassCSV {m}
{
    \clist_map_inline:nn {#1}
    {
        \__crypto_parse_pair:w ##1\q_stop {} {funcstyle}
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Complexity CSV Parsing
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \csCryptoMalformedClass #1
{
    \PackageError {tcscrypto} {Malformed~complexity~CSV~entry:~\tl_to_str:n {#1}}
    {Use~Name/Display~or~Name*/ {math~expression};~neither~part~may~be~empty.}
}

\cs_new_protected:Npn \csCryptoMalformedProblem #1
{
    \PackageError {tcscrypto} {Malformed~problem~CSV~entry:~\tl_to_str:n {#1}}
    {Use~Name/Display~or~Name*/ {math~expression};~neither~part~may~be~empty.}
}

\cs_new_protected:Npn \csCryptoParseStyledPair:w #1/#2\q_stop #3#4
{
    \tl_set:Nn \l_csCryptoClassName_tl {#1}
    \tl_trim_spaces:N \l_csCryptoClassName_tl
    \tl_if_blank:nTF {#2} {#4 {#1/#2}}
    {
        \str_if_eq:eeTF {\tl_item:Nn \l_csCryptoClassName_tl {-1}} {*}
        {
            \tl_set:Nx \l_csCryptoClassName_tl {\tl_range:Nnn \l_csCryptoClassName_tl {1} {-2}}
            \tl_if_blank:VTF \l_csCryptoClassName_tl {#4 {#1/#2}}
            {
                \str_if_eq:nnTF {#3} {problemacronymstyle}
                {\exp_args:NnV \__crypto_define_one:nnnn {} \l_csCryptoClassName_tl {#2} {csCryptoProblemExpression}}
                {\exp_args:NnV \__crypto_define_one:nnnn {} \l_csCryptoClassName_tl {#2} {csCryptoExpression}}
            }
        }
        {
            \tl_if_blank:VTF \l_csCryptoClassName_tl {#4 {#1/#2}}
            {\exp_args:NnV \__crypto_define_one:nnnn {} \l_csCryptoClassName_tl {#2} {#3}}
        }
    }
}

\cs_new_protected:Npn \csCryptoParseClassPair:w #1/#2\q_stop
{\csCryptoParseStyledPair:w #1/#2\q_stop {ComplexityFont} {\csCryptoMalformedClass}}

\NewDocumentCommand \cryptoDefineComplexityClassCSV {m}
{
    \clist_map_inline:nn {#1}
    {\tl_if_in:nnTF {##1} {/} {\csCryptoParseClassPair:w ##1\q_stop} {\csCryptoMalformedClass {##1}}}
}

\NewDocumentCommand \cryptoDefineProblemAcronymCSV {m}
{
    \clist_map_inline:nn {#1}
    {
        \tl_if_in:nnTF {##1} {/}
        {\csCryptoParseStyledPair:w ##1\q_stop {problemacronymstyle} {\csCryptoMalformedProblem}}
        {\csCryptoMalformedProblem {##1}}
    }
}

\NewDocumentCommand \cryptoDefineKeyCSV {m}
{
    \clist_map_inline:nn {#1}
    {
        \__crypto_parse_pair:w ##1\q_stop {} {keystyle}
    }
}

\NewDocumentCommand \cryptoDefineSchemeCSV {m}
{
    \clist_map_inline:nn {#1}
    {
        \__crypto_parse_pair:w ##1\q_stop {} {schemestyle}
    }
}

\NewDocumentCommand \cryptoDefineOracleCSV {m}
{
    \clist_map_inline:nn {#1}
    {
        \__crypto_parse_pair:w ##1\q_stop {} {oraclestyle}
    }
}

\NewDocumentCommand \cryptoDefineProbCSV {m}
{
    \clist_map_inline:nn {#1}
    {
        \__crypto_parse_pair:w ##1\q_stop {} {probstyle}
