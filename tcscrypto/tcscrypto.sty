\NewDocumentCommand{\newsequenceofgames}{m}%
{ %
    \newcounter{#1}
    \setcounter{#1}{-1}
    \@ifundefined{sequencename}{\NewExpandableDocumentCommand{\sequencename}{}{#1}}%
    {\RenewExpandableDocumentCommand{\sequencename}{}{#1}}
    \ifx \GameID \undefined
        \NewExpandableDocumentCommand{\GameID}{}{#1}
    \else
        \RenewExpandableDocumentCommand{\GameID}{}{#1}
    \fi
    \ifx \PrevLabel \undefined
        \NewExpandableDocumentCommand{\PrevLabel}{}{\GameID.NULL}
    \else
        \RenewExpandableDocumentCommand{\PrevLabel}{}{\GameID.NULL}
    \fi
    \ifx \ThisLabel \undefined
        \NewExpandableDocumentCommand{\ThisLabel}{}{\GameID.NULL}
    \else
        \RenewExpandableDocumentCommand{\ThisLabel}{}{\GameID.NULL}
    \fi
}

\NewDocumentCommand{\nextgame}{m}%
{ %
    \let \PrevLabel \ThisLabel
    \RenewExpandableDocumentCommand{\ThisLabel}{}{\GameID.#1}
    \refstepcounter{\GameID}%
    \label{\GameID.#1}
    \paragraph
    {%
        Experiment~$\algostyle{Exp}_\arabic{\GameID}.$%
    }
}
\NewDocumentCommand{\nextgamewithref}{m m}%
{ %
    \let \PrevLabel \ThisLabel
    \RenewExpandableDocumentCommand{\ThisLabel}{}{\GameID.#1}
    \refstepcounter{\GameID}%
    \label{\GameID.#1}
    \paragraph
    {Game~\hyperref[#2]{$\algostyle{G}_{\arabic{\GameID}}$}}
}
\NewDocumentCommand{\nextgamewithrefi}{m m m}%
{ %
    \let \PrevLabel \ThisLabel
    \RenewExpandableDocumentCommand{\ThisLabel}{}{\GameID.#1}
    \refstepcounter{\GameID}%
    \label{\GameID.#1}
    \paragraph
    {Game~\hyperref[#2]{$\algostyle{G}_{\arabic{\GameID}.#3}$}}
}

