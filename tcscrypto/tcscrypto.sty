%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Generated Mathematical Alphabets
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

        \NewDocumentCommand {\mbf} {m} {\regex_match:nnTF {\A[a-zA-Z0-9]\Z} {#1} {\mathbf {#1}} {\csCryptoBoldSymbol {#1}}}

        \tl_new:N \l_tcsc_letter_tl

        \int_step_inline:nnn {1} {26}
        {
            \tl_set:Nx \l_tcsc_letter_tl {\int_to_Alph:n {#1}}
            \cs_if_free:cT {adv\l_tcsc_letter_tl}
            {\exp_args:NcV \newcal {adv\l_tcsc_letter_tl} \l_tcsc_letter_tl}
            \cs_if_free:cT {bb\l_tcsc_letter_tl}
            {\cs_new:cpx {bb\l_tcsc_letter_tl} {\exp_not:N \ensuremath {{\exp_not:N \mathbb {\l_tcsc_letter_tl}}}}}
            \cs_if_free:cT {bf\l_tcsc_letter_tl}
            {\cs_new:cpx {bf\l_tcsc_letter_tl} {\exp_not:N \ensuremath {{\exp_not:N \mathbf {\l_tcsc_letter_tl}}}}}
            \cs_if_free:cT {cal\l_tcsc_letter_tl}
            {\cs_new:cpx {cal\l_tcsc_letter_tl} {\exp_not:N \ensuremath {{\exp_not:N \mathcal {\l_tcsc_letter_tl}}}}}
            \cs_if_free:cT {frak\l_tcsc_letter_tl}
            {
                \cs_new:cpx {frak\l_tcsc_letter_tl}
                {\exp_not:N \ensuremath {{\exp_not:N \mathfrak {\l_tcsc_letter_tl}}}}
            }
            \cs_if_free:cT {sf\l_tcsc_letter_tl}
            {\cs_new:cpx {sf\l_tcsc_letter_tl} {\exp_not:N \ensuremath {{\exp_not:N \mathsf {\l_tcsc_letter_tl}}}}}
            \cs_if_free:cT {scr\l_tcsc_letter_tl}
            {\cs_new:cpx {scr\l_tcsc_letter_tl} {\exp_not:N \ensuremath {{\exp_not:N \mathscr {\l_tcsc_letter_tl}}}}}
        }

        \int_step_inline:nnn {1} {26}
        {
            \tl_set:Nx \l_tcsc_letter_tl {\int_to_alph:n {#1}}
            \cs_if_free:cT {bb\l_tcsc_letter_tl}
            {\cs_new:cpx {bb\l_tcsc_letter_tl} {\exp_not:N \ensuremath {{\exp_not:N \mathbb {\l_tcsc_letter_tl}}}}}
            \cs_if_free:cT {bf\l_tcsc_letter_tl}
            {\cs_new:cpx {bf\l_tcsc_letter_tl} {\exp_not:N \ensuremath {{\exp_not:N \mathbf {\l_tcsc_letter_tl}}}}}
            \cs_if_free:cT {cal\l_tcsc_letter_tl}
            {\cs_new:cpx {cal\l_tcsc_letter_tl} {\exp_not:N \ensuremath {{\exp_not:N \mathcal {\l_tcsc_letter_tl}}}}}
            \cs_if_free:cT {frak\l_tcsc_letter_tl}
            {
                \cs_new:cpx {frak\l_tcsc_letter_tl}
                {\exp_not:N \ensuremath {{\exp_not:N \mathfrak {\l_tcsc_letter_tl}}}}
            }
            \cs_if_free:cT {sf\l_tcsc_letter_tl}
            {\cs_new:cpx {sf\l_tcsc_letter_tl} {\exp_not:N \ensuremath {{\exp_not:N \mathsf {\l_tcsc_letter_tl}}}}}
            \cs_if_free:cT {scr\l_tcsc_letter_tl}
            {\cs_new:cpx {scr\l_tcsc_letter_tl} {\exp_not:N \ensuremath {{\exp_not:N \mathscr {\l_tcsc_letter_tl}}}}}
        }

        \int_step_inline:nnn {1} {26}
        {
            \tl_set:Nx \l_tcsc_letter_tl {\int_to_Alph:n {#1}}
            \cs_if_free:cT {Mat\l_tcsc_letter_tl}
            {\cs_new:cpx {Mat\l_tcsc_letter_tl} {\exp_not:N \ensuremath {{\exp_not:N \mathbf {\l_tcsc_letter_tl}}}}}
        }
    }
