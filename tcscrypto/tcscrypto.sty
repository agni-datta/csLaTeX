\ExplSyntaxOn
\cs_new_protected:Npn \csCryptoCommandCollision #1
{
    \PackageError {tcscrypto} {Complexity~command~collision:~\c_backslash_str #1}
    {Remove~or~rename~the~earlier~definition.~Customize~the~command~after~loading~tcscrypto.}
}
\clist_map_inline:nn
{
    CVP,
    ComplexityClassStyle,
    ComplexityFont,
    E,
    KT,
    MOD,
    MaxSAT,
    Mod,
    SAT,
    class,
    co,
    defaultL,
    defaultP,
    defaultS,
    func,
    lang,
    llog,
    newclass,
    newfunc,
    newlang,
    parity,
    qlog,
    qpoly,
    renewclass,
    renewfunc,
    renewlang,
}
{\cs_if_free:cF {#1} {\csCryptoCommandCollision {#1}}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Complexity Styles
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new:Npn \ComplexityClassStyle #1
{
    \str_case:Vn \g_tcsc_classfont_tl
    {
        {sansbold}
        {
            \cs_if_exist:NTF \symbfsfup
            {\symbfsfup {#1}}
            {\boldsymbol {\mathsf {#1}}}
        }
        {sans} {\mathsf {#1}}
        {bold} {\mathbf {#1}}
    }
}

\cs_new:Npn \ComplexityFont #1
{
    {
        \ensuremath
        {
            \if@tcscrypto@small
                \tcs@possiblymakesmaller {\ComplexityClassStyle {#1}}
            \else
                \ComplexityClassStyle {#1}
            \fi
        }
    }
}
\cs_new:Npn \lang #1 {{\ensuremath {\algostyle {#1}}}}
\cs_new:Npn \func #1 {{\ensuremath {\algostyle {#1}}}}
\cs_new:Npn \class #1 {\ComplexityFont {#1}}

\cs_new:Npn \newclass #1#2 {\newcommand {#1} {\ComplexityFont {#2}}}
\cs_new:Npn \renewclass #1#2 {\renewcommand {#1} {\ComplexityFont {#2}}}
\cs_new:Npn \newlang #1#2 {\newcommand {#1} {\lang {#2}}}
\cs_new:Npn \renewlang #1#2 {\renewcommand {#1} {\lang {#2}}}
\cs_new:Npn \newfunc #1#2 {\newcommand {#1} {\func {#2}}}
\cs_new:Npn \renewfunc #1#2 {\renewcommand {#1} {\func {#2}}}
\cs_new:Npn \co #1 {\ComplexityFont {co}#1}

\cs_new:Npn \parity {\oplus}

