%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Primitive CSV Parsing
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \csCryptoMalformedPrimitive #1
{
    \PackageError {tcscrypto} {Malformed~primitive~CSV~entry:~\tl_to_str:n {#1}}
    {Use~Name,~Name/Display,~Family/{operations},~or~Family*/{prefix}/{operations}.}
}

\NewDocumentCommand \cryptoDefinePrimitiveCSV {m}
{
    \clist_map_inline:nn {#1}
    {
        \tl_if_in:nnTF {##1} {/}
        {\csCryptoParseStyledPair:w ##1\q_stop {schemestyle} {\csCryptoMalformedPrimitive}}
        {\__crypto_define_one:nnnn {} {##1} {##1} {schemestyle}}
    }
}

\cs_new_protected:Npn \csCryptoDefineExpression:nnn #1#2#3
{
    \tl_if_blank:nTF {#1} {\csCryptoMalformedPrimitive {#1/#2}}
    {
        \tl_if_blank:nTF {#2} {\csCryptoMalformedPrimitive {#1/#2}}
        {
            \cs_if_free:cTF {#1}
            {\exp_args:Nc \NewDocumentCommand {#1} {} {#2}}
            {\IfBooleanT {#3} {\csCryptoCommandCollision {#1}}}
        }
    }
}

\cs_new_protected:Npn \csCryptoParseExpression:w #1/#2\q_stop #3
{\csCryptoDefineExpression:nnn {#1} {#2} {#3}}

\NewDocumentCommand \cryptoDefineExpressionCSV {s m}
{
    \clist_map_inline:nn {#2}
    {
        \tl_if_in:nnTF {##1} {/}
        {\csCryptoParseExpression:w ##1\q_stop {#1}}
        {\csCryptoMalformedPrimitive {##1}}
    }
}

\cs_new_protected:Npn \csCryptoDefineOperation:nnnnn #1#2#3#4#5
{
    \tl_if_blank:nTF {#1} {\csCryptoMalformedPrimitive {#2/#1/#4}}
    {
        \tl_if_blank:nTF {#4} {\csCryptoMalformedPrimitive {#2/#1/#4}}
        {\csCryptoDefineExpression:nnn {#2#1} {#3.\funct{#4}} {#5}}
    }
}

\cs_new_protected:Npn \csCryptoDefineStyledOperation:nnnnn #1#2#3#4#5
{
    \tl_if_blank:nTF {#1} {\csCryptoMalformedPrimitive {#2/#1/#4}}
    {
        \tl_if_blank:nTF {#4} {\csCryptoMalformedPrimitive {#2/#1/#4}}
        {\csCryptoDefineExpression:nnn {#2#1} {#3.#4} {#5}}
    }
}

\cs_new_protected:Npn \csCryptoParseOperation:w #1/#2\q_stop #3#4#5
{
    \str_if_eq:eeTF {\tl_item:nn {#1} {-1}} {*}
    {
        \exp_args:Ne \csCryptoDefineStyledOperation:nnnnn
        {\tl_range:nnn {#1} {1} {-2}} {#3} {#4} {#2} {#5}
    }
    {\csCryptoDefineOperation:nnnnn {#1} {#3} {#4} {#2} {#5}}
}

\cs_new_protected:Npn \csCryptoMapOperations:nnnn #1#2#3#4
{
    \tl_if_blank:nTF {#1} {\csCryptoMalformedPrimitive {#1/#3}}
    {
        \tl_if_blank:nTF {#3} {\csCryptoMalformedPrimitive {#1/#3}}
        {
            \clist_map_inline:nn {#3}
            {
                \tl_if_in:nnTF {##1} {/}
                {\csCryptoParseOperation:w ##1\q_stop {#1} {#2} {#4}}
                {\csCryptoDefineOperation:nnnnn {##1} {#1} {#2} {##1} {#4}}
            }
        }
    }
}

\cs_new_protected:Npn \csCryptoParseOperationOwner:w #1/#2\q_stop #3#4
{
    \tl_if_blank:nTF {#1} {\csCryptoMalformedPrimitive {#3/#1/#2}}
    {\csCryptoMapOperations:nnnn {#3} {#1} {#2} {#4}}
}

\cs_new_protected:Npn \csCryptoParseOperationOwner:nnn #1#2#3
{\csCryptoParseOperationOwner:w #2\q_stop {#1} {#3}}

\cs_new_protected:Npn \csCryptoParseOperationFamily:w #1/#2\q_stop #3
{
    \str_if_eq:eeTF {\tl_item:nn {#1} {-1}} {*}
    {
        \tl_if_in:nnTF {#2} {/}
        {
            \exp_args:Ne \csCryptoParseOperationOwner:nnn
            {\tl_range:nnn {#1} {1} {-2}} {#2} {#3}
        }
        {\csCryptoMalformedPrimitive {#1/#2}}
    }
    {\csCryptoMapOperations:nnnn {#1} {\use:c {#1}} {#2} {#3}}
}

\NewDocumentCommand \cryptoDefinePrimitiveOperationsCSV {s m}
{
    \clist_map_inline:nn {#2}
    {
        \tl_if_in:nnTF {##1} {/}
        {\csCryptoParseOperationFamily:w ##1\q_stop {#1}}
        {\csCryptoMalformedPrimitive {##1}}
    }
}

