\ExplSyntaxOn
\cs_new_protected:Npn \csCryptoRejectComplexity
{
    \PackageError {tcscrypto} {Do~not~load~complexity~with~tcscrypto}
    {tcscrypto~includes~the~complete~complexity~interface.~Remove~the~separate~package~load.}
}
\@ifpackageloaded {complexity} {\csCryptoRejectComplexity}
{
    \AddToHook {package/complexity/before} {\csCryptoRejectComplexity}
}

\@ifpackageloaded {csmath} {}
{
    \AddToHook {package/csmath/before}
    {
        \PackageError {tcscrypto} {Load~csmath~before~tcscrypto}
        {Load~csmath~first,~then~tcscrypto.}
    }
}
