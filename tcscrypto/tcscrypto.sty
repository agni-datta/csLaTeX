\NewDocumentCommand{\manuscriptmark}{r[]}%
{%
    \ifstrequal{#1}{pre}%
    {%
        \thanks
        {%
            This manuscript is a preliminary preprint. It contains complete proofs and extended technical material, some of which may be omitted or abridged in a conference version. The manuscript has not been finalized; its content and presentation may change. Any separately published version is governed by the copyright, %
            license, and publication terms applicable to that version.%
        }%
    }%
    {%
        \ifstrequal{#1}{final}%
        {%
            \thanks
            {%
                This manuscript is the full version of the work. It contains complete proofs, extended technical material, and supplementary results that may be omitted or abridged in an abbreviated conference version. Any separately published version is governed by the copyright, %
                license, and publication terms applicable to that version. Please see the changelog section for updates.%
            }%
        }%
        {%
            \PackageError{tcscrypto}{Unknown manuscript mark `#1'}%
            {%
                Use \string \manuscriptmark [pre] for a preliminary preprint or \string \manuscriptmark [final] for a full version.%
            }%
        }%
    }%
}

