	}{}
\fi

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Theorem environments
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\ifeudoxtheorems
	\RequirePackage{amsthm}

	\newtheoremstyle{theoremlike}
	{2.5pt}{2.5pt}{\itshape}{1.75em}{\scshape}{.}{0.5em}{}
	\newtheoremstyle{definitionlike}
	{2.5pt}{2.5pt}{\normalfont}{1.75em}{\scshape}{.}{0.5em}{}
	\newtheoremstyle{remarklike}
	{2.5pt}{2.5pt}{\normalfont}{1.75em}{\scshape}{.}{0.5em}{}

	\NewDocumentCommand{\edxnewtheoremsection}{m m}{\newtheorem{#1}{#2}[section]}
	\NewDocumentCommand{\edxnewtheoremsibling}{m m}{\newtheorem{#1}[theorem]{#2}}
	\NewDocumentCommand{\edxnewtheoremstar}{m m}{\newtheorem*{#1}{#2}}

	\theoremstyle{theoremlike}
	\edxnewtheoremsection{theorem}{Theorem}
	\edxnewtheoremsibling{assertion}{Assertion}
	\edxnewtheoremsibling{assumption}{Assumption}
	\edxnewtheoremsibling{axiom}{Axiom}
	\edxnewtheoremsibling{claim}{Claim}
	\edxnewtheoremsibling{conclusion}{Conclusion}
	\edxnewtheoremsibling{conjecture}{Conjecture}
	\edxnewtheoremsibling{corollary}{Corollary}
	\edxnewtheoremsibling{criterion}{Criterion}
	\edxnewtheoremsibling{fact}{Fact}
	\edxnewtheoremsibling{folklore}{Folklore}
	\edxnewtheoremsibling{hypothesis}{Hypothesis}
	\edxnewtheoremsibling{informaltheorem}{Informal Theorem}
	\edxnewtheoremsibling{lemma}{Lemma}
	\edxnewtheoremsibling{metatheorem}{Meta Theorem}
	\edxnewtheoremsibling{observation}{Observation}
	\edxnewtheoremsibling{openproblem}{Open Problem}
	\edxnewtheoremsibling{postulate}{Postulate}
	\edxnewtheoremsibling{property}{Property}
	\edxnewtheoremsibling{proposition}{Proposition}

	\theoremstyle{definitionlike}
	\edxnewtheoremsibling{application}{Application}
	\edxnewtheoremsibling{construction}{Construction}
	\edxnewtheoremsibling{convention}{Convention}
	\edxnewtheoremsibling{definition}{Definition}
	\edxnewtheoremsibling{example}{Example}
	\edxnewtheoremsibling{experiment}{Experiment}
	\edxnewtheoremsibling{notation}{Notation}
	\edxnewtheoremsibling{problem}{Problem}
	\edxnewtheoremsibling{protocol}{Protocol}
	\edxnewtheoremsibling{result}{Result}
	\edxnewtheoremsibling{solution}{Solution}
	\edxnewtheoremsibling{step}{Step}

	\theoremstyle{remarklike}
	\edxnewtheoremsibling{commentary}{Commentary}
	\edxnewtheoremsibling{discussion}{Discussion}
	\edxnewtheoremsibling{exercise}{Exercise}
	\edxnewtheoremsibling{guideline}{Guideline}
	\edxnewtheoremsibling{highlight}{Highlight}
	\edxnewtheoremsibling{important}{Important}
	\edxnewtheoremsibling{insight}{Insight}
	\edxnewtheoremsibling{keypoint}{Key Point}
	\edxnewtheoremsibling{motivation}{Motivation}
	\edxnewtheoremsibling{notationabuse}{Notation Abuse}
	\edxnewtheoremsibling{note}{Note}
	\edxnewtheoremsibling{question}{Question}
	\edxnewtheoremsibling{recall}{Recall}
	\edxnewtheoremsibling{remark}{Remark}
	\edxnewtheoremsibling{summary}{Summary}
	\edxnewtheoremsibling{syntax}{Syntax}
	\edxnewtheoremsibling{takeaway}{Takeaway}
	\edxnewtheoremsibling{tip}{Tip}
	\edxnewtheoremsibling{warning}{Warning}

	\theoremstyle{theoremlike}
	\edxnewtheoremstar{theorem*}{Theorem}
	\edxnewtheoremstar{lemma*}{Lemma}
	\edxnewtheoremstar{corollary*}{Corollary}
	\edxnewtheoremstar{hypothesis*}{Hypothesis}
	\edxnewtheoremstar{claim*}{Claim}
	\edxnewtheoremstar{conjecture*}{Conjecture}
	\edxnewtheoremstar{informaltheorem*}{Informal Theorem}

	\theoremstyle{remarklike}
	\edxnewtheoremstar{openproblem*}{Open Problem}
	\edxnewtheoremstar{syntax*}{Syntax}

	\ProvideDocumentCommand{\SetQEDSymbol}{m}{\setqedsymbol{#1}}
	\ProvideDocumentCommand{\setqedsymbol}{m}{\renewcommand{\qedsymbol}{#1}}

	\NewDocumentEnvironment{proofsketch}{o}
	{
		\IfNoValueTF{#1}
		{ \begin{proof}[Proof~(Sketch)] }
		{ \begin{proof}[Proof~(Sketch~#1)] }
	}
	{ \end{proof} }
	\NewDocumentEnvironment{proofidea}{o}
	{
		\IfNoValueTF{#1}
		{ \begin{proof}[Proof~(Idea)] }
		{ \begin{proof}[Proof~(Idea~#1)] }
	}
	{ \end{proof} }
	\NewDocumentEnvironment{proofofclaim}{o}
	{
		\IfNoValueTF{#1}
		{ \begin{proof}[Proof~of~Claim] }
		{ \begin{proof}[Proof~of~Claim~(#1)] }
	}
	{ \end{proof} }
\fi

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Cross-references (zref-clever)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage{zref-clever}
\ifeudoxsiam\else
	\RequirePackage{zref-vario}
\fi
\zcsetup{
	cap        = true,
	noabbrev,
	nameinlink = true,
	lang       = english
}
\zcRefTypeSetup{section}{
	Name-sg = \textsection,
	name-sg = \textsection,
	Name-pl = \textsection\textsection,
