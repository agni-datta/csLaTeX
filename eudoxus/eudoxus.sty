\box_new:N \l_csEudoxTarget_box
\int_new:N \g_csEudoxTarget_int
\cs_new_protected:Npn \csEudoxPrepareTarget
{
    \cs_if_exist:NT \crefalias
    {
        \cs_if_exist:NT \MakeLinkTarget
        {
            \cs_set_eq:NN \csEudoxSavedRefstepcounter \refstepcounter
            \RenewDocumentCommand \refstepcounter {om}
            {
                \cs_set_eq:NN \refstepcounter \csEudoxSavedRefstepcounter
                \LinkTargetOff
                \IfNoValueTF {##1}
                {
                    \refstepcounter {##2}
                }
                {
                    \refstepcounter [##1] {##2}
                }
                \LinkTargetOn
                \int_gincr:N \g_csEudoxTarget_int
                \hbox_set:Nn \l_csEudoxTarget_box
                {
                    \MakeLinkTarget *
                    {
                        eudoxus.statement.\int_use:N \g_csEudoxTarget_int
                    }
                }
                \bool_if:NTF \g_csEudoxSiam_bool
                {
                    \AddToHookNext {cmd/item/before}
                    {
                        \AddToHookNext {para/begin}
                        {
                            \box_use_drop:N \l_csEudoxTarget_box
                        }
                    }
                }
                {
                    \AddToHookNext {para/begin}
                    {
                        \box_use_drop:N \l_csEudoxTarget_box
                    }
                }
            }
        }
    }
}

