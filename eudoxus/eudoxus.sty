%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Options
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_new:N \g_eudox_math_bool
\bool_new:N \g_eudox_theorems_bool
\bool_new:N \g_eudox_tcs_bool
\bool_new:N \g_eudox_layout_bool
\bool_new:N \g_eudox_titlepatch_bool
\bool_new:N \g_eudox_fonts_bool
\bool_new:N \g_eudox_pazobiolinum_bool
\bool_new:N \g_eudox_epigraph_bool
\bool_new:N \g_eudox_hacks_bool
\bool_new:N \g_eudox_amshacks_bool
\bool_new:N \g_eudox_siam_bool

\keys_define:nn { eudoxus }
{
	nomath     .code:n  	= { \bool_gset_false:N \g_eudox_math_bool
			\bool_gset_false:N \g_eudox_theorems_bool
			\bool_gset_false:N \g_eudox_tcs_bool } ,
	fonts      .code:n   = { \bool_gset_true:N  \g_eudox_fonts_bool
			\bool_gset_false:N \g_eudox_pazobiolinum_bool } ,
	nofonts    .code:n   = { \bool_gset_false:N \g_eudox_fonts_bool
			\bool_gset_false:N \g_eudox_pazobiolinum_bool } ,
	pazobiolinum .code:n = { \bool_gset_false:N \g_eudox_fonts_bool
			\bool_gset_true:N  \g_eudox_pazobiolinum_bool } ,
	nopazobiolinum .code:n = { \bool_gset_true:N  \g_eudox_fonts_bool
			\bool_gset_false:N \g_eudox_pazobiolinum_bool } ,
	notheorems .code:n  	= { \bool_gset_false:N \g_eudox_theorems_bool } ,
	tcs        .code:n  	= { \bool_gset_true:N  \g_eudox_tcs_bool } ,
	notcs      .code:n  	= { \bool_gset_false:N \g_eudox_tcs_bool } ,
	nolayout   .code:n  	= { \bool_gset_false:N \g_eudox_layout_bool } ,
	epigraph   .code:n   = { \bool_gset_true:N  \g_eudox_epigraph_bool } ,
	noepigraph .code:n   = { \bool_gset_false:N \g_eudox_epigraph_bool } ,
	hacks      .code:n   = { \bool_gset_true:N  \g_eudox_hacks_bool } ,
	nohacks    .code:n   = { \bool_gset_false:N \g_eudox_hacks_bool } ,
	amshacks   .code:n   = { \bool_gset_true:N  \g_eudox_amshacks_bool } ,
	noamshacks .code:n   = { \bool_gset_false:N \g_eudox_amshacks_bool } ,
	siam       .code:n   = { \bool_gset_true:N  \g_eudox_siam_bool
			\bool_gset_false:N \g_eudox_layout_bool
			\bool_gset_false:N \g_eudox_titlepatch_bool
			\bool_gset_false:N \g_eudox_fonts_bool
			\bool_gset_false:N \g_eudox_pazobiolinum_bool
			\bool_gset_false:N \g_eudox_theorems_bool
			\bool_gset_false:N \g_eudox_hacks_bool
			\bool_gset_false:N \g_eudox_amshacks_bool } ,
	nosiam     .code:n   = { \bool_gset_false:N \g_eudox_siam_bool } ,
	titlepatch .code:n  	= { \bool_gset_true:N  \g_eudox_titlepatch_bool } ,
	notitlepatch .code:n 	= { \bool_gset_false:N \g_eudox_titlepatch_bool } ,
	unknown    .code:n  	= { \PackageWarning{eudoxus}{Unknown~option~`#1'} } ,
}

\bool_gset_true:N  \g_eudox_math_bool
\bool_gset_true:N  \g_eudox_theorems_bool
\bool_gset_false:N \g_eudox_tcs_bool
\bool_gset_true:N  \g_eudox_layout_bool
\bool_gset_false:N \g_eudox_titlepatch_bool
\bool_gset_true:N  \g_eudox_fonts_bool
\bool_gset_false:N \g_eudox_pazobiolinum_bool
\bool_gset_false:N \g_eudox_epigraph_bool
\bool_gset_false:N \g_eudox_hacks_bool
\bool_gset_false:N \g_eudox_amshacks_bool
\bool_gset_false:N \g_eudox_siam_bool

\ProcessKeysOptions { eudoxus }

\bool_if:NF \g_eudox_math_bool
{
	\bool_gset_false:N \g_eudox_theorems_bool
	\bool_gset_false:N \g_eudox_tcs_bool
	\bool_gset_false:N \g_eudox_pazobiolinum_bool
}

\newif\ifeudoxmath     		\bool_if:NTF \g_eudox_math_bool     	{ \eudoxmathtrue     	 } { \eudoxmathfalse     	}
\newif\ifeudoxtheorems 		\bool_if:NTF \g_eudox_theorems_bool 	{ \eudoxtheoremstrue 	 } { \eudoxtheoremsfalse 	}
\newif\ifeudoxtcs      		\bool_if:NTF \g_eudox_tcs_bool      	{ \eudoxtcstrue      	 } { \eudoxtcsfalse      	}
\newif\ifeudoxlayout   		\bool_if:NTF \g_eudox_layout_bool   	{ \eudoxlayouttrue   	 } { \eudoxlayoutfalse   	}
\newif\ifeudoxtitlepatch 	\bool_if:NTF \g_eudox_titlepatch_bool 	{ \eudoxtitlepatchtrue 	 } { \eudoxtitlepatchfalse  }
\newif\ifeudoxfonts   		\bool_if:NTF \g_eudox_fonts_bool   		{ \eudoxfontstrue    	 } { \eudoxfontsfalse    	}
\newif\ifeudoxpazobiolinum 	\bool_if:NTF \g_eudox_pazobiolinum_bool { \eudoxpazobiolinumtrue } { \eudoxpazobiolinumfalse}
\newif\ifeudoxepigraph    	\bool_if:NTF \g_eudox_epigraph_bool    	{ \eudoxepigraphtrue   	 } { \eudoxepigraphfalse   	}
\newif\ifeudoxhacks       	\bool_if:NTF \g_eudox_hacks_bool       	{ \eudoxhackstrue      	 } { \eudoxhacksfalse      	}
\newif\ifeudoxamshacks    	\bool_if:NTF \g_eudox_amshacks_bool    	{ \eudoxamshackstrue   	 } { \eudoxamshacksfalse   	}
\newif\ifeudoxsiam        	\bool_if:NTF \g_eudox_siam_bool        	{ \eudoxsiamtrue       	 } { \eudoxsiamfalse       	}

\ExplSyntaxOff
