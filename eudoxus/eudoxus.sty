\seq_new:N \g_csEudoxFamilies_seq
\int_new:N \g_csEudoxStatement_int
\cs_new_protected:Npn \csEudoxFamilyBegin #1
{
    \csEudoxPrepareTarget
    \cs_if_exist:NT \crefalias
    {
        \crefalias {theorem} {#1}
    }
    \cs_if_exist:NT \zcsetup
    {
        \zcsetup
        {
            countertype = {theorem = #1}
        }
    }
}

\cs_new_protected:Npn \csEudoxFamilyNames #1#2#3
{
    \cs_if_exist:NT \crefname
    {
        \cs_if_exist:cF {cref@#1@name}
        {
            \exp_args:Neee \crefname
            {
                \exp_not:n {#1}
            }
            {
                \text_lowercase:n {#2}
            }
            {
                \text_lowercase:n {#3}
            }
        }
        \cs_if_exist:cF {Cref@#1@name}
        {
            \Crefname {#1} {#2} {#3}
        }
    }
    \cs_if_exist:NT \zcRefTypeSetup
    {
        \zcLanguageSetup {english}
        {
            type = #1,
            Name-sg = {#2},
            name-sg =
                {
                    \text_lowercase:n {#2}
                },
            Name-pl = {#3},
            name-pl =
                {
                    \text_lowercase:n {#3}
                }
        }
    }
}

\cs_new_protected:Npn \csEudoxRegisterFamily #1#2#3
{
    \seq_gput_right:Nn \g_csEudoxFamilies_seq
    {
        \csEudoxFamilyNames {#1} {#2} {#3}
    }
    \AddToHook {env/#1/begin} [eudoxus/type]
    {
        \csEudoxFamilyBegin {#1}
    }
    \bool_if:NF \g_csEudoxSiam_bool
    {
        \AddToHook {env/#1/begin} [eudoxus/identity]
        {
            \int_gincr:N \g_csEudoxStatement_int
        }
    }
}

\cs_new_protected:Npn \csEudoxDeclareFamily #1#2#3
{
    \bool_if:NTF \g_csEudoxSiam_bool
    {
        \cs_if_exist:cF {#1}
        {
            \tl_if_eq:NnTF \l_csEudoxFamilyStyle_tl {theoremlike}
            {
                \newsiamthm {#1} {#2}
            }
            {
                \newsiamremark {#1} {#2}
            }
        }
    }
    {
        \cs_if_exist:cTF {#1}
        {
            \csEudoxError {Theorem~environment~#1~already~exists;~select~theorems=inherit.}
        }
        {
            \str_if_eq:nnTF {#1} {theorem}
            {
                \tl_if_eq:cnTF {g_csEudox_numberwithin_tl} {section}
                {
                    \newtheorem {theorem} {Theorem} [section]
                }
                {
                    \newtheorem {theorem} {Theorem}
                }
            }
            {
                \newtheorem {#1} [theorem] {#2}
            }
        }
    }
    \csEudoxRegisterFamily {#1} {#2} {#3}
}
\tl_new:N \l_csEudoxFamilyStyle_tl
\cs_new_protected:Npn \csEudoxDeclareGroup #1#2
{
    \tl_set:Nn \l_csEudoxFamilyStyle_tl {#1}
    \bool_if:NF \g_csEudoxSiam_bool
    {
        \theoremstyle {#1}
    }
    \clist_map_inline:nn {#2}
    {
        \csEudoxDeclareEntry ##1\q_stop
    }
}

\cs_new_protected:Npn \csEudoxDeclareEntry #1/#2/#3\q_stop
{
    \csEudoxDeclareFamily {#1} {#2} {#3}
}

\cs_new_protected:Npn \csEudoxDeclareStar #1#2#3
{
    \cs_if_exist:cF {#1}
    {
        \bool_if:NTF \g_csEudoxSiam_bool
        {
            \group_begin: \theoremstyle {nonumberplain}
            \theoremheaderfont
            {
                \normalfont \scshape
            }
            \theorembodyfont {\normalfont}
            \theoremsymbol {}
            \newtheorem * {#1} {#2}
            \group_end:
        }
        {
            \theoremstyle {#3}
            \newtheorem * {#1} {#2}
        }
    }
}
\tl_if_eq:cnT {g_csEudox_theorems_tl} {extended}
{
    \bool_if:NF \g_csEudoxSiam_bool
    {
        \clist_map_inline:nn
        {
            theoremlike,
            definitionlike,
            remarklike
        }
        {
            \newtheoremstyle {#1} {\g_csEudoxTheoremSkip_tl} {\g_csEudoxTheoremSkip_tl}
            {
                \str_if_eq:nnTF {#1} {theoremlike} {\itshape} {\normalfont}
            } {1.75em} {\scshape} {.} {.5em} {}
        }
    }
    \csEudoxDeclareGroup {theoremlike}
    {
        theorem/Theorem/Theorems,
        assertion/Assertion/Assertions,
        assumption/Assumption/Assumptions,
        axiom/Axiom/Axioms,
        claim/Claim/Claims,
        conclusion/Conclusion/Conclusions,
        conjecture/Conjecture/Conjectures,
        corollary/Corollary/Corollaries,
        criterion/Criterion/Criteria,
        fact/Fact/Facts,
        folklore/Folklore/Folklores,
        hypothesis/Hypothesis/Hypotheses,
        informaltheorem/Informal~Theorem/Informal~Theorems,
        lemma/Lemma/Lemmas,
        metatheorem/Meta~Theorem/Meta~Theorems,
        observation/Observation/Observations,
        openproblem/Open~Problem/Open~Problems,
        postulate/Postulate/Postulates,
        property/Property/Properties,
        proposition/Proposition/Propositions
    }
    \csEudoxDeclareGroup {definitionlike}
    {
        application/Application/Applications,
        construction/Construction/Constructions,
        convention/Convention/Conventions,
        definition/Definition/Definitions,
        example/Example/Examples,
        experiment/Experiment/Experiments,
        notation/Notation/Notations,
        problem/Problem/Problems,
        protocol/Protocol/Protocols,
        result/Result/Results,
        solution/Solution/Solutions,
        step/Step/Steps
    }
    \csEudoxDeclareGroup {remarklike}
    {
        commentary/Commentary/Commentaries,
        discussion/Discussion/Discussions,
        exercise/Exercise/Exercises,
        guideline/Guideline/Guidelines,
        highlight/Highlight/Highlights,
        important/Important/Importants,
        insight/Insight/Insights,
        keypoint/Key~Point/Key~Points,
        motivation/Motivation/Motivations,
        notationabuse/Notation~Abuse/Notation~Abuses,
        note/Note/Notes,
        question/Question/Questions,
        recall/Recall/Recalls,
        remark/Remark/Remarks,
        summary/Summary/Summaries,
        syntax/Syntax/Syntaxes,
        takeaway/Takeaway/Takeaways,
        tip/Tip/Tips,
        warning/Warning/Warnings
    }
    \bool_if:NF \g_csEudoxSiam_bool
    {
        \cs_set:Npn \theHtheorem
        {
            edx.\int_use:N \g_csEudoxStatement_int
        }
    }
    \csEudoxDeclareStar {theorem*} {Theorem} {theoremlike}
    \csEudoxDeclareStar {lemma*} {Lemma} {theoremlike}
    \csEudoxDeclareStar {corollary*} {Corollary} {theoremlike}
    \csEudoxDeclareStar {hypothesis*} {Hypothesis} {theoremlike}
    \csEudoxDeclareStar {claim*} {Claim} {theoremlike}
    \csEudoxDeclareStar {conjecture*} {Conjecture} {theoremlike}
    \csEudoxDeclareStar {informaltheorem*} {Informal~Theorem} {theoremlike}
    \csEudoxDeclareStar {openproblem*} {Open~Problem} {remarklike}
    \csEudoxDeclareStar {syntax*} {Syntax} {remarklike}
}
\bool_if:NT \g_csEudoxSiam_bool
{
    \tl_if_eq:cnT {g_csEudox_theorems_tl} {inherit}
    {
        \csEudoxRegisterFamily {theorem} {Theorem} {Theorems}
        \csEudoxRegisterFamily {lemma} {Lemma} {Lemmas}
        \csEudoxRegisterFamily {corollary} {Corollary} {Corollaries}
        \csEudoxRegisterFamily {proposition} {Proposition} {Propositions}
        \csEudoxRegisterFamily {definition} {Definition} {Definitions}
    }
}

\cs_new_protected:Npn \csEudoxConfigureReferences
{
    \seq_use:Nn \g_csEudoxFamilies_seq {}
}
\bool_if:NT \g_csEudoxSiam_bool
{
    \clist_map_inline:nn
    {
        theorem*,
        lemma*,
        corollary*,
        hypothesis*,
        claim*,
        conjecture*,
        informaltheorem*,
        openproblem*,
