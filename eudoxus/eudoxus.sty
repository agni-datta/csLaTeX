    }
    {
        \cs_if_exist:cT {#1}
        {
            \AddToHook {env/#1/begin}
            {
                \PackageWarning {eudoxus} {SIAM~owns~#1;~its~native~starred~form~advances~the~shared~counter}
            }
        }
    }
}
\csEudoxConfigureReferences
\@ifpackageloaded {cleveref} {}
{
