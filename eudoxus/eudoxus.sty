% Paragraph headings
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\ProvideDocumentCommand{\edxsectionheadingfont}{}{\sffamily\bfseries}
\ProvideDocumentCommand{\edxparheadingfont}{}{\sffamily\bfseries\boldmath}
\ProvideDocumentCommand{\edxsubparheadingfont}{}{\sffamily\bfseries}
\ProvideDocumentCommand{\edxdocumenttitlefont}{}{\sffamily\bfseries}

\ifeudoxtitlepatch
	\allsectionsfont{\edxsectionheadingfont}
	\AtBeginDocument{%
		\@ifundefined{@maketitle}
		{}
		{%
			\patchcmd{\@maketitle}
			{\LARGE \@title}
			{\LARGE\edxdocumenttitlefont \@title}
			{}{}%
			\patchcmd{\@maketitle}
			{\LARGE\@title}
			{\LARGE\edxdocumenttitlefont\@title}
			{}{}%
		}%
		\@ifundefined{@settitle}
		{}
		{%
			\patchcmd{\@settitle}
			{\normalfont\LARGE\bfseries}
			{\normalfont\LARGE\edxdocumenttitlefont}
			{}{}%
		}%
	}%
\fi

\newif\ifedxhaspunct

\def\edxcheckpunct#1{%
	\if\relax\detokenize{#1}\relax\else\edxhaspuncttrue\fi
}

\def\edx@checkdot#1.\edxsep#2\edxend{\edxcheckpunct{#2}}
\def\edx@checkquestion#1?\edxsep#2\edxend{\edxcheckpunct{#2}}
\def\edx@checkexclam#1!\edxsep#2\edxend{\edxcheckpunct{#2}}
\def\edx@checkcolon#1:\edxsep#2\edxend{\edxcheckpunct{#2}}

\NewDocumentCommand{\edxappendpunct}{m}{%
	\edxhaspunctfalse%
	\edx@checkdot#1\edxsep.\edxsep\edxend%
	\edx@checkquestion#1\edxsep?\edxsep\edxend%
	\edx@checkexclam#1\edxsep!\edxsep\edxend%
	\edx@checkcolon#1\edxsep:\edxsep\edxend%
	#1\ifedxhaspunct\else.\fi%
}

\NewDocumentCommand{\edxeatnewline}{}{%
	\begingroup\catcode13=10\endgroup
}

\NewDocumentCommand{\parhead}{m}{%
	\par\smallskip\noindent
	\ifeudoxtitlepatch
	{\edxparheadingfont\ignorespaces\edxappendpunct{#1}}%
	\else
	\textsc{\ignorespaces\edxappendpunct{#1}}%
	\fi
	\hskip 0.30em
	\ignorespaces
}

\NewDocumentCommand{\subparhead}{m}{%
	\par\smallskip\noindent
	\ifeudoxtitlepatch
	{\edxsubparheadingfont\ignorespaces\edxappendpunct{#1}}%
	\else
	\textsc{\ignorespaces\edxappendpunct{#1}}%
	\fi
	\hskip 0.30em
	\ignorespaces
}

\AtBeginDocument{%
	\RenewDocumentCommand{\paragraph}  {m}{\parhead{#1}}%
	\RenewDocumentCommand{\subparagraph}{m}{\subparhead{#1}}%
}

