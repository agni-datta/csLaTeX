%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Compatibility Guards
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\msg_new:nnn {eudoxus} {engine} {eudoxus~requires~pdfLaTeX.~LuaLaTeX~and~XeLaTeX~are~unsupported.}
\sys_if_engine_pdftex:F
{
    \msg_fatal:nn {eudoxus} {engine}
}

\msg_new:nnn {eudoxus} {error} {#1}
\int_compare:nNnF {\pdfoutput}> {0}
    {
        \msg_fatal:nnn {eudoxus} {error} {pdfLaTeX~must~produce~PDF~output.}
    }

\cs_new_protected:Npn \csEudoxError #1
{
    \msg_fatal:nnn {eudoxus} {error} {#1}
}
\@ifpackageloaded {csmath}
{
    \csEudoxError {csmath~cannot~be~loaded~with~eudoxus.}
} {}
\AddToHook {package/csmath/before}
{
    \csEudoxError {csmath~cannot~be~loaded~with~eudoxus.}
}
\@ifpackageloaded {csthm}
{
    \csEudoxError {eudoxus~cannot~be~loaded~with~csthm.}
} {}
\AddToHook {package/csthm/before}
{
    \csEudoxError {eudoxus~cannot~be~loaded~with~csthm.}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Options
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\prop_new:N \g_csEudoxOptions_prop
\bool_new:N \g_csEudoxInitialized_bool
\cs_new_protected:Npn \csEudoxSelect #1#2
{
    \bool_if:NT \g_csEudoxInitialized_bool
    {
        \csEudoxError {Eudoxus~options~are~fixed~after~initialization.}
    }
    \prop_get:NnNTF \g_csEudoxOptions_prop {#1} \l_tmpa_tl
    {
        \tl_if_eq:NnF \l_tmpa_tl {#2}
        {
            \csEudoxError
            {
                Contradictory~#1~selections:~\l_tmpa_tl ~and~#2.
            }
        }
    }
    {
        \prop_gput:Nnn \g_csEudoxOptions_prop {#1} {#2}
    }
    \tl_gset:cn {g_csEudox_#1_tl} {#2}
}

\cs_new_protected:Npn \csEudoxChoice #1#2#3
{
    \tl_new:c {g_csEudox_#1_tl}
    \tl_gset:cn {g_csEudox_#1_tl} {#3}
    \keys_define:nn {eudoxus}
    {
        #1 .choices:nn = {#2}
            {
                \exp_args:NnV \csEudoxSelect {#1} \l_keys_choice_tl
            }
    }
}
\csEudoxChoice {layout}
{
    auto,
    inherit,
    balanced,
    compact,
    spacious,
    legacy
} {auto}
\csEudoxChoice {font}
{
    auto,
    inherit,
    latinmodern,
    pazobiolinum
} {auto}
\csEudoxChoice {theorems}
{
    auto,
    inherit,
    extended,
    none
} {auto}
\csEudoxChoice {numberwithin}
{
    auto,
    section,
    none,
    inherit
} {auto}
\csEudoxChoice {equations}
{
    auto,
    section,
    none,
    inherit
} {auto}
\csEudoxChoice {references}
{
    none,
    hyperref,
    cleveref,
    zref,
    both,
    legacy
} {none}
\csEudoxChoice {paragraphs}
{
    auto,
    inherit,
    runin
} {auto}
\csEudoxChoice {bibliography}
{
    inherit,
    compact,
    legacy
} {inherit}
\csEudoxChoice {tags}
{
    inherit,
    right
} {inherit}
\csEudoxChoice {display-breaks}
{
    inherit,
    0,
    1,
    2,
    3,
    4
} {inherit}
\clist_map_inline:nn
{
    math,
    tcs,
    epigraph,
    titlepatch,
    ams-addresses,
    graphics,
    table,
    caption,
    float,
    lists,
    boxes,
    diagrams,
    plots,
    annotations,
    microtype,
    quotes,
    typography,
    verbatim,
    math-tools,
    bbm,
    vectors,
    upright-greek,
    ragged-bottom,
    hacks,
    siam
}
{
    \csEudoxChoice {#1}
    {
        true,
        false
    } {false}
    \keys_define:nn {eudoxus} {#1 .default:n = true}
}
\tl_gset:cn {g_csEudox_math_tl} {true}
\clist_map_inline:nn
{
    margin,
    line-stretch,
    paragraph-indent,
    paragraph-skip
}
{
    \tl_new:c {g_csEudox_#1_tl}
    \keys_define:nn {eudoxus}
    {
        #1 .code:n = \csEudoxSelect {#1} {##1},
        #1 .value_required:n = true
    }
}
\keys_define:nn {eudoxus}
{
    nomath .meta:n = {math = false},
    notheorems .meta:n = {theorems = none},
    fonts .meta:n = {font = latinmodern},
    nofonts .meta:n = {font = inherit},
    pazobiolinum .meta:n = {font = pazobiolinum},
    nopazobiolinum .meta:n = {font = latinmodern},
    nolayout .meta:n = {layout = inherit},
    notcs .meta:n = {tcs = false},
    noepigraph .meta:n = {epigraph = false},
    notitlepatch .meta:n = {titlepatch = false},
    nohacks .meta:n = {hacks = false},
    nosiam .meta:n = {siam = false},
    amshacks .meta:n =
        {
            ams-addresses = true,
            tags = right
        },
    noamshacks .meta:n =
        {
            ams-addresses = false,
            tags = inherit
        },
    unknown .code:n =
        {
            \csEudoxError
            {
                Unknown~option~'\l_keys_key_str '.
            }
        }
}
\ProcessKeyOptions [eudoxus]
\prg_new_conditional:Npnn \csEudoxEnabled:n #1
{
    T,
    F,
    TF
}
{
    \tl_if_eq:cnTF {g_csEudox_#1_tl} {true} {\prg_return_true:} {\prg_return_false:}
}
\bool_new:N \g_csEudoxSiam_bool
\bool_new:N \g_csEudoxArticle_bool
\@ifclassloaded {article}
{
    \bool_gset_true:N \g_csEudoxArticle_bool
} {}
\cs_if_exist:NT \newsiamthm
{
    \cs_if_exist:NT \newsiamremark
    {
        \bool_gset_true:N \g_csEudoxSiam_bool
    }
}
\bool_if:NF \g_csEudoxSiam_bool
{
    \@ifclassloaded {article} {}
    {
        \@ifclassloaded {amsart} {}
        {
            \csEudoxError {Supported~classes~are~article,~amsart,~and~siamart.}
        }
    }
}
\csEudoxEnabled:nT {siam}
{
    \bool_if:NF \g_csEudoxSiam_bool
    {
        \csEudoxError {The~siam~alias~requires~the~native~SIAM~class.}
    }
}

\cs_new_protected:Npn \csEudoxResolveAuto #1#2
{
    \tl_if_eq:cnT {g_csEudox_#1_tl} {auto}
    {
        \tl_gset:cn {g_csEudox_#1_tl} {#2}
    }
}
\bool_if:NTF \g_csEudoxSiam_bool
{
    \csEudoxResolveAuto {layout} {inherit}
    \csEudoxResolveAuto {font} {inherit}
    \csEudoxResolveAuto {theorems} {inherit}
    \csEudoxResolveAuto {numberwithin} {inherit}
    \csEudoxResolveAuto {equations} {inherit}
}
{
    \bool_if:NTF \g_csEudoxArticle_bool
    {
        \csEudoxResolveAuto {layout} {balanced}
    }
    {
        \csEudoxResolveAuto {layout} {inherit}
    }
    \csEudoxResolveAuto {font} {latinmodern}
    \csEudoxResolveAuto {theorems} {extended}
    \csEudoxResolveAuto {numberwithin} {section}
    \csEudoxResolveAuto {equations} {section}
}
\csEudoxEnabled:nF {math}
{
    \clist_map_inline:nn
    {
        theorems/none,
        tcs/false,
        font/inherit,
        equations/inherit
    }
    {
        \seq_set_split:Nnn \l_tmpa_seq {/} {#1}
        \exp_args:Nee \csEudoxSelect
        {
            \seq_item:Nn \l_tmpa_seq {1}
        }
        {
            \seq_item:Nn \l_tmpa_seq {2}
        }
    }
}
\tl_if_eq:cnTF {g_csEudox_layout_tl} {inherit}
{
    \csEudoxResolveAuto {paragraphs} {inherit}
    \tl_if_empty:cF {g_csEudox_margin_tl}
    {
        \csEudoxError {margin~requires~an~explicit~layout~preset.}
    }
}
{
    \bool_if:NTF \g_csEudoxArticle_bool
    {
        \csEudoxResolveAuto {paragraphs} {runin}
    }
    {
        \csEudoxResolveAuto {paragraphs} {inherit}
    }
}
\bool_if:NT \g_csEudoxSiam_bool
{
    \clist_map_inline:nn
    {
        layout,
        font,
        numberwithin,
        equations,
        paragraphs,
        bibliography,
        tags
    }
    {
        \tl_if_eq:cnF {g_csEudox_#1_tl} {inherit}
        {
            \csEudoxError {SIAM~owns~#1;~select~inherit~and~use~class~options.}
        }
    }
    \clist_map_inline:nn
    {
        titlepatch,
        ams-addresses,
        hacks,
        caption,
        float
    }
    {
        \csEudoxEnabled:nT {#1}
        {
            \csEudoxError {Feature~#1~would~replace~SIAM~formatting.}
        }
    }
    \clist_map_inline:nn
    {
        line-stretch,
        paragraph-indent,
        paragraph-skip
    }
    {
        \tl_if_empty:cF {g_csEudox_#1_tl}
        {
            \csEudoxError {SIAM~owns~#1.}
        }
    }
}
\bool_if:NF \g_csEudoxArticle_bool
{
    \tl_if_eq:cnF {g_csEudox_layout_tl} {inherit}
    {
        \tl_if_eq:cnF {g_csEudox_layout_tl} {legacy}
        {
            \csEudoxError {Mathematical~layout~presets~require~article;~use~layout=inherit.}
        }
    }
    \tl_if_eq:cnT {g_csEudox_paragraphs_tl} {runin}
    {
        \csEudoxError {paragraphs=runin~requires~article;~use~parhead~explicitly.}
    }
}

\cs_new_protected:Npn \csEudoxCheckTheoremBackend
{
    \bool_if:NF \g_csEudoxSiam_bool
    {
        \@ifpackageloaded {ntheorem}
        {
            \csEudoxError {Use~amsthm~with~eudoxus;~ntheorem~is~reserved~for~native~SIAM.}
        } {}
    }
}
\csEudoxCheckTheoremBackend

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Mathematics
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\csEudoxEnabled:nT {math}
{
    \RequirePackage {amsmath}
    \RequirePackage {amssymb}
}

\cs_new_protected:Npn \csEudoxInitializeFonts
{
    \tl_if_eq:cnT {g_csEudox_font_tl} {latinmodern}
    {
        \RequirePackage {lmodern}
    }
    \tl_if_eq:cnT {g_csEudox_font_tl} {pazobiolinum}
    {
        \RequirePackage [T1] {fontenc}
        \RequirePackage
        [
            sc,
            noBBpl
        ] {mathpazo}
        \RequirePackage
        [
            type1,
            scaled = 1.085
        ] {biolinum}
        \RequirePackage [scaled = 1.03] {inconsolata}
    }
    \tl_if_eq:cnF {g_csEudox_font_tl} {inherit}
    {
        \csEudoxEnabled:nT {math} {\csEudoxInitializeAlphabets}
    }
}

\cs_new_protected:Npn \csEudoxInitializeAlphabets
{

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Math Alphabet Allocation
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

    \cs_if_exist:NT \localmathalphabets
    {
        \localmathalphabets = 0\relax
    }
    \DeclareFontFamily {U} {bboldx}
    {
        \skewchar \font = 45
    }
    \DeclareFontShape {U} {bboldx} {m} {n} {<->BBOLDX-Regular} {}
    \DeclareFontShape {U} {bboldx} {b} {n} {<->BBOLDX-Bold} {}
    \DeclareMathAlphabet {\mathbb} {U} {bboldx} {m} {n}
    \SetMathAlphabet {\mathbb} {bold} {U} {bboldx} {b} {n}
    \tl_if_eq:cnTF {g_csEudox_font_tl} {pazobiolinum}
    {
        \DeclareFontFamily {U} {stixplain}
        {
            \skewchar \font = 127
        }
        \DeclareFontShape {U} {stixplain} {m} {n} {<->stix-mathcal} {}
        \DeclareFontShape {U} {stixplain} {b} {n} {<->stix-mathcal-bold} {}
        \DeclareMathAlphabet {\mathcal} {U} {stixplain} {m} {n}
        \SetMathAlphabet {\mathcal} {bold} {U} {stixplain} {b} {n}
        \SetMathAlphabet {\mathsf} {normal} {T1} {LinuxBiolinumT-TLF} {m} {n}
        \SetMathAlphabet {\mathsf} {bold} {T1} {LinuxBiolinumT-TLF} {b} {n}
        \SetMathAlphabet {\mathtt} {normal} {T1} {zi4} {m} {n}
        \SetMathAlphabet {\mathtt} {bold} {T1} {zi4} {b} {n}
    }
    {
        \DeclareFontFamily {U} {cmsy}
        {
            \skewchar \font 48
        }
        \DeclareFontShape {U} {cmsy} {m} {n} {<-5.5>cmsy5<5.5-6.5>cmsy6<6.5-7.5>cmsy7<7.5-8.5>cmsy8<8.5-9.5>cmsy9<9.5->cmsy10} {}
        \DeclareFontShape {U} {cmsy} {b} {n} {<-5.5>cmbsy5<5.5-6.5>cmbsy6<6.5-7.5>cmbsy7<7.5-8.5>cmbsy8<8.5-9.5>cmbsy9<9.5->cmbsy10} {}
        \DeclareMathAlphabet {\mathcal} {U} {cmsy} {m} {n}
        \SetMathAlphabet {\mathcal} {bold} {U} {cmsy} {b} {n}
        \@ifpackageloaded {biolinum}
        {
            \SetMathAlphabet {\mathsf} {normal} {T1} {LinuxBiolinumT-TLF} {m} {n}
            \SetMathAlphabet {\mathsf} {bold} {T1} {LinuxBiolinumT-TLF} {b} {n}
        } {}
    }
    \DeclareFontFamily {U} {dutchscr}
    {
        \skewchar \font = 45
    }
    \DeclareFontShape {U} {dutchscr} {m} {n} {<->dutchcal-r} {}
    \DeclareFontShape {U} {dutchscr} {b} {n} {<->dutchcal-b} {}
    \DeclareMathAlphabet {\mathscr} {U} {dutchscr} {m} {n}
    \SetMathAlphabet {\mathscr} {bold} {U} {dutchscr} {b} {n}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Bold Mathematics
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

    \ProvideDocumentCommand \mathbfbb {m}
    {
        \boldsymbol
        {
            \mathbb {##1}
        }
    }
    \ProvideDocumentCommand \mathbfcal {m}
    {
        \boldsymbol
        {
            \mathcal {##1}
        }
    }
    \ProvideDocumentCommand \mathbfscr {m}
    {
        \boldsymbol
        {
            \mathscr {##1}
        }
    }
    \DeclareMathAlphabet {\mathpzc} {OT1} {pzc} {m} {it}
}
\csEudoxInitializeFonts
\csEudoxEnabled:nT {math}
{
    \tl_if_eq:cnT {g_csEudox_equations_tl} {section}
    {
        \numberwithin {equation} {section}
    }
    \tl_if_eq:cnT {g_csEudox_equations_tl} {none}
    {
        \counterwithout {equation} {section}
    }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Article Presets
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tl_new:N \g_csEudoxMargin_tl
\tl_new:N \g_csEudoxStretch_tl
\tl_new:N \g_csEudoxHeadingBefore_tl
\tl_new:N \g_csEudoxHeadingAfter_tl
\tl_new:N \g_csEudoxTheoremSkip_tl
\tl_gset:Nn \g_csEudoxTheoremSkip_tl {2.5pt}
\cs_new_protected:Npn \csEudoxConfigureLayout
{
    \str_case:Vn \g_csEudox_layout_tl
    {
        {balanced}
        {
            \tl_gset:Nn \g_csEudoxMargin_tl
            {
                hmargin = 1.25in,
                vmargin = 1.1in
            }
            \tl_gset:Nn \g_csEudoxStretch_tl {1.04}
            \tl_gset:Nn \g_csEudoxHeadingBefore_tl {1.3}
            \tl_gset:Nn \g_csEudoxHeadingAfter_tl {.55}
        }
        {compact}
        {
            \tl_gset:Nn \g_csEudoxMargin_tl {margin = 1in}
            \tl_gset:Nn \g_csEudoxStretch_tl {1}
            \tl_gset:Nn \g_csEudoxHeadingBefore_tl {1}
            \tl_gset:Nn \g_csEudoxHeadingAfter_tl {.4}
        }
        {spacious}
        {
            \tl_gset:Nn \g_csEudoxMargin_tl
            {
                hmargin = 1.5in,
                vmargin = 1.2in
            }
            \tl_gset:Nn \g_csEudoxStretch_tl {1.08}
            \tl_gset:Nn \g_csEudoxHeadingBefore_tl {1.5}
            \tl_gset:Nn \g_csEudoxHeadingAfter_tl {.7}
        }
        {legacy}
        {
            \tl_gset:Nn \g_csEudoxMargin_tl {margin = 1in}
            \tl_gset:Nn \g_csEudoxStretch_tl {1}
        }
    }
    \tl_if_eq:cnF {g_csEudox_layout_tl} {inherit}
    {
        \RequirePackage {geometry}
        \exp_args:NV \geometry \g_csEudoxMargin_tl
        \tl_if_empty:cF {g_csEudox_margin_tl}
        {
            \exp_args:Ne \geometry
            {
                margin = \use:c {g_csEudox_margin_tl}
            }
        }
        \tl_if_eq:cnF {g_csEudox_layout_tl} {legacy} {\csEudoxConfigureArticle}
    }
    \csEudoxEnabled:nT {hacks}
    {
        \tl_gset:Nn \g_csEudoxStretch_tl {1.075}
        \AddToHook {begindocument}
        {
            \parindent = 1.75em\parskip = 0pt\emergencystretch = 2em\raggedbottom
            \cs_if_exist:NT \allowdisplaybreaks
            {
                \allowdisplaybreaks [2]
            }
        }
    }
    \tl_if_empty:cF {g_csEudox_line-stretch_tl}
    {
        \tl_gset:Nv \g_csEudoxStretch_tl {g_csEudox_line-stretch_tl}
    }
    \tl_if_empty:NF \g_csEudoxStretch_tl
    {
        \fp_compare:nNnF {\g_csEudoxStretch_tl}> {0}
            {
                \csEudoxError {line-stretch~must~be~positive.}
            }
        \AddToHook {begindocument}
        {
            \renewcommand \baselinestretch {\g_csEudoxStretch_tl}
            \normalsize
        }
    }
    \tl_if_empty:cF {g_csEudox_paragraph-indent_tl}
    {
        \AddToHook {begindocument}
        {
            \setlength \parindent
            {
                \use:c {g_csEudox_paragraph-indent_tl}
            }
        }
    }
    \tl_if_empty:cF {g_csEudox_paragraph-skip_tl}
    {
        \AddToHook {begindocument}
        {
            \setlength \parskip
            {
                \use:c {g_csEudox_paragraph-skip_tl}
            }
        }
    }
    \csEudoxEnabled:nT {ragged-bottom}
    {
        \AddToHook {begindocument} {\raggedbottom}
    }
}
\ProvideDocumentCommand \edxsectionheadingfont {}
{
    \sffamily \bfseries
}
\ProvideDocumentCommand \edxparheadingfont {}
{
    \sffamily \bfseries \boldmath
}
\ProvideDocumentCommand \edxsubparheadingfont {}
{
    \sffamily \bfseries
}
\ProvideDocumentCommand \edxdocumenttitlefont {}
{
    \sffamily \bfseries
}

\cs_new_protected:Npn \csEudoxSectionFont
{
    \normalfont \large \csEudoxEnabled:nTF {titlepatch} {\edxsectionheadingfont} {\bfseries}
}

\cs_new_protected:Npn \csEudoxConfigureArticle
{
    \tl_gset:Nn \g_csEudoxTheoremSkip_tl
    {
        .45\baselineskip
    }
    \AddToHook {begindocument}
    {
        \parindent =1.5em\parskip =0pt~plus.3pt\clubpenalty =3000\widowpenalty =3000\emergencystretch =1em
    }
    \AddToHook {begindocument/end}
    {
        \abovedisplayskip =9pt~plus3pt~minus4pt\belowdisplayskip =\abovedisplayskip
        \abovedisplayshortskip =0pt~plus3pt\belowdisplayshortskip =5pt~plus3pt~minus3pt
    }
    \RenewDocumentCommand \section {}
     {
      \@startsection {section} {1} {0pt}
      {
          -\g_csEudoxHeadingBefore_tl \baselineskip ~plus-.3\baselineskip ~minus-.2\baselineskip
      }
      {
          \g_csEudoxHeadingAfter_tl \baselineskip
      } {\csEudoxSectionFont}
     }
    \RenewDocumentCommand \subsection {}
    {
        \@startsection {subsection} {2} {0pt}
        {
            -.9\baselineskip ~plus-.2\baselineskip ~minus-.1\baselineskip
        }
        {
            .35\baselineskip
        }
        {
            \normalfont \normalsize \bfseries
        }
    }
    \if@titlepage \else
        \cs_set_protected:Npn \@maketitle
        {
            \newpage \null \vskip 1em\begin {center}
            \let \footnote \thanks
            {
                \LARGE \bfseries \csEudoxEnabled:nT {titlepatch} {\edxdocumenttitlefont} \@title\par
            }
            \vskip 1em
                {
                    \normalsize \lineskip .5em\begin {tabular} [t] {c} \@author \end {tabular}
                    \par
                }
            \tl_if_empty:NF \@date
            {
                \vskip .65em
                    {
                        \normalsize \@date\par
                    }
            }
            \end {center}
            \par
            \vskip .65em
        }
    \fi
}
\csEudoxConfigureLayout
\csEudoxEnabled:nT {titlepatch}
{
    \bool_if:NTF \g_csEudoxArticle_bool
    {
        \tl_if_eq:cnT {g_csEudox_layout_tl} {inherit}
        {
            \AddToHook {cmd/@maketitle/before}
            {
                \cs_set:Npx \@title {
                    {
                        \exp_not:N \edxdocumenttitlefont
                        \exp_not:V \@title
                    }}
            }
        }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Section Fonts
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

        \tl_if_eq:cnT {g_csEudox_layout_tl} {inherit}
        {
            \RenewDocumentCommand \section {}
             {
